# ==========================================
# KONFIGURASI ENVIRONMENT - MEETING APP BKN
# ==========================================

# Port Server
PORT=3000
BASE_URL=http://localhost:3000

# Konfigurasi Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=appmeeting

# ==========================================
# GOOGLE CLOUD / GEMINI API INTEGRATION
# ==========================================
# Dapatkan API Key secara gratis dari Google AI Studio atau Google Cloud Console:
# https://aistudio.google.com/app/apikey
# Masukkan API Key di bawah ini untuk mengaktifkan AI Generatif (Notulen & Infografis)
GEMINI_API_KEY=your_google_cloud_gemini_api_key_here
