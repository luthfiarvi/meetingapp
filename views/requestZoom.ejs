                                                    <div class="zoom-card zoom-history-card">

                                                        <div class="zoom-card-header zoom-history-header"
                                                            style="display: flex; align-items: center; justify-content: space-between;">
                                                            <div
                                                                style="display: flex; align-items: center; gap: 0.75rem;">
                                                                <div class="header-icon"
                                                                    style="width: 40px; height: 40px; border-radius: 10px; background: #059669; color: white; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                                                                    🕒
                                                                </div>
                                                                <div>
                                                                    <h2 style="font-weight: 800; color: #0f172a; margin: 0;">
                                                                        Status Permohonan Saya</h2>
                                                                    <p style="color: #64748b; margin: 0.2rem 0 0;">
                                                                        Pantau status & klik permohonan untuk membuka
                                                                        rincian link Zoom</p>
                                                                </div>
                                                            </div>
                                                            <span class="history-badge"
                                                                style="font-size: 0.75rem; font-weight: 700; background: #dbeafe; color: #1d4ed8; padding: 0.35rem 0.75rem; border-radius: 9999px;">
                                                                <%= myRequests.length %> Pengajuan
                                                            </span>
                                                        </div>

                                                        <div class="custom-scroll zoom-history-body"
                                                            style="padding: 1.25rem; max-height: 650px; overflow-y: auto;">
                                                            <% if (myRequests && myRequests.length> 0) { %>
                                                                <div
                                                                    style="display: flex; flex-direction: column; gap: 0.75rem;">
                                                                    <% myRequests.forEach(req=> { %>
                                                                        <div class="req-item"
                                                                            id="req-card-<%= req.id %>">

                                                                            <!-- HEADER RINGKAS (KLIK UNTUK BUKA/TUTUP DETAIL) -->
                                                                            <div class="req-header"
                                                                                onclick="toggleReqCard('req-card-<%= req.id %>')"
                                                                                title="Klik untuk membuka / menutup rincian">
                                                                                <div
                                                                                    style="flex: 1; min-width: 0; padding-right: 0.5rem;">
                                                                                    <div
                                                                                        style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                                                                                        <h3 class="req-title">
                                                                                            <%= req.judul_rapat %>
                                                                                        </h3>
                                                                                        <% if (req.tipe_rapat && req.tipe_rapat.toLowerCase().includes('offline')) { %>
                                                                                            <span
                                                                                                style="font-size: 0.65rem; font-weight: 700; background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; padding: 0.15rem 0.45rem; border-radius: 9999px; white-space: nowrap;">
                                                                                                🏢 Offline
                                                                                            </span>
                                                                                        <% } else if (req.tipe_rapat && req.tipe_rapat.toLowerCase().includes('webinar')) { %>
                                                                                            <span
                                                                                                style="font-size: 0.65rem; font-weight: 700; background: #fff7ed; color: #ea580c; border: 1px solid #fed7aa; padding: 0.15rem 0.45rem; border-radius: 9999px; white-space: nowrap;">
                                                                                                Webinar
                                                                                            </span>
                                                                                        <% } %>
                                                                                    </div>
                                                                                    <div class="req-meta">
                                                                                        <span>📅 <%= req.tanggal_rapat ?
                                                                                                new
                                                                                                Date(req.tanggal_rapat).toLocaleDateString('id-ID',
                                                                                                { weekday: 'short' ,
                                                                                                day: '2-digit' ,
                                                                                                month: 'short' ,
                                                                                                year: 'numeric' }) : '-'
                                                                                                %></span>
                                                                                        <span>⏰ <%= req.waktu_mulai ?
                                                                                                req.waktu_mulai.substring(0,
                                                                                                5) : '09:00' %> - <%=
                                                                                                    req.waktu_selesai ?
                                                                                                    req.waktu_selesai.substring(0,
                                                                                                    5) : 'Selesai' %>
                                                                                                    WIB</span>
                                                                                    </div>
                                                                                </div>

                                                                                <div
                                                                                    style="display: flex; align-items: center; gap: 0.6rem; flex-shrink: 0;">
                                                                                    <div>
                                                                                        <% if (req.status==='disetujui'
                                                                                            ) { %>
                                                                                            <span class="req-status-pill"
                                                                                                style="display: inline-flex; align-items: center; gap: 0.3rem; background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; padding: 0.25rem 0.65rem; border-radius: 9999px; font-size: 0.725rem; font-weight: 700; white-space: nowrap;">
