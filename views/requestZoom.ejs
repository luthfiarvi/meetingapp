                                                                    stats.menunggu %>)</option>
                                                            <option value="disetujui">Disetujui (<%= stats.disetujui %>)
                                                            </option>
                                                            <option value="ditolak">Ditolak (<%= stats.ditolak %>)
                                                            </option>
                                                        </select>
                                                    </div>
                                                </div>

                                                <div style="overflow-x: auto;">
                                                    <table
