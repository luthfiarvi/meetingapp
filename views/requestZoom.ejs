                                                                                                                        onsubmit="return confirm('Batalkan permohonan ini?')"
                                                                                                                        style="display: inline;">
                                                                                                                        <input
                                                                                                                            type="hidden"
                                                                                                                            name="id"
                                                                                                                            value="<%= req.id %>">
                                                                                                                        <button
                                                                                                                            type="submit"
                                                                                                                            style="background: #fee2e2; border: 1px solid #fecaca; color: #dc2626; padding: 0.3rem 0.65rem; border-radius: 0.4rem; cursor: pointer; font-size: 0.75rem; font-weight: 600; display: inline-flex; align-items: center; gap: 0.3rem;">
                                                                                                                            🗑️
                                                                                                                            Batalkan
                                                                                                                            Pengajuan
                                                                                                                        </button>
                                                                                                                    </form>
                                                                                                                    <% }
                                                                                                                        %>
                                                                                                            </div>
