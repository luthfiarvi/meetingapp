                                                    <span>Diajukan pada: <%= req.tanggal_pengajuan ? new Date(req.tanggal_pengajuan).toLocaleDateString('id-ID') : '-' %></span>
                                                    <% if (req.status === 'menunggu') { %>
                                                        <form action="/request-zoom/delete" method="POST" onsubmit="return confirm('Batalkan permohonan ini?')" style="display: inline;">
                                                            <input type="hidden" name="id" value="<%= req.id %>">
                                                            <button type="submit" style="background: #fee2e2; border: 1px solid #fecaca; color: #dc2626; padding: 0.3rem 0.65rem; border-radius: 0.4rem; cursor: pointer; font-size: 0.75rem; font-weight: 600; display: inline-flex; align-items: center; gap: 0.3rem;">
                                                                🗑️ Batalkan Pengajuan
                                                            </button>
                                                        </form>
                                                    <% } %>
                                                </div>
                                            </div>

                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <div style="padding: 3rem 1.5rem; text-align: center; color: #64748b;">
                                    <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🗓️</div>
                                    <div style="font-weight: 700; color: #1e293b; font-size: 1rem;">Belum ada pengajuan Zoom</div>
                                    <p style="font-size: 0.85rem; margin: 0.25rem auto 0; max-width: 320px;">
                                        Silakan isi formulir di sebelah kiri jika divisi Anda membutuhkan fasilitas Zoom Meeting.
                                    </p>
                                </div>
                            <% } %>
                        </div>

                    </div>
                </div>

            </div>

        </main>

    </div>

    <!-- ============================================================
         MODAL APPROVAL & INPUT LINK ZOOM OLEH ADMIN TIM SIDIGI
         ============================================================ -->
    <div id="approveModal" style="position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); display: none; align-items: center; justify-content: center; z-index: 9999; padding: 1.25rem;">
        <div style="background: #ffffff; border-radius: 1.25rem; max-width: 540px; width: 100%; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); overflow: hidden;">
            
            <div style="padding: 1.25rem 1.5rem; background: linear-gradient(135deg, #0d2b5c 0%, #1d4ed8 100%); color: white; display: flex; align-items: center; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <span style="font-size: 1.25rem;">🛡️</span>
                    <h3 style="margin: 0; font-size: 1.1rem; font-weight: 800;">Setujui & Terbitkan Link Zoom</h3>
                </div>
                <button onclick="closeApproveModal()" style="background: none; border: none; color: white; font-size: 1.5rem; cursor: pointer;">&times;</button>
            </div>

            <form action="/request-zoom/approve" method="POST" style="padding: 1.5rem;">
                <input type="hidden" name="id" id="approveModalId">
                
                <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 0.625rem; padding: 0.85rem 1rem; margin-bottom: 1.25rem;">
                    <div style="font-size: 0.75rem; color: #1e40af; font-weight: 700; text-transform: uppercase;">Judul Rapat Pemohon:</div>
                    <div style="font-size: 0.925rem; font-weight: 800; color: #0f172a; margin-top: 0.2rem;" id="approveModalJudul"></div>
                    <div style="font-size: 0.775rem; color: #64748b; margin-top: 0.2rem;" id="approveModalPemohon"></div>
                </div>

                <div style="margin-bottom: 1.25rem;">
                    <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 0.4rem; text-transform: uppercase;">
                        Tautan Zoom Lengkap (URL) <span style="color: red;">*</span>
                    </label>
                    <input type="url" name="zoom_link" id="approveModalLink" placeholder="https://bkn.zoom.us/j/..." required style="width: 100%; padding: 0.75rem 0.9rem; border: 1.5px solid #2563eb; border-radius: 0.625rem; font-size: 0.875rem;">
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
                    <div>
                        <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 0.4rem; text-transform: uppercase;">
                            Meeting ID
                        </label>
                        <input type="text" name="meeting_id" id="approveModalMeetingId" placeholder="842 9182 3910" style="width: 100%; padding: 0.75rem 0.9rem; border: 1px solid #cbd5e1; border-radius: 0.625rem; font-size: 0.875rem;">
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 0.4rem; text-transform: uppercase;">
                            Passcode
                        </label>
                        <input type="text" name="passcode" id="approveModalPasscode" placeholder="BKN52026" style="width: 100%; padding: 0.75rem 0.9rem; border: 1px solid #cbd5e1; border-radius: 0.625rem; font-size: 0.875rem;">
                    </div>
                </div>

                <div style="margin-bottom: 1.25rem;">
                    <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 0.4rem; text-transform: uppercase;">
                        Tipe Kegiatan & Fitur Kuis
                    </label>
                    <select name="tipe_rapat" id="approveModalTipe" style="width: 100%; padding: 0.75rem 0.9rem; border: 1px solid #cbd5e1; border-radius: 0.625rem; font-size: 0.875rem; font-weight: 600;">
                        <option value="Rapat Biasa">👥 Rapat Koordinasi Zoom Biasa</option>
                        <option value="Webinar">🎯 Webinar Interaktif (Auto-Terbitkan Ruang Kuis & Slido Q&A)</option>
                    </select>
                </div>

                <div style="margin-bottom: 1.5rem;">
                    <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 0.4rem; text-transform: uppercase;">
                        Catatan Admin Tim Sidigi (Opsional)
                    </label>
                    <textarea name="catatan_admin" id="approveModalCatatan" rows="2" placeholder="Contoh: Sudah dijadwalkan di Akun Zoom Utama Sidigi. Hubungi Ext. 104 jika butuh co-host." style="width: 100%; padding: 0.75rem 0.9rem; border: 1px solid #cbd5e1; border-radius: 0.625rem; font-size: 0.875rem;"></textarea>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
                    <button type="button" onclick="closeApproveModal()" style="padding: 0.75rem 1.25rem; background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; border-radius: 0.625rem; font-weight: 700; font-size: 0.875rem; cursor: pointer;">
                        Batal
                    </button>
                    <button type="submit" style="padding: 0.75rem 1.5rem; background: #2563eb; color: white; border: none; border-radius: 0.625rem; font-weight: 700; font-size: 0.875rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);">
                        <span>✓ Terbitkan & Beri Akses</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ============================================================
         MODAL REJECT OLEH ADMIN TIM SIDIGI
         ============================================================ -->
    <div id="rejectModal" style="position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); display: none; align-items: center; justify-content: center; z-index: 9999; padding: 1.25rem;">
        <div style="background: #ffffff; border-radius: 1.25rem; max-width: 480px; width: 100%; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); overflow: hidden;">
            
            <div style="padding: 1.25rem 1.5rem; background: linear-gradient(135deg, #991b1b 0%, #dc2626 100%); color: white; display: flex; align-items: center; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <span style="font-size: 1.25rem;">⚠️</span>
                    <h3 style="margin: 0; font-size: 1.1rem; font-weight: 800;">Tolak Permohonan Zoom</h3>
                </div>
                <button onclick="closeRejectModal()" style="background: none; border: none; color: white; font-size: 1.5rem; cursor: pointer;">&times;</button>
            </div>

            <form action="/request-zoom/reject" method="POST" style="padding: 1.5rem;">
                <input type="hidden" name="id" id="rejectModalId">
                
                <div style="margin-bottom: 1.25rem;">
                    <p style="font-size: 0.875rem; color: #475569; margin: 0 0 0.5rem;">
                        Anda akan menolak pengajuan untuk rapat: <strong id="rejectModalJudul" style="color: #0f172a;"></strong>
                    </p>
                </div>

                <div style="margin-bottom: 1.5rem;">
                    <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 0.4rem; text-transform: uppercase;">
                        Alasan Penolakan <span style="color: red;">*</span>
                    </label>
                    <textarea name="catatan_admin" required rows="3" placeholder="Contoh: Jadwal Zoom pada jam tersebut sudah penuh dipakai agenda Kanreg V lainnya." style="width: 100%; padding: 0.75rem 0.9rem; border: 1px solid #cbd5e1; border-radius: 0.625rem; font-size: 0.875rem;"></textarea>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
                    <button type="button" onclick="closeRejectModal()" style="padding: 0.75rem 1.25rem; background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; border-radius: 0.625rem; font-weight: 700; font-size: 0.875rem; cursor: pointer;">
                        Batal
                    </button>
                    <button type="submit" style="padding: 0.75rem 1.5rem; background: #dc2626; color: white; border: none; border-radius: 0.625rem; font-weight: 700; font-size: 0.875rem; cursor: pointer;">
                        ✕ Konfirmasi Tolak
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL KONFIRMASI LOGOUT -->
    <div id="logoutModal" class="logout-modal-overlay">
        <div class="logout-modal-card">
            <div class="logout-modal-icon">
                ⚠️
            </div>
            <h3>Konfirmasi Keluar</h3>
            <p>Apakah Anda yakin ingin keluar dari Sistem Informasi Manajemen Ruang Rapat (SIM-RAPAT BKN)?</p>
            <div class="logout-modal-actions">
                <button type="button" class="btn-logout-cancel" onclick="closeLogoutModal()">Batal</button>
                <a href="/logout" class="btn-logout-confirm">Ya, Keluar</a>
            </div>
        </div>
    </div>

    <script>
        function toggleReqCard(cardId) {
            const targetCard = document.getElementById(cardId);
            if (!targetCard) return;
            const isAlreadyOpen = targetCard.classList.contains('open');

            // Tutup kartu lain agar tetap rapi dan tidak memakan banyak tempat (accordion)
            document.querySelectorAll('.req-item.open').forEach(card => {
                card.classList.remove('open');
            });

            // Buka kartu yang diklik jika sebelumnya belum terbuka
            if (!isAlreadyOpen) {
                targetCard.classList.add('open');
            }
        }

        function switchZoomTab(tab) {
            const adminTable = document.getElementById('adminTableContainer');
            const formCont = document.getElementById('formContainer');
            const userHist = document.getElementById('userHistoryContainer');
            const tabBtnAdmin = document.getElementById('tabBtnAdmin');
            const tabBtnForm = document.getElementById('tabBtnForm');
            const grid = document.getElementById('zoomContentGrid');

            if (tab === 'admin') {
                if (adminTable) adminTable.style.display = 'block';
                if (formCont) formCont.style.display = 'none';
                if (userHist) userHist.style.display = 'none';
                if (grid) grid.style.gridTemplateColumns = '1fr';

                tabBtnAdmin.style.color = '#0d2b5c';
                tabBtnAdmin.style.borderBottomColor = '#2563eb';
                tabBtnForm.style.color = '#64748b';
                tabBtnForm.style.borderBottomColor = 'transparent';
            } else {
                if (adminTable) adminTable.style.display = 'none';
                if (formCont) formCont.style.display = 'block';
                if (userHist) userHist.style.display = 'block';
                if (grid) grid.style.gridTemplateColumns = '1.1fr 1.4fr';

                tabBtnForm.style.color = '#0d2b5c';
                tabBtnForm.style.borderBottomColor = '#2563eb';
                tabBtnAdmin.style.color = '#64748b';
                tabBtnAdmin.style.borderBottomColor = 'transparent';
            }
        }

        function filterAdminTable() {
            const filterVal = document.getElementById('adminStatusFilter').value;
            const rows = document.querySelectorAll('#adminZoomTable tbody tr.admin-zoom-row');
            rows.forEach(row => {
                const status = row.getAttribute('data-status');
                if (filterVal === 'all' || status === filterVal) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function handleApproveClick(btn) {
            const id = btn.getAttribute('data-id');
            const judul = btn.getAttribute('data-judul') || '';
            const pemohon = btn.getAttribute('data-pemohon') || '';
            const link = btn.getAttribute('data-link') || '';
            const meetingId = btn.getAttribute('data-meetingid') || '';
            const passcode = btn.getAttribute('data-passcode') || '';
            const catatan = btn.getAttribute('data-catatan') || '';
            const tipe = btn.getAttribute('data-tipe') || 'Rapat Biasa';
            openApproveModal(id, judul, pemohon, link, meetingId, passcode, catatan, tipe);
        }

        function handleRejectClick(btn) {
            const id = btn.getAttribute('data-id');
            const judul = btn.getAttribute('data-judul') || '';
            openRejectModal(id, judul);
        }

        function openApproveModal(id, judul, pemohon, link, meetingId, passcode, catatan, tipe) {
            document.getElementById('approveModalId').value = id;
            document.getElementById('approveModalJudul').innerText = judul;
            document.getElementById('approveModalPemohon').innerText = 'Pemohon: ' + pemohon;
            document.getElementById('approveModalLink').value = link || '';
            document.getElementById('approveModalMeetingId').value = meetingId || '';
            document.getElementById('approveModalPasscode').value = passcode || '';
            document.getElementById('approveModalCatatan').value = catatan || 'Disetujui oleh Tim Kerja Sidigi.';
            if (document.getElementById('approveModalTipe')) {
                document.getElementById('approveModalTipe').value = tipe || 'Rapat Biasa';
            }
            document.getElementById('approveModal').style.display = 'flex';
        }

        function closeApproveModal() {
            document.getElementById('approveModal').style.display = 'none';
        }

        function openRejectModal(id, judul) {
            document.getElementById('rejectModalId').value = id;
            document.getElementById('rejectModalJudul').innerText = judul;
            document.getElementById('rejectModal').style.display = 'flex';
        }

        function closeRejectModal() {
            document.getElementById('rejectModal').style.display = 'none';
        }

        function copyToClipboard(text) {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(text).then(() => {
                    alert('Tautan Zoom berhasil disalin ke clipboard!');
                });
            } else {
                const input = document.createElement('input');
                input.value = text;
                document.body.appendChild(input);
                input.select();
                document.execCommand('copy');
                document.body.removeChild(input);
                alert('Tautan Zoom berhasil disalin ke clipboard!');
            }
        }

        function copyQuizLink(path) {
            const fullUrl = path.startsWith('http') ? path : (window.location.origin + path);
            if (navigator.clipboard) {
                navigator.clipboard.writeText(fullUrl).then(() => {
                    alert('Tautan Kuis & Forum Q&A Webinar berhasil disalin! Silakan tempel di room chat Zoom untuk peserta.');
                });
            } else {
                const input = document.createElement('input');
                input.value = fullUrl;
                document.body.appendChild(input);
                input.select();
                document.execCommand('copy');
                document.body.removeChild(input);
                alert('Tautan Kuis & Forum Q&A Webinar berhasil disalin! Silakan tempel di room chat Zoom untuk peserta.');
            }
        }

        function showLogoutModal(event) {
            if (event) event.preventDefault();
            document.getElementById("logoutModal").classList.add("show");
        }

        function closeLogoutModal() {
            document.getElementById("logoutModal").classList.remove("show");
        }
    </script>
    <script src="/js/sidebar.js"></script>
</body>
</html>
