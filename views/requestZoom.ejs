                    <button type="button" onclick="closeRejectModal()"
                        style="padding: 0.55rem 1rem; background: #ffffff; color: #475569; border: 1px solid #cbd5e1; border-radius: 0.5rem; font-weight: 700; font-size: 0.825rem; cursor: pointer;">
                        Batal
                    </button>
