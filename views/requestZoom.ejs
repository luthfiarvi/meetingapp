                            <option value="Rapat Biasa">👥 Rapat Koordinasi Zoom Biasa</option>
                            <option value="Webinar">🎯 Webinar Interaktif (Auto-Kuis & Slido)</option>
                            <option value="Rapat Offline">🏢 Rapat Tatap Muka / Offline (Ruang Rapat)</option>
                        </select>
                    </div>

                    <!-- Ruang Rapat (Khusus Offline) -->
                    <div id="approveModalRuanganGroup" style="margin-bottom: 0.85rem; display: none;">
