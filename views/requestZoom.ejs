                                style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 0.5rem; font-size: 0.825rem;">
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.725rem; font-weight: 700; color: #334155; margin-bottom: 0.3rem; text-transform: uppercase;">
