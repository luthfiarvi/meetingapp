                                                                📋 Salin Tautan Kuis
                                                            </button>
                                                        </div>

                                                        <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.6rem;">
                                                            <input type="text" id="quizLink-<%= req.id %>" value="<%= quizUrl %>" readonly style="flex: 1; padding: 0.5rem 0.75rem; border: 1px solid #fdba74; border-radius: 0.5rem; font-size: 0.825rem; background: #fffaf5; color: #9a3412; font-family: monospace;">
                                                            <a href="<%= quizUrl %>" target="_blank" rel="noopener noreferrer" style="padding: 0.5rem 0.9rem; background: linear-gradient(135deg, #ea580c 0%, #c2410c 100%); color: white; border-radius: 0.5rem; font-size: 0.8rem; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem; white-space: nowrap;">
                                                                Buka Ruang Kuis 🎯
                                                            </a>
                                                        </div>

                                                        <div style="font-size: 0.75rem; color: #9a3412; background: #ffedd5; padding: 0.45rem 0.75rem; border-radius: 0.5rem; display: flex; align-items: center; gap: 0.4rem;">
