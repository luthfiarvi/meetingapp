                                                                                                                displayCatatan = displayCatatan.replace(/Disetujui untuk Rapat Tatap Muka di BKN Kanreg V\.?/i, 'Disetujui untuk Rapat Tatap Muka.');
                                                                                                            %>
                                                                                                            <%= displayCatatan %>
                                                                                                        </div>
                                                                                                        <% } %>

                                                                                                            <div
                                                                                                                style="display: flex; justify-content: space-between; align-items: center; font-size: 0.725rem; color: #94a3b8; border-top: 1px solid #e2e8f0; padding-top: 0.6rem; margin-top: 0.25rem;">
