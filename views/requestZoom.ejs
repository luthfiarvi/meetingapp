                            style="display: block; font-size: 0.75rem; font-weight: 700; color: #334155; margin-bottom: 0.3rem; text-transform: uppercase;">
                            Tipe Kegiatan & Fasilitas
                        </label>
                        <select name="tipe_rapat" id="approveModalTipe" onchange="handleApproveModalTipeChange()"
