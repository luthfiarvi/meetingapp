                                                            <span>Salin dan sebarkan link ini di room chat Zoom untuk melemparkan kuis dan menampung pertanyaan peserta webinar.</span>
                                                        </div>
                                                    </div>
                                                <% } %>

                                                <% if (req.catatan_admin) { %>
                                                    <div style="font-size: 0.775rem; color: #475569; margin-bottom: 0.85rem; padding: 0.5rem 0.75rem; background: #ffffff; border-radius: 0.5rem; border: 1px dashed #cbd5e1;">
                                                        <strong>Catatan Tim Sidigi:</strong> <%= req.catatan_admin %>
                                                    </div>
