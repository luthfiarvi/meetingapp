    <!-- ============================================================
         MODAL APPROVAL & INPUT LINK ZOOM / OFFLINE OLEH ADMIN TIM SIDIGI
         ============================================================ -->
    <div id="approveModal"
        onclick="if (event.target === this) closeApproveModal()"
        style="position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px); display: none; align-items: center; justify-content: center; z-index: 9999; padding: 1rem; overflow-y: auto;">
        <div
            style="background: #ffffff; border-radius: 1rem; max-width: 520px; width: 100%; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35); overflow: hidden; display: flex; flex-direction: column; max-height: calc(100vh - 2rem); margin: auto;">

            <!-- Header Modal (Fixed / Sticky) -->
            <div
                style="padding: 0.9rem 1.25rem; background: linear-gradient(135deg, #0d2b5c 0%, #1d4ed8 100%); color: white; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <span style="font-size: 1.15rem;">🛡️</span>
                    <h3 style="margin: 0; font-size: 1rem; font-weight: 800; letter-spacing: -0.01em;">Setujui Permohonan Rapat</h3>
                </div>
                <button type="button" onclick="closeApproveModal()"
                    style="background: rgba(255, 255, 255, 0.15); border: none; color: white; width: 28px; height: 28px; border-radius: 50%; font-size: 1.25rem; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.2s;"
                    onmouseover="this.style.background='rgba(255,255,255,0.3)'"
                    onmouseout="this.style.background='rgba(255,255,255,0.15)'">&times;</button>
            </div>

            <!-- Form & Scrollable Content -->
            <form action="/request-zoom/approve" method="POST" onsubmit="ensureApproveZoomLinkUrl(event)"
                style="display: flex; flex-direction: column; flex: 1; overflow: hidden; min-height: 0; margin: 0;">
                <input type="hidden" name="id" id="approveModalId">

                <div style="padding: 1.15rem 1.25rem; overflow-y: auto; flex: 1;" class="custom-scroll">
                    <!-- Ringkasan Judul & Pemohon -->
                    <div
                        style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 0.5rem; padding: 0.7rem 0.9rem; margin-bottom: 0.9rem;">
                        <div style="font-size: 0.7rem; color: #1e40af; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em;">
                            Judul Rapat Pemohon:
                        </div>
                        <div style="font-size: 0.9rem; font-weight: 800; color: #0f172a; margin-top: 0.15rem; line-height: 1.3;"
                            id="approveModalJudul"></div>
                        <div style="font-size: 0.75rem; color: #64748b; margin-top: 0.2rem;" id="approveModalPemohon"></div>
                    </div>

                    <!-- Tipe Kegiatan -->
                    <div style="margin-bottom: 0.85rem;">
