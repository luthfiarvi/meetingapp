                                                <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 0.65rem; padding: 0.75rem 0.9rem; margin-bottom: 0.85rem; font-size: 0.8rem; color: #475569; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0.5rem;">
                                                    <div><span style="color: #94a3b8;">Pemohon:</span> <strong><%= req.nama_pemohon || '-' %></strong></div>
                                                    <div><span style="color: #94a3b8;">Divisi:</span> <strong><%= req.divisi || '-' %></strong></div>
                                                    <div><span style="color: #94a3b8;">Jenis Pertemuan:</span> <strong><%= req.tipe_rapat || 'Rapat Biasa' %></strong></div>
                                                    <div><span style="color: #94a3b8;">Tanggal Lengkap:</span> <strong><%= req.tanggal_rapat ? new Date(req.tanggal_rapat).toLocaleDateString('id-ID', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' }) : '-' %></strong></div>
                                                </div>

                                                <!-- DETAIL ZOOM JIKA SUDAH DISETUJUI -->
                                                <% if (req.status === 'disetujui' && req.zoom_link) { %>
