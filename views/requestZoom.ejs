                                                                            style="padding: 1.1rem 1.25rem; white-space: nowrap; color: #64748b; font-size: 0.8rem; font-weight: 600;">
                                                                            <span class="mobile-tgl-prefix" style="display: none;">Diajukan: </span><%= req.tanggal_pengajuan ? new
                                                                                Date(req.tanggal_pengajuan).toLocaleDateString('id-ID',
                                                                                { day: '2-digit' , month: 'short' ,
                                                                                year: 'numeric' }) : '-' %>
                                                                        </td>
                                                                        <td class="col-pemohon-divisi" style="padding: 1.1rem 1.25rem;">
                                                                            <div
                                                                                style="font-weight: 700; color: #0f172a;">
                                                                                <%= req.nama_pemohon || 'Pegawai BKN' %>
                                                                            </div>
                                                                            <div
                                                                                style="font-size: 0.775rem; color: #2563eb; font-weight: 600;">
                                                                                <%= req.divisi || 'Kanreg V BKN' %>
                                                                            </div>
                                                                            <div
                                                                                style="font-size: 0.725rem; color: #64748b;">
                                                                                NIP: <%= req.nip %>
                                                                            </div>
