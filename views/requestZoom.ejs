    <!-- MODAL KONFIRMASI LOGOUT -->
    <div id="logoutModal" class="logout-modal-overlay">
        <div class="logout-modal-card">
            <div class="logout-modal-icon">
                ⚠️
            </div>
            <h3>Konfirmasi Keluar</h3>
            <p>Apakah Anda yakin ingin keluar dari Sistem Informasi Manajemen Ruang Rapat (SIM-RAPAT BKN)?</p>
            <div class="logout-modal-actions">
                <button type="button" class="btn-logout-cancel" onclick="closeLogoutModal()">Batal</button>
                <a href="/logout" class="btn-logout-confirm">Ya, Keluar</a>
            </div>
        </div>
    </div>

    <script>
        function toggleReqCard(cardId) {
            const targetCard = document.getElementById(cardId);
            if (!targetCard) return;
            const isAlreadyOpen = targetCard.classList.contains('open');

            // Tutup kartu lain agar tetap rapi dan tidak memakan banyak tempat (accordion)
            document.querySelectorAll('.req-item.open').forEach(card => {
                card.classList.remove('open');
            });

            // Buka kartu yang diklik jika sebelumnya belum terbuka
            if (!isAlreadyOpen) {
                targetCard.classList.add('open');
            }
        }

        function switchZoomTab(tab) {
            const adminTable = document.getElementById('adminTableContainer');
            const formCont = document.getElementById('formContainer');
            const userHist = document.getElementById('userHistoryContainer');
            const tabBtnAdmin = document.getElementById('tabBtnAdmin');
            const tabBtnForm = document.getElementById('tabBtnForm');
            const grid = document.getElementById('zoomContentGrid');

            if (tab === 'admin') {
                if (adminTable) adminTable.style.display = 'block';
                if (formCont) formCont.style.display = 'none';
                if (userHist) userHist.style.display = 'none';
                if (grid) grid.style.gridTemplateColumns = '1fr';

                tabBtnAdmin.style.color = '#0d2b5c';
                tabBtnAdmin.style.borderBottomColor = '#2563eb';
                tabBtnForm.style.color = '#64748b';
                tabBtnForm.style.borderBottomColor = 'transparent';
            } else {
                if (adminTable) adminTable.style.display = 'none';
                if (formCont) formCont.style.display = 'block';
                if (userHist) userHist.style.display = 'block';
                if (grid) grid.style.gridTemplateColumns = '';

                tabBtnForm.style.color = '#0d2b5c';
                tabBtnForm.style.borderBottomColor = '#2563eb';
                tabBtnAdmin.style.color = '#64748b';
                tabBtnAdmin.style.borderBottomColor = 'transparent';
            }
        }

        function filterAdminTable() {
            const filterVal = document.getElementById('adminStatusFilter').value;
            const rows = document.querySelectorAll('#adminZoomTable tbody tr.admin-zoom-row');
            rows.forEach(row => {
                const status = row.getAttribute('data-status');
                if (filterVal === 'all' || status === filterVal) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function handleTipeRapatChange() {
            const tipeSelect = document.getElementById('inputTipeRapat');
            const ruanganGroup = document.getElementById('ruanganFieldGroup');
            const inputRuangan = document.getElementById('inputRuangan');
            const helper = document.getElementById('tipeRapatHelper');
            const sertifGroup = document.getElementById('webinarSertifFieldGroup');
            if (!tipeSelect) return;

            const val = tipeSelect.value;
            if (val === 'Rapat Offline') {
                if (ruanganGroup) ruanganGroup.style.display = 'block';
                if (inputRuangan) inputRuangan.setAttribute('required', 'required');
                if (sertifGroup) sertifGroup.style.display = 'none';
                if (helper) helper.innerText = '* Permohonan rapat tatap muka (offline) akan diverifikasi ketersediaan ruangannya oleh Admin.';
            } else if (val === 'Webinar') {
                if (ruanganGroup) ruanganGroup.style.display = 'none';
                if (inputRuangan) inputRuangan.removeAttribute('required');
                if (sertifGroup) sertifGroup.style.display = 'block';
                if (helper) helper.innerText = '* Untuk jenis Webinar, peserta presensi akan menerima e-sertifikat resmi & otomatis terhubung ke forum interaktif.';
            } else {
                if (ruanganGroup) ruanganGroup.style.display = 'none';
                if (inputRuangan) inputRuangan.removeAttribute('required');
                if (sertifGroup) sertifGroup.style.display = 'none';
                if (helper) helper.innerText = '* Admin akan menerbitkan link Zoom Meeting resmi dan kredensialnya.';
            }
        }

        function toggleReqTtdFields(enabled) {
            const wrap = document.getElementById('reqSignerFieldsWrap');
            const notice = document.getElementById('reqNoTtdNotice');
            const badge = document.getElementById('reqTtdBadge');
            if (enabled) {
                if (wrap) wrap.style.display = 'grid';
                if (notice) notice.style.display = 'none';
                if (badge) {
                    badge.textContent = 'Aktif';
                    badge.style.background = '#dcfce7';
                    badge.style.color = '#15803d';
                }
            } else {
                if (wrap) wrap.style.display = 'none';
                if (notice) notice.style.display = 'block';
                if (badge) {
                    badge.textContent = 'Nonaktif (Tanpa TTD)';
                    badge.style.background = '#fef3c7';
                    badge.style.color = '#b45309';
                }
            }
        }

        function toggleApproveModalTtdFields(enabled) {
            const wrap = document.getElementById('approveModalSignerBox');
            const notice = document.getElementById('approveModalNoTtdNotice');
            const badge = document.getElementById('approveModalTtdBadge');
            if (enabled) {
                if (wrap) wrap.style.display = 'grid';
                if (notice) notice.style.display = 'none';
                if (badge) {
                    badge.textContent = 'Aktif';
                    badge.style.background = '#dcfce7';
                    badge.style.color = '#15803d';
                }
            } else {
                if (wrap) wrap.style.display = 'none';
                if (notice) notice.style.display = 'block';
                if (badge) {
                    badge.textContent = 'Nonaktif (Tanpa TTD)';
                    badge.style.background = '#fef3c7';
                    badge.style.color = '#b45309';
                }
            }
        }

        function applyReqPreset(type) {
            const hidBg = document.getElementById('hiddenSertifikatBg');
            const img = document.getElementById('sertifBgPreviewImg');
            const wrap = document.getElementById('sertifBgPreviewWrap');
            const ttdBox = document.getElementById('reqEnableTtd');
            const inpPenyelenggara = document.getElementById('reqInpPenyelenggara');
            const fileInp = document.getElementById('inputSertifBgFile');
            if (fileInp) fileInp.value = '';

            if (type === 'aksara') {
                if (hidBg) hidBg.value = '/images/bg-aksara-vol7.png';
                if (img) img.src = '/images/bg-aksara-vol7.png';
                if (wrap) wrap.style.display = 'block';
                const rName = document.getElementById('reqLayoutNameOnly');
                if (rName) rName.checked = true;
                if (ttdBox) {
                    ttdBox.checked = false;
                    toggleReqTtdFields(false);
                }
                if (inpPenyelenggara) inpPenyelenggara.value = 'Kantor Regional V BKN';
            } else if (type === 'bkn_default') {
                clearSertifBg();
                const rFull = document.getElementById('reqLayoutFull');
                if (rFull) rFull.checked = true;
                if (ttdBox) {
                    ttdBox.checked = true;
                    toggleReqTtdFields(true);
                }
                if (inpPenyelenggara) inpPenyelenggara.value = 'Kantor Regional V BKN Jakarta';
            }
        }

        function previewSertifBg(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                if (file.size > 15 * 1024 * 1024) {
                    alert('Ukuran gambar background sertifikat maksimal 15MB');
                    input.value = '';
                    return;
                }
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('hiddenSertifikatBg').value = e.target.result;
                    document.getElementById('sertifBgPreviewImg').src = e.target.result;
                    document.getElementById('sertifBgPreviewWrap').style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        }

        function clearSertifBg() {
            const fileInp = document.getElementById('inputSertifBgFile');
            const hidInp = document.getElementById('hiddenSertifikatBg');
            const img = document.getElementById('sertifBgPreviewImg');
            const wrap = document.getElementById('sertifBgPreviewWrap');
            if (fileInp) fileInp.value = '';
            if (hidInp) hidInp.value = '';
            if (img) img.src = '';
            if (wrap) wrap.style.display = 'none';
        }

        function previewApproveSertifBg(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                if (file.size > 15 * 1024 * 1024) {
                    alert('Ukuran gambar background sertifikat maksimal 15MB');
                    input.value = '';
                    return;
                }
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('approveModalHiddenSertifBg').value = e.target.result;
                    document.getElementById('approveModalSertifPreviewImg').src = e.target.result;
                    document.getElementById('approveModalSertifPreviewWrap').style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        }

        function handleApproveModalTipeChange() {
            const tipeSelect = document.getElementById('approveModalTipe');
            if (!tipeSelect) return;
            const val = tipeSelect.value || '';
            const isOff = val.toLowerCase().includes('offline');
            const isWeb = val.toLowerCase().includes('webinar');
            const zoomLinkInput = document.getElementById('approveModalLink');
            const reqStar = document.getElementById('approveModalLinkRequiredStar');
            const label = document.getElementById('approveModalLinkLabel');
            const rGroup = document.getElementById('approveModalRuanganGroup');
            const sertifGroup = document.getElementById('approveModalSertifGroup');

            if (isOff) {
                if (reqStar) reqStar.style.display = 'none';
                if (zoomLinkInput) zoomLinkInput.removeAttribute('required');
                if (label) label.innerHTML = 'Tautan Zoom / Link Hybrid (Opsional untuk Rapat Offline)';
                if (rGroup) rGroup.style.display = 'block';
                if (sertifGroup) sertifGroup.style.display = 'none';
            } else if (isWeb) {
                if (reqStar) reqStar.style.display = 'inline';
                if (zoomLinkInput) zoomLinkInput.setAttribute('required', 'required');
                if (label) label.innerHTML = 'Tautan Zoom Lengkap (URL) <span id="approveModalLinkRequiredStar" style="color: red;">*</span>';
                if (rGroup) rGroup.style.display = 'none';
                if (sertifGroup) sertifGroup.style.display = 'block';
            } else {
                if (reqStar) reqStar.style.display = 'inline';
                if (zoomLinkInput) zoomLinkInput.setAttribute('required', 'required');
                if (label) label.innerHTML = 'Tautan Zoom Lengkap (URL) <span id="approveModalLinkRequiredStar" style="color: red;">*</span>';
                if (rGroup) rGroup.style.display = 'none';
                if (sertifGroup) sertifGroup.style.display = 'none';
            }
        }

        function handleApproveClick(btn) {
            const id = btn.getAttribute('data-id');
            const judul = btn.getAttribute('data-judul') || '';
            const pemohon = btn.getAttribute('data-pemohon') || '';
            const link = btn.getAttribute('data-link') || '';
            const meetingId = btn.getAttribute('data-meetingid') || '';
            const passcode = btn.getAttribute('data-passcode') || '';
            const catatan = btn.getAttribute('data-catatan') || '';
            const tipe = btn.getAttribute('data-tipe') || 'Rapat Biasa';
            const ruangan = btn.getAttribute('data-ruangan') || '';
            const sertifBg = btn.getAttribute('data-sertif-bg') || '';
            const signer = btn.getAttribute('data-sertif-signer') || '';
            const role = btn.getAttribute('data-sertif-signer-role') || '';
            const penyelenggara = btn.getAttribute('data-sertif-penyelenggara') || '';
            const enableTtd = btn.getAttribute('data-sertif-enable-ttd') !== 'false';
            const layoutMode = btn.getAttribute('data-sertif-layout-mode') || 'full';
            const formatNomor = btn.getAttribute('data-sertif-format-nomor') || '';
            openApproveModal(id, judul, pemohon, link, meetingId, passcode, catatan, tipe, ruangan, sertifBg, signer, role, penyelenggara, enableTtd, layoutMode, formatNomor);
        }

        function handleRejectClick(btn) {
            const id = btn.getAttribute('data-id');
            const judul = btn.getAttribute('data-judul') || '';
            openRejectModal(id, judul);
        }

        function openApproveModal(id, judul, pemohon, link, meetingId, passcode, catatan, tipe, ruangan, sertifBg = '', signer = '', role = '', penyelenggara = '', enableTtd = true, layoutMode = 'full', formatNomor = '') {
            document.getElementById('approveModalId').value = id;
            document.getElementById('approveModalJudul').innerText = judul;
            document.getElementById('approveModalPemohon').innerText = 'Pemohon: ' + pemohon;
            document.getElementById('approveModalLink').value = link || '';
            document.getElementById('approveModalMeetingId').value = meetingId || '';
            document.getElementById('approveModalPasscode').value = passcode || '';
            if (document.getElementById('approveModalRuangan')) {
                document.getElementById('approveModalRuangan').value = ruangan || '';
            }
            const isOff = tipe && tipe.toLowerCase().includes('offline');
            document.getElementById('approveModalCatatan').value = catatan || (isOff ? 'Disetujui untuk Rapat Tatap Muka.' : 'Disetujui oleh Admin.');
            if (document.getElementById('approveModalTipe')) {
                document.getElementById('approveModalTipe').value = tipe || 'Rapat Biasa';
            }

            // Sertifikat fields
            const hidBg = document.getElementById('approveModalHiddenSertifBg');
            const prevWrap = document.getElementById('approveModalSertifPreviewWrap');
            const prevImg = document.getElementById('approveModalSertifPreviewImg');
            const inpSigner = document.getElementById('approveModalSigner');
            const inpRole = document.getElementById('approveModalSignerRole');
            const inpPenyelenggara = document.getElementById('approveModalPenyelenggara');

            if (hidBg) hidBg.value = sertifBg || '';
            if (inpSigner) inpSigner.value = signer || '';
            if (inpRole) inpRole.value = role || '';
            if (inpPenyelenggara) inpPenyelenggara.value = penyelenggara || '';
            const inpFormatNomor = document.getElementById('approveModalFormatNomor');
            if (inpFormatNomor) inpFormatNomor.value = formatNomor || '';

            const ttdBox = document.getElementById('approveModalEnableTtd');
            if (ttdBox) {
                ttdBox.checked = enableTtd;
                toggleApproveModalTtdFields(enableTtd);
            }
            if (layoutMode === 'name_only') {
                const r = document.getElementById('approveModalLayoutNameOnly');
                if (r) r.checked = true;
            } else {
                const r = document.getElementById('approveModalLayoutFull');
                if (r) r.checked = true;
            }

            if (sertifBg && prevWrap && prevImg) {
                prevImg.src = sertifBg;
                prevWrap.style.display = 'block';
            } else if (prevWrap) {
                prevWrap.style.display = 'none';
            }

            handleApproveModalTipeChange();
            document.getElementById('approveModal').style.display = 'flex';
        }

        function closeApproveModal() {
            document.getElementById('approveModal').style.display = 'none';
        }

        function ensureApproveZoomLinkUrl(e) {
            const input = document.getElementById('approveModalLink');
            const tipeSelect = document.getElementById('approveModalTipe');
            const isOff = tipeSelect && tipeSelect.value && tipeSelect.value.toLowerCase().includes('offline');

            if (input && input.value) {
                let val = input.value.trim();
                if (val && !val.startsWith('http://') && !val.startsWith('https://')) {
                    input.value = 'https://' + val;
                }
            } else if (!isOff) {
                if (e) e.preventDefault();
                alert('Tautan Zoom wajib diisi untuk pertemuan daring!');
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            handleTipeRapatChange();
        });

        function openRejectModal(id, judul) {
            document.getElementById('rejectModalId').value = id;
            document.getElementById('rejectModalJudul').innerText = judul;
            document.getElementById('rejectModal').style.display = 'flex';
        }

        function closeRejectModal() {
            document.getElementById('rejectModal').style.display = 'none';
        }

        function copyToClipboard(text) {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(text).then(() => {
                    alert('Tautan Zoom berhasil disalin ke clipboard!');
                });
            } else {
                const input = document.createElement('input');
                input.value = text;
                document.body.appendChild(input);
                input.select();
                document.execCommand('copy');
                document.body.removeChild(input);
                alert('Tautan Zoom berhasil disalin ke clipboard!');
            }
        }

        function copyQuizLink(path) {
            const fullUrl = path.startsWith('http') ? path : (window.location.origin + path);
            if (navigator.clipboard) {
                navigator.clipboard.writeText(fullUrl).then(() => {
                    alert('Tautan Kuis & Forum Q&A Webinar berhasil disalin! Silakan tempel di room chat Zoom untuk peserta.');
                });
            } else {
                const input = document.createElement('input');
                input.value = fullUrl;
                document.body.appendChild(input);
                input.select();
                document.execCommand('copy');
                document.body.removeChild(input);
                alert('Tautan Kuis & Forum Q&A Webinar berhasil disalin! Silakan tempel di room chat Zoom untuk peserta.');
            }
        }

        function showLogoutModal(event) {
            if (event) event.preventDefault();
            document.getElementById("logoutModal").classList.add("show");
        }

        function closeLogoutModal() {
            document.getElementById("logoutModal").classList.remove("show");
        }
    </script>
    <script src="/js/sidebar.js"></script>
</body>

</html>