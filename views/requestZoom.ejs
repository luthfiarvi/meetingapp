                                <input type="text" name="sertifikat_signer" id="approveModalSigner" placeholder="Myrna Amir, S.E., M.M." style="width: 100%; padding: 0.4rem 0.6rem; border: 1px solid #fde68a; border-radius: 0.35rem; font-size: 0.78rem;">
                            </div>
                            <div>
                                <label style="display: block; font-size: 0.7rem; font-weight: 600; color: #78350f; margin-bottom: 0.2rem;">Jabatan:</label>
                                <input type="text" name="sertifikat_signer_role" id="approveModalSignerRole" placeholder="Kepala Kantor Regional V" style="width: 100%; padding: 0.4rem 0.6rem; border: 1px solid #fde68a; border-radius: 0.35rem; font-size: 0.78rem;">
                            </div>
                        </div>
                        <div>
                            <label style="display: block; font-size: 0.7rem; font-weight: 600; color: #78350f; margin-bottom: 0.2rem;">Penyelenggara:</label>
                            <input type="text" name="sertifikat_penyelenggara" id="approveModalPenyelenggara" placeholder="Kantor Regional V BKN Jakarta" style="width: 100%; padding: 0.4rem 0.6rem; border: 1px solid #fde68a; border-radius: 0.35rem; font-size: 0.78rem;">
                        </div>
                        <div style="margin-top: 0.4rem;">
