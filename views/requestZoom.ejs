                                </div>
                            </div>

                            <!-- Filter Status -->
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <select id="adminStatusFilter" onchange="filterAdminTable()" style="padding: 0.5rem 0.85rem; border: 1px solid #cbd5e1; border-radius: 0.5rem; font-size: 0.85rem; font-weight: 600; color: #334155;">
                                    <option value="all">Semua Status (<%= allRequests.length %>)</option>
                                    <option value="menunggu">Menunggu Persetujuan (<%= stats.menunggu %>)</option>
                                    <option value="disetujui">Disetujui (<%= stats.disetujui %>)</option>
                                    <option value="ditolak">Ditolak (<%= stats.ditolak %>)</option>
                                </select>
                            </div>
                        </div>

                        <div style="overflow-x: auto;">
                            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem;" id="adminZoomTable">
                                <thead>
                                    <tr style="background: #f1f5f9; border-bottom: 1px solid #e2e8f0; color: #475569; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">
                                        <th style="padding: 1rem 1.25rem;">Tgl Pengajuan</th>
                                        <th style="padding: 1rem 1.25rem;">Pemohon & Divisi</th>
                                        <th style="padding: 1rem 1.25rem;">Judul Rapat Zoom</th>
                                        <th style="padding: 1rem 1.25rem;">Jadwal Pelaksanaan</th>
                                        <th style="padding: 1rem 1.25rem;">Status</th>
                                        <th style="padding: 1rem 1.25rem; text-align: right;">Aksi Sidigi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (allRequests && allRequests.length > 0) { %>
                                        <% allRequests.forEach(req => { %>
                                            <tr class="admin-zoom-row" data-status="<%= req.status %>" style="border-bottom: 1px solid #f1f5f9; transition: background 0.15s ease;">
                                                <td style="padding: 1.1rem 1.25rem; white-space: nowrap; color: #64748b; font-size: 0.8rem; font-weight: 600;">
                                                    <%= req.tanggal_pengajuan ? new Date(req.tanggal_pengajuan).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) : '-' %>
                                                </td>
                                                <td style="padding: 1.1rem 1.25rem;">
                                                    <div style="font-weight: 700; color: #0f172a;"><%= req.nama_pemohon || 'Pegawai BKN' %></div>
                                                    <div style="font-size: 0.775rem; color: #2563eb; font-weight: 600;"><%= req.divisi || 'Kanreg V BKN' %></div>
                                                    <div style="font-size: 0.725rem; color: #64748b;">NIP: <%= req.nip %></div>
                                                </td>
                                                <td style="padding: 1.1rem 1.25rem; max-width: 260px;">
                                                    <div style="font-weight: 700; color: #1e293b; line-height: 1.4;">
                                                        <%= req.judul_rapat %>
                                                        <% if (req.tipe_rapat === 'Webinar') { %>
                                                            <span style="font-size: 0.65rem; font-weight: 800; background: #fff7ed; color: #ea580c; border: 1px solid #fdba74; padding: 0.15rem 0.45rem; border-radius: 9999px; margin-left: 0.35rem; display: inline-block;">🎯 WEBINAR</span>
                                                        <% } %>
                                                    </div>
                                                    <% if (req.keterangan) { %>
                                                        <div style="font-size: 0.75rem; color: #64748b; margin-top: 0.35rem; background: #f8fafc; padding: 0.35rem 0.6rem; border-radius: 0.375rem; border: 1px solid #e2e8f0;">
                                                            💡 <%= req.keterangan %>
                                                        </div>
                                                    <% } %>
                                                </td>
                                                <td style="padding: 1.1rem 1.25rem; white-space: nowrap;">
                                                    <div style="font-weight: 700; color: #0d2b5c;">
                                                        📅 <%= req.tanggal_rapat ? new Date(req.tanggal_rapat).toLocaleDateString('id-ID', { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' }) : '-' %>
                                                    </div>
                                                    <div style="font-size: 0.775rem; color: #64748b; margin-top: 0.2rem;">
                                                        ⏰ <%= req.waktu_mulai ? req.waktu_mulai.substring(0, 5) : '09:00' %> - <%= req.waktu_selesai ? req.waktu_selesai.substring(0, 5) : 'Selesai' %> WIB
                                                    </div>
                                                </td>
                                                <td style="padding: 1.1rem 1.25rem; white-space: nowrap;">
                                                    <% if (req.status === 'disetujui') { %>
                                                        <span style="display: inline-flex; align-items: center; gap: 0.35rem; background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; padding: 0.35rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700;">
                                                            ✓ Disetujui
                                                        </span>
                                                    <% } else if (req.status === 'ditolak') { %>
                                                        <span style="display: inline-flex; align-items: center; gap: 0.35rem; background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; padding: 0.35rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700;">
                                                            ✕ Ditolak
                                                        </span>
                                                    <% } else { %>
                                                        <span style="display: inline-flex; align-items: center; gap: 0.35rem; background: #fffbeb; color: #b45309; border: 1px solid #fde68a; padding: 0.35rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700;">
                                                            ⏳ Menunggu
                                                        </span>
                                                    <% } %>
                                                </td>
                                                <td style="padding: 1.1rem 1.25rem; text-align: right; white-space: nowrap;">
                                                    <div style="display: inline-flex; gap: 0.5rem;">
                                                        <button type="button" 
                                                            class="btn-approve" 
                                                            data-id="<%= req.id %>"
                                                            data-judul="<%= req.judul_rapat %>"
                                                            data-pemohon="<%= req.nama_pemohon %>"
                                                            data-link="<%= req.zoom_link || '' %>"
                                                            data-meetingid="<%= req.meeting_id || '' %>"
                                                            data-passcode="<%= req.passcode || '' %>"
                                                            data-catatan="<%= req.catatan_admin || '' %>"
                                                            data-tipe="<%= req.tipe_rapat || 'Rapat Biasa' %>"
                                                            data-quizlink="<%= req.quiz_link || '' %>"
                                                            onclick="handleApproveClick(this)"
                                                            style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; padding: 0.45rem 0.85rem; border-radius: 0.5rem; font-size: 0.8rem; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 0.35rem;">
                                                            <span>🔗</span>
                                                            <span><%= req.status === 'disetujui' ? 'Edit Link' : 'Setujui & Link' %></span>
                                                        </button>
                                                        
                                                        <% if (req.status === 'menunggu') { %>
                                                            <button type="button" 
                                                                data-id="<%= req.id %>"
                                                                data-judul="<%= req.judul_rapat %>"
                                                                onclick="handleRejectClick(this)"
                                                                style="background: #fff1f2; color: #e11d48; border: 1px solid #fecdd3; padding: 0.45rem 0.75rem; border-radius: 0.5rem; font-size: 0.8rem; font-weight: 700; cursor: pointer;">
                                                                Tolak
                                                            </button>
                                                        <% } %>

                                                        <form action="/request-zoom/delete" method="POST" onsubmit="return confirm('Hapus permohonan ini secara permanen?')" style="display: inline;">
                                                            <input type="hidden" name="id" value="<%= req.id %>">
                                                            <button type="submit" style="background: #f8fafc; color: #64748b; border: 1px solid #e2e8f0; padding: 0.45rem 0.6rem; border-radius: 0.5rem; font-size: 0.8rem; cursor: pointer;" title="Hapus">
                                                                🗑️
                                                            </button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" style="padding: 3rem; text-align: center; color: #64748b;">
                                                <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">📬</div>
                                                <div style="font-weight: 700; color: #1e293b;">Belum ada permohonan Zoom yang masuk</div>
                                                <p style="font-size: 0.85rem; margin: 0.25rem 0 0;">Pengajuan dari divisi lain akan muncul di tabel ini.</p>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                    </div>
                <% } %>

                <!-- =======================================================
                     KANAN: RIWAYAT PERMOHONAN SAYA (UNTUK DIVISI PEMOHON)
                     ======================================================= -->
                <div id="userHistoryContainer" style="<%= isAdmin ? 'display: none;' : '' %>">
                    <div style="background: #ffffff; border-radius: 1.25rem; border: 1px solid #e2e8f0; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05); overflow: hidden;">
                        
                        <div style="padding: 1.5rem 1.75rem; background: linear-gradient(135deg, #f8fafc 0%, #edf2f7 100%); border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between;">
                            <div style="display: flex; align-items: center; gap: 0.75rem;">
                                <div style="width: 40px; height: 40px; border-radius: 10px; background: #059669; color: white; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                                    🕒
                                </div>
                                <div>
                                    <h2 style="font-size: 1.15rem; font-weight: 800; color: #0f172a; margin: 0;">Status Permohonan Saya</h2>
                                    <p style="font-size: 0.8rem; color: #64748b; margin: 0.2rem 0 0;">Pantau status & klik permohonan untuk membuka rincian link Zoom</p>
                                </div>
                            </div>
                            <span style="font-size: 0.75rem; font-weight: 700; background: #dbeafe; color: #1d4ed8; padding: 0.35rem 0.75rem; border-radius: 9999px;">
                                <%= myRequests.length %> Pengajuan
                            </span>
                        </div>

                        <div class="custom-scroll" style="padding: 1.25rem; max-height: 650px; overflow-y: auto;">
                            <% if (myRequests && myRequests.length > 0) { %>
                                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                                    <% myRequests.forEach(req => { %>
                                        <div class="req-item" id="req-card-<%= req.id %>">
                                            
                                            <!-- HEADER RINGKAS (KLIK UNTUK BUKA/TUTUP DETAIL) -->
                                            <div class="req-header" onclick="toggleReqCard('req-card-<%= req.id %>')" title="Klik untuk membuka / menutup rincian">
                                                <div style="flex: 1; min-width: 0; padding-right: 0.5rem;">
                                                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                                                        <h3 style="font-size: 0.95rem; font-weight: 700; color: #0d2b5c; margin: 0; line-height: 1.35; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                            <%= req.judul_rapat %>
                                                        </h3>
                                                        <% if (req.tipe_rapat && req.tipe_rapat.toLowerCase().includes('webinar')) { %>
                                                            <span style="font-size: 0.65rem; font-weight: 700; background: #fff7ed; color: #ea580c; border: 1px solid #fed7aa; padding: 0.15rem 0.45rem; border-radius: 9999px; white-space: nowrap;">
                                                                Webinar
                                                            </span>
                                                        <% } %>
                                                    </div>
                                                    <div style="font-size: 0.775rem; color: #64748b; display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap;">
                                                        <span>📅 <%= req.tanggal_rapat ? new Date(req.tanggal_rapat).toLocaleDateString('id-ID', { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' }) : '-' %></span>
                                                        <span>⏰ <%= req.waktu_mulai ? req.waktu_mulai.substring(0, 5) : '09:00' %> - <%= req.waktu_selesai ? req.waktu_selesai.substring(0, 5) : 'Selesai' %> WIB</span>
                                                    </div>
                                                </div>

                                                <div style="display: flex; align-items: center; gap: 0.6rem; flex-shrink: 0;">
                                                    <div>
                                                        <% if (req.status === 'disetujui') { %>
                                                            <span style="display: inline-flex; align-items: center; gap: 0.3rem; background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; padding: 0.25rem 0.65rem; border-radius: 9999px; font-size: 0.725rem; font-weight: 700; white-space: nowrap;">
                                                                ✓ Disetujui Sidigi
                                                            </span>
                                                        <% } else if (req.status === 'ditolak') { %>
                                                            <span style="display: inline-flex; align-items: center; gap: 0.3rem; background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; padding: 0.25rem 0.65rem; border-radius: 9999px; font-size: 0.725rem; font-weight: 700; white-space: nowrap;">
                                                                ✕ Ditolak
                                                            </span>
                                                        <% } else { %>
                                                            <span style="display: inline-flex; align-items: center; gap: 0.3rem; background: #fffbeb; color: #b45309; border: 1px solid #fde68a; padding: 0.25rem 0.65rem; border-radius: 9999px; font-size: 0.725rem; font-weight: 700; white-space: nowrap;">
                                                                ⏳ Menunggu Sidigi
                                                            </span>
                                                        <% } %>
                                                    </div>
                                                    <div class="req-chevron">
