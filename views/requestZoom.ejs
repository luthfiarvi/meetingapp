                                                                                        <span
                                                                                            style="font-size: 0.65rem; font-weight: 800; background: #fff7ed; color: #ea580c; border: 1px solid #fdba74; padding: 0.15rem 0.45rem; border-radius: 9999px; margin-left: 0.35rem; display: inline-block;">🎯
                                                                                            WEBINAR</span>
                                                                                    <% } else if (req.tipe_rapat && req.tipe_rapat.toLowerCase().includes('offline')) { %>
                                                                                        <span
                                                                                            style="font-size: 0.65rem; font-weight: 800; background: #f0fdf4; color: #166534; border: 1px solid #86efac; padding: 0.15rem 0.45rem; border-radius: 9999px; margin-left: 0.35rem; display: inline-block;">🏢
                                                                                            OFFLINE</span>
                                                                                    <% } else { %>
                                                                                        <span
                                                                                            style="font-size: 0.65rem; font-weight: 800; background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; padding: 0.15rem 0.45rem; border-radius: 9999px; margin-left: 0.35rem; display: inline-block;">👥
                                                                                            ZOOM</span>
                                                                                    <% } %>
                                                                            </div>
                                                                            <% if (req.ruangan) { %>
                                                                                <div
                                                                                    style="font-size: 0.75rem; color: #166534; margin-top: 0.35rem; background: #f0fdf4; padding: 0.25rem 0.5rem; border-radius: 0.375rem; border: 1px solid #bbf7d0; font-weight: 600;">
                                                                                    📍 Ruang: <%= req.ruangan %>
                                                                                </div>
                                                                            <% } %>
                                                                            <% if (req.keterangan) { %>
                                                                                <div
                                                                                    style="font-size: 0.75rem; color: #64748b; margin-top: 0.35rem; background: #f8fafc; padding: 0.35rem 0.6rem; border-radius: 0.375rem; border: 1px solid #e2e8f0;">
                                                                                    💡 <%= req.keterangan %>
                                                                                </div>
                                                                            <% } %>
                                                                        </td>
                                                                        <td class="col-jadwal-pelaksanaan"
                                                                            style="padding: 1.1rem 1.25rem; white-space: nowrap;">
                                                                            <div
                                                                                style="font-weight: 700; color: #0d2b5c;">
                                                                                📅 <%= req.tanggal_rapat ? new
                                                                                    Date(req.tanggal_rapat).toLocaleDateString('id-ID',
                                                                                    { weekday: 'short' , day: '2-digit'
                                                                                    , month: 'short' , year: 'numeric'
                                                                                    }) : '-' %>
                                                                            </div>
                                                                            <div
                                                                                style="font-size: 0.775rem; color: #64748b; margin-top: 0.2rem;">
                                                                                ⏰ <%= req.waktu_mulai ?
                                                                                    req.waktu_mulai.substring(0, 5)
                                                                                    : '09:00' %> - <%= req.waktu_selesai
                                                                                        ? req.waktu_selesai.substring(0,
                                                                                        5) : 'Selesai' %> WIB
                                                                            </div>
                                                                        </td>
                                                                        <td class="col-status-badge"
                                                                            style="padding: 1.1rem 1.25rem; white-space: nowrap;">
                                                                            <% if (req.status==='disetujui' ) { %>
                                                                                <span
                                                                                    style="display: inline-flex; align-items: center; gap: 0.35rem; background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; padding: 0.35rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700;">
                                                                                    ✓ Disetujui
                                                                                </span>
                                                                                <% } else if (req.status==='ditolak' ) {
                                                                                    %>
                                                                                    <span
                                                                                        style="display: inline-flex; align-items: center; gap: 0.35rem; background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; padding: 0.35rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700;">
                                                                                        ✕ Ditolak
                                                                                    </span>
                                                                                    <% } else { %>
                                                                                        <span
                                                                                            style="display: inline-flex; align-items: center; gap: 0.35rem; background: #fffbeb; color: #b45309; border: 1px solid #fde68a; padding: 0.35rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700;">
                                                                                            ⏳ Menunggu
                                                                                        </span>
                                                                                        <% } %>
                                                                        </td>
                                                                        <td class="col-aksi-sidigi"
                                                                            style="padding: 1.1rem 1.25rem; text-align: right; white-space: nowrap;">
                                                                            <div class="aksi-buttons-wrap"
                                                                                style="display: inline-flex; gap: 0.5rem;">
                                                                                <% const isOfflineReq = req.tipe_rapat && req.tipe_rapat.toLowerCase().includes('offline'); %>
                                                                                <button type="button"
                                                                                    class="btn-approve"
                                                                                    data-id="<%= req.id %>"
                                                                                    data-judul="<%= req.judul_rapat %>"
                                                                                    data-pemohon="<%= req.nama_pemohon %>"
                                                                                    data-link="<%= req.zoom_link || '' %>"
                                                                                    data-meetingid="<%= req.meeting_id || '' %>"
                                                                                    data-passcode="<%= req.passcode || '' %>"
                                                                                    data-catatan="<%= req.catatan_admin || '' %>"
                                                                                    data-tipe="<%= req.tipe_rapat || 'Rapat Biasa' %>"
                                                                                    data-ruangan="<%= req.ruangan || '' %>"
                                                                                    data-quizlink="<%= req.quiz_link || '' %>"
                                                                                    data-sertif-bg="<%= req.sertifikat_bg || '' %>"
                                                                                    data-sertif-signer="<%= req.sertifikat_signer || '' %>"
                                                                                    data-sertif-signer-role="<%= req.sertifikat_signer_role || '' %>"
                                                                                    data-sertif-penyelenggara="<%= req.sertifikat_penyelenggara || '' %>"
                                                                                    data-sertif-enable-ttd="<%= req.sertifikat_enable_ttd !== false ? 'true' : 'false' %>"
                                                                                    data-sertif-layout-mode="<%= req.sertifikat_layout_mode || 'full' %>"
                                                                                    data-sertif-format-nomor="<%= req.sertifikat_format_nomor || '' %>"
                                                                                    onclick="handleApproveClick(this)"
                                                                                    style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; padding: 0.45rem 0.85rem; border-radius: 0.5rem; font-size: 0.8rem; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 0.35rem;">
                                                                                    <span><%= isOfflineReq ? '🏢' : '🔗' %></span>
                                                                                    <span>
                                                                                        <%= req.status==='disetujui'
                                                                                            ? (isOfflineReq ? 'Edit Approval' : 'Edit Link')
                                                                                            : (isOfflineReq ? 'Setujui Rapat' : 'Setujui & Link') %>
                                                                                    </span>
                                                                                </button>

                                                                                <% if (req.status==='menunggu' ) { %>
                                                                                    <button type="button"
                                                                                        data-id="<%= req.id %>"
                                                                                        data-judul="<%= req.judul_rapat %>"
                                                                                        onclick="handleRejectClick(this)"
                                                                                        style="background: #fff1f2; color: #e11d48; border: 1px solid #fecdd3; padding: 0.45rem 0.75rem; border-radius: 0.5rem; font-size: 0.8rem; font-weight: 700; cursor: pointer;">
                                                                                        Tolak
                                                                                    </button>
                                                                                    <% } %>

                                                                                        <form
                                                                                            action="/request-zoom/delete"
                                                                                            method="POST"
                                                                                            onsubmit="return confirm('Hapus permohonan ini secara permanen?')"
                                                                                            style="display: inline;">
                                                                                            <input type="hidden"
                                                                                                name="id"
                                                                                                value="<%= req.id %>">
                                                                                            <button type="submit"
                                                                                                style="background: #f8fafc; color: #64748b; border: 1px solid #e2e8f0; padding: 0.45rem 0.6rem; border-radius: 0.5rem; font-size: 0.8rem; cursor: pointer;"
                                                                                                title="Hapus">
                                                                                                🗑️
                                                                                            </button>
                                                                                        </form>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                    <% }) %>
                                                                        <% } else { %>
                                                                            <tr>
                                                                                <td colspan="6"
                                                                                    style="padding: 3rem; text-align: center; color: #64748b;">
                                                                                    <div
                                                                                        style="font-size: 2.5rem; margin-bottom: 0.5rem;">
                                                                                        📬</div>
                                                                                    <div
                                                                                        style="font-weight: 700; color: #1e293b;">
                                                                                        Belum ada permohonan rapat yang
                                                                                        masuk</div>
                                                                                    <p
                                                                                        style="font-size: 0.85rem; margin: 0.25rem 0 0;">
                                                                                        Pengajuan rapat tatap muka (offline) maupun daring dari divisi lain akan
                                                                                        muncul di tabel ini.</p>
                                                                                </td>
                                                                            </tr>
                                                                            <% } %>
                                                        </tbody>
                                                    </table>
                                                </div>

                                            </div>
                                            <% } %>

                                                <!-- =======================================================
                     KANAN: RIWAYAT PERMOHONAN SAYA (UNTUK DIVISI PEMOHON)
                     ======================================================= -->
                                                <div id="userHistoryContainer" class="zoom-col-history"
