                        <input type="text" name="zoom_link" id="approveModalLink"
                            placeholder="Contoh: https://bkn.zoom.us/j/84291823910 atau us04web.zoom.us/j/..." required
                            style="width: 100%; padding: 0.55rem 0.75rem; border: 1.5px solid #2563eb; border-radius: 0.5rem; font-size: 0.825rem;">
                    </div>

                    <!-- Meeting ID & Passcode -->
                    <div id="approveModalCredsGroup" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.85rem;">
