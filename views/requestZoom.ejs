                                                            <a href="<%= req.zoom_link %>" target="_blank" rel="noopener noreferrer" style="padding: 0.5rem 0.9rem; background: #2563eb; color: white; border-radius: 0.5rem; font-size: 0.8rem; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem; white-space: nowrap;">
                                                                Buka 🚀
                                                            </a>
                                                        </div>

                                                        <% if (req.meeting_id || req.passcode) { %>
