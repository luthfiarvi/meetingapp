                            style="display: block; font-size: 0.75rem; font-weight: 700; color: #166534; margin-bottom: 0.3rem; text-transform: uppercase;">
                            📍 Lokasi / Ruang Rapat Kanreg V
                        </label>
                        <input type="text" name="ruangan" id="approveModalRuangan" placeholder="Contoh: Ruang Rapat Lantai 2 / Aula Kanreg V"
                            style="width: 100%; padding: 0.55rem 0.75rem; border: 1.5px solid #86efac; background: #f0fdf4; border-radius: 0.5rem; font-size: 0.825rem; color: #0f172a; font-weight: 600;">
                    </div>

