                                                                                                                    pada:
                                                                                                                    <%= req.tanggal_pengajuan
                                                                                                                        ?
                                                                                                                        new
                                                                                                                        Date(req.tanggal_pengajuan).toLocaleDateString('id-ID')
                                                                                                                        : '-'
                                                                                                                        %>
                                                                                                                </span>
                                                                                                                <% if
                                                                                                                    (req.status==='menunggu'
