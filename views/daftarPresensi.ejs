<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daftar Presensi Meeting | BKN</title>
    <link rel="stylesheet" href="/presensi.css">
    <script src="/js/html2pdf.bundle.min.js"></script>
</head>

<body>

<div class="presensi-page">

    <!-- GELEMBUNG BACKGROUND -->
    <div class="bubble bubble-1"></div>
    <div class="bubble bubble-2"></div>
    <div class="bubble bubble-3"></div>
    <div class="bubble bubble-4"></div>
    <div class="bubble bubble-5"></div>

    <!-- CARD DAFTAR PRESENSI -->
    <div class="presensi-card daftar-card">

        <!-- LOGO BKN -->
        <div class="logo-wrapper">
            <div class="brand-logo-card">
                <img src="/logo-bkn-asli.png" alt="Logo BKN" class="logo-bkn">
            </div>
        </div>

        <!-- JUDUL HEADER -->
        <div class="login-header">
            <h1>Meeting App</h1>
            <p>Kantor Regional V BKN Jakarta</p>
        </div>

        <!-- WELCOME / SUMMARY BOX -->
        <div class="welcome-box daftar-header-box">
            <div class="header-text">
                <h2>Daftar Presensi Meeting</h2>
                <p>Data peserta yang telah melakukan presensi pada rapat ini.</p>
            </div>
            <div class="total-badge">
                <span>Total Peserta</span>
                <strong><%= dataPresensi.length %> Orang</strong>
            </div>
        </div>

        <!-- NAVIGATION ACTION BAR -->
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 20px; flex-wrap:wrap; gap:10px;">
            <a href="/manajemenmeeting" style="display:inline-flex; align-items:center; gap:6px; padding:9px 16px; background:#f1f5f9; color:#334155; border-radius:10px; font-size:12.5px; font-weight:600; text-decoration:none; border:1px solid #cbd5e1; transition: 0.2s;">
                ← Kembali ke Manajemen Meeting
            </a>
            
            <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                <!-- TOMBOL UNDUH PRESENSI PDF -->
                <button type="button" id="btnDownloadPresensiPdf" onclick="downloadPresensiPdf()" style="display:inline-flex; align-items:center; gap:6px; padding:9px 16px; background:linear-gradient(135deg, #059669, #10b981); color:#ffffff; border:none; border-radius:10px; font-size:12.5px; font-weight:700; cursor:pointer; box-shadow:0 4px 12px rgba(16,185,129,0.25); transition: 0.2s;">
                    📥 Unduh Presensi (PDF)
                </button>

                <!-- TOMBOL PRATINJAU CETAK -->
                <a href="/daftar-presensi/<%= meeting_id %>/pdf" target="_blank" style="display:inline-flex; align-items:center; gap:6px; padding:9px 14px; background:#ffffff; color:#1e293b; border-radius:10px; font-size:12.5px; font-weight:600; text-decoration:none; border:1px solid #cbd5e1; transition: 0.2s;" title="Lihat Lembar Format Cetak A4">
                    🖨️ Cetak / Print
                </a>

                <!-- BUKA FORM PRESENSI -->
                <a href="/presensi/<%= meeting_id %>" target="_blank" style="display:inline-flex; align-items:center; gap:6px; padding:9px 16px; background:#2563eb; color:#ffffff; border-radius:10px; font-size:12.5px; font-weight:600; text-decoration:none; box-shadow:0 4px 12px rgba(37,99,235,0.25); transition: 0.2s;">
                    ✍️ Buka Form Presensi Peserta ↗
                </a>
            </div>
        </div>

        <% if (dataPresensi.length === 0) { %>

            <div class="empty-state">
                <div class="empty-icon">📋</div>
                <h3>Belum Ada Presensi</h3>
                <p>Belum ada peserta yang melakukan presensi untuk meeting ini.</p>
            </div>

        <% } else { %>

            <div class="peserta-list">

                <% dataPresensi.forEach((peserta, index) => { %>

                    <div class="peserta-card">

                        <div class="peserta-header">
                            <span class="peserta-number">#<%= index + 1 %></span>
                            <h3 class="peserta-nama"><%= peserta.nama %></h3>
                        </div>

                        <div class="peserta-details-grid">
                            <div class="detail-item">
                                <span class="detail-label">🆔 NIP / NIK</span>
                                <span class="detail-value"><%= peserta.nip || "-" %></span>
                            </div>

                            <div class="detail-item">
                                <span class="detail-label">🏢 Instansi</span>
                                <span class="detail-value"><%= peserta.instansi || "-" %></span>
                            </div>

                            <div class="detail-item">
                                <span class="detail-label">💼 Jabatan</span>
                                <span class="detail-value"><%= peserta.jabatan || "-" %></span>
                            </div>

                            <div class="detail-item">
                                <span class="detail-label">✉️ Email</span>
                                <span class="detail-value"><%= peserta.email || "-" %></span>
                            </div>

                            <div class="detail-item full-width">
                                <span class="detail-label">📝 Keterangan</span>
                                <span class="detail-value"><%= peserta.keterangan || "-" %></span>
                            </div>

                            <div class="detail-item full-width">
                                <span class="detail-label">⏰ Waktu Presensi</span>
                                <span class="detail-value time-badge"><%= peserta.waktu_presensi ? (peserta.waktu_presensi instanceof Date ? peserta.waktu_presensi.toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) : peserta.waktu_presensi) : '-' %></span>
                            </div>
                        </div>

                        <% if (peserta.tanda_tangan) { %>
                            <div class="signature-display-box">
                                <span class="detail-label">✍️ Tanda Tangan:</span>
                                <div class="signature-img-wrapper">
                                    <img
                                        src="<%= peserta.tanda_tangan.startsWith('/') ? peserta.tanda_tangan : '/uploads/ttd/' + peserta.tanda_tangan %>"
                                        alt="Tanda tangan <%= peserta.nama %>"
                                    >
                                </div>
                            </div>
                        <% } %>

                    </div>

                <% }); %>

            </div>

        <% } %>

        <!-- FOOTER -->
        <div class="login-footer">
            <p>Meeting App</p>
            <span>Badan Kepegawaian Negara • 2026</span>
        </div>

    </div>

</div>

<!-- TEMPLATE PDF CETAK FORMAL SESUAI CONTOH FOTO (OFFSCREEN UNTUK HTML2PDF) -->
<div id="presensiPdfWrapper" style="position: absolute; left: -9999px; top: -9999px; width: 0; height: 0; overflow: hidden;">
    <div id="presensiPdfContent" style="width: 210mm; min-height: 290mm; padding: 15mm 15mm 15mm 15mm; background: #ffffff; color: #000000; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; box-sizing: border-box;">
        
        <!-- KOP SURAT BKN -->
        <div style="display: flex; align-items: center; justify-content: center; gap: 16px; padding-bottom: 10px; border-bottom: 3px double #000000; margin-bottom: 14px;">
            <img src="/logo-bkn-asli.png" alt="Logo BKN" style="width: 60px; height: auto;">
            <div style="text-align: center;">
                <div style="font-size: 13pt; font-weight: bold; letter-spacing: 0.5px; text-transform: uppercase;">BADAN KEPEGAWAIAN NEGARA</div>
                <div style="font-size: 11pt; font-weight: bold; text-transform: uppercase;">KANTOR REGIONAL V JAKARTA</div>
                <div style="font-size: 8pt; color: #333; margin-top: 2px;">
                    Jalan Raya Ciracas Nomor 36, Ciracas, Jakarta Timur, DKI Jakarta 13730<br>
                    Telepon (021) 87721084 - 87721085 | Laman: jakarta.bkn.go.id
                </div>
            </div>
        </div>

        <!-- JUDUL DOKUMEN -->
        <div style="text-align: center; margin-bottom: 14px;">
            <h2 style="font-size: 12pt; font-weight: bold; text-decoration: underline; text-transform: uppercase; margin: 0;">
                DAFTAR HADIR PESERTA RAPAT
            </h2>
        </div>

        <!-- HEADER DATA DARI MEETING TSB -->
        <table style="width: 100%; border-collapse: collapse; font-size: 9pt; margin-bottom: 14px; border: none;">
            <tr>
                <td style="width: 24%; font-weight: bold; padding: 2.5px 0; border: none;">Nama Rapat / Acara</td>
                <td style="width: 2%; text-align: center; border: none;">:</td>
                <td style="width: 74%; border: none;"><strong><%= (meeting && meeting.meeting_nama) ? meeting.meeting_nama : '-' %></strong></td>
            </tr>
            <tr>
                <td style="font-weight: bold; padding: 2.5px 0; border: none;">Hari / Tanggal</td>
                <td style="text-align: center; border: none;">:</td>
                <td style="border: none;"><%= formattedTanggal %></td>
            </tr>
            <tr>
                <td style="font-weight: bold; padding: 2.5px 0; border: none;">Tipe / Media</td>
                <td style="text-align: center; border: none;">:</td>
                <td style="border: none;"><%= (meeting && meeting.tipe_meeting) ? meeting.tipe_meeting : 'Rapat Kedinasan' %></td>
            </tr>
            <% if (meeting && meeting.deskripsi) { %>
            <tr>
                <td style="font-weight: bold; padding: 2.5px 0; border: none;">Agenda / Pembahasan</td>
                <td style="text-align: center; border: none;">:</td>
                <td style="border: none;"><%= meeting.deskripsi %></td>
            </tr>
            <% } %>
            <tr>
                <td style="font-weight: bold; padding: 2.5px 0; border: none;">Jumlah Peserta Hadir</td>
                <td style="text-align: center; border: none;">:</td>
                <td style="border: none;"><strong><%= dataPresensi.length %></strong> Orang</td>
            </tr>
        </table>

        <!-- TABEL PRESENSI FORMAT SESUAI FOTO -->
        <table style="width: 100%; border-collapse: collapse; font-size: 9.5pt; margin-bottom: 20px;">
            <thead>
                <tr style="background-color: #f1f5f9;">
                    <th style="border: 1px solid #000; padding: 6px 4px; width: 8%; text-align: center; font-weight: bold;">NO</th>
                    <th style="border: 1px solid #000; padding: 6px 8px; width: 28%; text-align: center; font-weight: bold;">NIP/NIK</th>
                    <th style="border: 1px solid #000; padding: 6px 8px; width: 36%; text-align: center; font-weight: bold;">Nama</th>
                    <th style="border: 1px solid #000; padding: 6px 8px; width: 28%; text-align: center; font-weight: bold;">TTD</th>
                </tr>
            </thead>
            <tbody>
                <% if (dataPresensi && dataPresensi.length > 0) { %>
                    <% dataPresensi.forEach((peserta, idx) => { %>
                        <tr style="page-break-inside: avoid;">
                            <td style="border: 1px solid #000; padding: 6px 4px; text-align: center; vertical-align: middle;">
                                <%= idx + 1 %>.
                            </td>
                            <td style="border: 1px solid #000; padding: 6px 8px; text-align: center; vertical-align: middle; font-family: monospace, sans-serif; font-size: 9pt;">
                                <%= peserta.nip || '-' %>
                            </td>
                            <td style="border: 1px solid #000; padding: 6px 8px; vertical-align: middle;">
                                <div style="font-weight: bold; color: #000;"><%= peserta.nama %></div>
                                <% if (peserta.jabatan || peserta.instansi) { %>
                                    <div style="font-size: 8pt; color: #444; margin-top: 1px;">
                                        <%= [peserta.jabatan, peserta.instansi].filter(Boolean).join(' • ') %>
                                    </div>
                                <% } %>
                            </td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: middle;">
                                <% if (peserta.tanda_tangan) { %>
                                    <img 
                                        src="<%= peserta.tanda_tangan.startsWith('/') ? peserta.tanda_tangan : '/uploads/ttd/' + peserta.tanda_tangan %>" 
                                        alt="TTD" 
                                        style="max-height: 44px; max-width: 120px; object-fit: contain; display: block; margin: 0 auto;"
                                    >
                                <% } else { %>
                                    <span style="font-size: 8pt; color: #888; font-style: italic;">(Tanpa Tanda Tangan)</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="4" style="border: 1px solid #000; text-align: center; padding: 18px; font-style: italic; color: #666;">
                            Belum ada peserta yang melakukan presensi pada rapat ini.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>

        <!-- TANDA TANGAN PENYELENGGARA -->
        <div style="display: flex; justify-content: flex-end; margin-top: 20px; page-break-inside: avoid;">
            <div style="width: 220px; text-align: center; font-size: 9.5pt;">
                <div>Jakarta, <%= todayFormatted %></div>
                <div style="font-weight: bold; margin-top: 3px;">Penyelenggara / Notulis Rapat,</div>
                <div style="height: 55px;"></div>
                <div style="font-weight: bold; text-decoration: underline;">( ................................................ )</div>
                <div style="font-size: 8.5pt; color: #333; margin-top: 2px;">NIP. ............................................</div>
            </div>
        </div>

    </div>
</div>

<script>
function downloadPresensiPdf() {
    const btn = document.getElementById('btnDownloadPresensiPdf');
    const originalText = btn.innerHTML;
    btn.innerHTML = '⏳ Menyiapkan PDF...';
    btn.disabled = true;

    const element = document.getElementById('presensiPdfContent');
    const meetingTitle = "<%= (meeting && meeting.meeting_nama) ? meeting.meeting_nama.replace(/[^a-zA-Z0-9]/g, '_') : 'Meeting_' + meeting_id %>";
    const filename = `Daftar_Presensi_${meetingTitle}.pdf`;

    const opt = {
        margin: [10, 10, 10, 10],
        filename: filename,
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, useCORS: true, logging: false },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
    };

    html2pdf().set(opt).from(element).save().then(() => {
        btn.innerHTML = originalText;
        btn.disabled = false;
    }).catch(err => {
        console.error("Gagal mengunduh PDF:", err);
        btn.innerHTML = originalText;
        btn.disabled = false;
        // Fallback buka tab cetak langsung
        window.open('/daftar-presensi/<%= meeting_id %>/pdf', '_blank');
    });
}
</script>

</body>
</html>
