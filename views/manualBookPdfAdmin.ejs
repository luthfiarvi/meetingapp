    <script>
        function showToast(msg) {
            const toast = document.getElementById('toastNotification');
            const toastMsg = document.getElementById('toastMessage');
            if (!toast) return;
            toastMsg.textContent = msg;
            toast.style.display = 'flex';
            toast.style.opacity = '1';
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => { toast.style.display = 'none'; }, 300);
            }, 4000);
        }

        async function exportToWord(filename) {
            const btn = document.getElementById('btnWordExport');
            const originalContent = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span>⏳ Menyiapkan Dokumen Word...</span>';
            }

            try {
                // 1. Ambil data base64 logo BKN
                let logoBase64 = '';
                const logoImg = document.querySelector('img[src*="logo-bkn-asli.png"]');
                if (logoImg) {
                    try {
                        const canvas = document.createElement('canvas');
                        canvas.width = logoImg.naturalWidth || 120;
                        canvas.height = logoImg.naturalHeight || 120;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(logoImg, 0, 0);
                        const dataUrl = canvas.toDataURL('image/png');
                        logoBase64 = dataUrl.replace(/^data:image\/png;base64,/, '');
                    } catch (e) {
                        console.warn('Canvas toDataURL gagal, mencoba fetch langsung:', e);
                    }
                }

                if (!logoBase64) {
                    try {
                        const resp = await fetch('/logo-bkn-asli.png');
                        const blob = await resp.blob();
                        logoBase64 = await new Promise((resolve) => {
                            const reader = new FileReader();
                            reader.onloadend = () => {
                                const res = reader.result;
                                resolve(res.split(',')[1]);
                            };
                            reader.readAsDataURL(blob);
                        });
                    } catch (err) {
                        console.warn('Fetch logo gagal:', err);
                    }
                }

                // 2. Kloning semua lembar dokumen (.doc-sheet)
                const sheets = document.querySelectorAll('.doc-sheet');
