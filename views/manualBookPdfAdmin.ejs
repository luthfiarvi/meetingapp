    <!-- ==============================================================
         HALAMAN 1: COVER RESMI PEDOMAN ADMINISTRATOR
         ============================================================== -->
    <div class="doc-sheet">
        <div class="kop-surat">
            <img src="/logo-bkn-asli.png" alt="Logo BKN" class="kop-logo">
            <div class="kop-text">
                <h2>BADAN KEPEGAWAIAN NEGARA</h2>
                <h3>KANTOR REGIONAL V JAKARTA</h3>
                <p>Jl. Ciracas No. 36, Jakarta Timur • Telp: (021) 87721074 • Website: jakarta.bkn.go.id</p>
            </div>
        </div>

        <div class="cover-page">
            <span class="cover-badge">STANDAR OPERASIONAL PROSEDUR (SOP) RESMI</span>
