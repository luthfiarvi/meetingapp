                    const clone = sheet.cloneNode(true);
                    
                    // Arahkan src gambar logo ke identifier MHTML
                    const imgs = clone.querySelectorAll('img');
                    imgs.forEach(img => {
                        const src = img.getAttribute('src');
                        if (src && src.includes('logo-bkn-asli.png')) {
                            img.setAttribute('src', 'logo-bkn-asli.png');
                        }
                    });

                    sheetsHtml += '<div class="doc-sheet">' + clone.innerHTML + '</div>';
