<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Input Rapat - Meeting App BKN</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f1f5f9;
            min-height: 100vh;
            margin: 0;
            display: flex;
        }

        /* Sidebar Styling */
        .sidebar {
            width: 280px;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: #ffffff;
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            box-shadow: 4px 0 10px rgba(0, 0, 0, 0.05);
            z-index: 100;
        }

        .sidebar-brand {
            padding: 1.5rem;
            font-size: 1.25rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .sidebar-menu {
            padding: 1.5rem 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            flex-grow: 1;
        }

        .sidebar-menu a {
            color: #94a3b8;
            text-decoration: none;
            padding: 0.85rem 1rem;
            border-radius: 0.5rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            transition: all 0.2s ease-in-out;
        }

        .sidebar-menu a:hover,
        .sidebar-menu a.active {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.1);
        }

        .sidebar-menu a i {
            font-size: 1.1rem;
            width: 24px;
        }

        /* Main Content Area */
        .main-content {
            margin-left: 280px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        /* Top Navbar */
        .top-navbar {
            background: #ffffff;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #e2e8f0;
        }

        /* Content Wrapper */
        .content-body {
            padding: 2rem;
            flex-grow: 1;
        }

        .form-card {
            background: #ffffff;
            border: none;
            border-radius: 1rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            padding: 2rem;
        }

        .form-label {
            font-size: 0.875rem;
            font-weight: 600;
            color: #475569;
        }

        .input-group-text {
            background-color: #f8fafc;
            border-right: none;
            color: #64748b;
        }

        .form-control,
        .form-select {
            border-left: none;
            background-color: #f8fafc;
        }

        .form-control:focus,
        .form-select:focus {
            background-color: #ffffff;
            border-color: #2563eb;
            box-shadow: none;
        }

        .input-group:focus-within .input-group-text {
            border-color: #2563eb;
            color: #2563eb;
        }

        .btn-primary {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            border: none;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #1d4ed8, #1e40af);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }

        .btn-secondary {
            background-color: #e2e8f0;
            color: #475569;
            border: none;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
            border-radius: 0.5rem;
        }

        .btn-secondary:hover {
            background-color: #cbd5e1;
            color: #1e293b;
        }
    </style>
</head>

<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-brand">
            <i class="fa-solid fa-calendar-check text-primary"></i>
            <span>Meeting App BKN</span>
        </div>
        <div class="sidebar-menu">
            <a href="/dashboard"><i class="fa-solid fa-house"></i> Dashboard</a>
            <a href="/inputrapat" class="active"><i class="fa-solid fa-pen-to-square"></i> Input Rapat</a>
            <a href="/inputdokumenrapat"><i class="fa-solid fa-file-arrow-up"></i> Dokumen Rapat</a>
            <a href="/setuppresensi"><i class="fa-solid fa-clipboard-user"></i> Setup Presensi</a>
            <a href="/setupsertifikat"><i class="fa-solid fa-award"></i> Setup Sertifikat</a>
        </div>
        <div class="p-3 border-top border-secondary border-opacity-25">
            <a href="/logout"
                class="text-danger text-decoration-none d-flex align-items-center gap-2 px-3 py-2 fw-semibold">
                <i class="fa-solid fa-right-from-bracket"></i> Keluar
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navbar -->
        <div class="top-navbar">
            <h5 class="fw-bold text-dark m-0">Input Rapat Baru</h5>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small">Kantor Regional V BKN Jakarta</span>
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold"
                    style="width: 35px; height: 35px; font-size: 0.9rem;">
                    A
                </div>
            </div>
        </div>

        <!-- Content Body -->
        <div class="content-body">
            <div class="mb-4">
                <h4 class="fw-bold text-dark">Formulir Pendaftaran Agenda Rapat</h4>
                <p class="text-muted">Isi detail informasi rapat di bawah ini untuk membuat jadwal rapat baru.</p>
            </div>

            <!-- Form Card -->
            <div class="row">
                <div class="col-lg-8">
                    <div class="form-card">
                        <form action="/inputrapat" method="POST">

                            <!-- Nama Meeting -->
                            <div class="mb-3">
                                <label class="form-label">Nama Meeting <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-heading"></i></span>
                                    <input type="text" class="form-control" name="nama_meeting"
                                        placeholder="Contoh: Rapat Koordinasi Evaluasi Kinerja" required>
                                </div>
                            </div>

                            <!-- Tanggal Meeting -->
                            <div class="mb-3">
                                <label class="form-label">Tanggal Meeting <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-calendar-days"></i></span>
                                    <input type="date" class="form-control" name="tanggal_meeting" required>
                                </div>
                            </div>

                            <!-- Tipe Meeting Dropdown -->
                            <div class="mb-3">
                                <label class="form-label">Tipe Meeting <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-video"></i></span>
                                    <select class="form-select" name="tipe_meeting" required>
                                        <option value="" disabled selected>-- Pilih Tipe Meeting --</option>
                                        <option value="Rapat Offline">Rapat Offline</option>
                                        <option value="Zoom">Zoom</option>
                                        <option value="Webinar">Webinar</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Deskripsi -->
                            <div class="mb-4">
                                <label class="form-label">Deskripsi / Agenda Rapat</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-align-left"></i></span>
                                    <textarea class="form-control" name="deskripsi" rows="4"
                                        placeholder="Tuliskan catatan atau pembahasan singkat rapat..."></textarea>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="d-flex justify-content-end gap-2">
                                <a href="/dashboard" class="btn btn-secondary">
                                    <i class="fa-solid fa-xmark me-1"></i> Batal
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa-solid fa-floppy-disk me-1"></i> Simpan Rapat
                                </button>
                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>