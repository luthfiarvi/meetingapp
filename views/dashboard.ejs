<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard | Meeting App BKN</title>

    <link rel="stylesheet" href="/dashboard.css">
</head>

<body>

<div class="dashboard">

    <!-- ANIMASI EMBLEM BKN BACKGROUND (1 KANAN ATAS & 1 KIRI BAWAH) -->
    <div class="bubble bubble-top-right"></div>
    <div class="bubble bubble-bottom-left"></div>


    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="brand">

            <div class="brand-logo">
                <img src="/logo-bkn-asli.png" alt="Logo BKN">
            </div>

            <div>
                <h2>Meeting App</h2>
                <span>BKN Regional V</span>
            </div>

        </div>


        <nav class="menu">

            <a href="#" class="menu-item active">
                <span>⌂</span>
                <span>Dashboard</span>
            </a>

            <a href="#" class="menu-item">
                <span>▣</span>
                <span>Ruang Rapat</span>
            </a>

            <a href="#" class="menu-item">
                <span>▦</span>
                <span>Jadwal Rapat</span>
            </a>

            <a href="#" class="menu-item">
                <span>＋</span>
                <span>Pemesanan</span>
            </a>

            <a href="#" class="menu-item">
                <span>♙</span>
                <span>Pengguna</span>
            </a>

        </nav>


        <div class="sidebar-bottom">

            <div class="help-box">
                <span class="help-icon">?</span>

                <div>
                    <strong>Butuh bantuan?</strong>
                    <p>Hubungi administrator sistem.</p>
                </div>
            </div>

            <a href="/" class="logout" onclick="showLogoutModal(event)">
                <span>↪</span>
                Keluar
            </a>

        </div>

    </aside>


    <!-- MAIN CONTENT -->
    <main class="main-content">

        <!-- HEADER -->
        <header class="topbar">

            <div>
                <p class="breadcrumb">Dashboard</p>
                <h1>Selamat Datang 👋</h1>
                <p class="subtitle">
                    Kelola ruang dan jadwal rapat dengan mudah.
                </p>
            </div>


            <div class="profile">

                <div class="notification">
                    🔔
                    <span></span>
                </div>

                <div class="profile-info">
                    <strong>Administrator</strong>
                    <small>Pengguna Sistem</small>
                </div>

                <div class="avatar">
                    A
                </div>

            </div>

        </header>


        <!-- STATISTIK -->
        <section class="stats">

            <div class="stat-card">

                <div class="stat-icon blue">
                    ▣
                </div>

                <div>
                    <span>Total Ruangan</span>
                    <strong>8</strong>
                    <small>Ruang tersedia dalam sistem</small>
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon green">
                    ✓
                </div>

                <div>
                    <span>Ruangan Tersedia</span>
                    <strong>5</strong>
                    <small>Siap digunakan hari ini</small>
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon orange">
                    ◷
                </div>

                <div>
                    <span>Sedang Digunakan</span>
                    <strong>2</strong>
                    <small>Sedang berlangsung</small>
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon purple">
                    ▦
                </div>

                <div>
                    <span>Jadwal Hari Ini</span>
                    <strong>6</strong>
                    <small>Total agenda rapat</small>
                </div>

            </div>

        </section>


        <!-- CONTENT GRID -->
        <section class="content-grid">


            <!-- RUANG RAPAT -->
            <div class="panel rooms-panel">

                <div class="panel-header">

                    <div>
                        <h2>Ruang Rapat</h2>
                        <p>Status penggunaan ruangan hari ini</p>
                    </div>

                    <button class="view-button">
                        Lihat Semua →
                    </button>

                </div>


                <div class="room-list">

                    <div class="room">

                        <div class="room-icon">
                            R1
                        </div>

                        <div class="room-info">
                            <strong>Ruang Rapat Utama</strong>
                            <span>Lantai 1 • Kapasitas 20 orang</span>
                        </div>

                        <span class="status available">
                            Tersedia
                        </span>

                    </div>


                    <div class="room">

                        <div class="room-icon">
                            R2
                        </div>

                        <div class="room-info">
                            <strong>Ruang Rapat Garuda</strong>
                            <span>Lantai 2 • Kapasitas 15 orang</span>
                        </div>

                        <span class="status used">
                            Digunakan
                        </span>

                    </div>


                    <div class="room">

                        <div class="room-icon">
                            R3
                        </div>

                        <div class="room-info">
                            <strong>Ruang Rapat Nusantara</strong>
                            <span>Lantai 2 • Kapasitas 12 orang</span>
                        </div>

                        <span class="status available">
                            Tersedia
                        </span>

                    </div>


                    <div class="room">

                        <div class="room-icon">
                            R4
                        </div>

                        <div class="room-info">
                            <strong>Ruang Rapat Merah Putih</strong>
                            <span>Lantai 3 • Kapasitas 25 orang</span>
                        </div>

                        <span class="status booked">
                            Terjadwal
                        </span>

                    </div>

                </div>

            </div>


            <!-- JADWAL -->
            <div class="panel schedule-panel">

                <div class="panel-header">

                    <div>
                        <h2>Jadwal Hari Ini</h2>
                        <p>Agenda rapat yang sedang berjalan</p>
                    </div>

                </div>


                <div class="timeline">

                    <div class="schedule-item">

                        <div class="time">
                            <strong>09:00</strong>
                            <span>10:00</span>
                        </div>

                        <div class="timeline-line">
                            <span></span>
                        </div>

                        <div class="schedule-info">
                            <strong>Rapat Koordinasi</strong>
                            <span>Ruang Rapat Utama</span>
                        </div>

                    </div>


                    <div class="schedule-item active-schedule">

                        <div class="time">
                            <strong>10:30</strong>
                            <span>12:00</span>
                        </div>

                        <div class="timeline-line">
                            <span></span>
                        </div>

                        <div class="schedule-info">
                            <strong>Evaluasi Kinerja</strong>
                            <span>Ruang Rapat Garuda</span>
                        </div>

                    </div>


                    <div class="schedule-item">

                        <div class="time">
                            <strong>13:00</strong>
                            <span>14:00</span>
                        </div>

                        <div class="timeline-line">
                            <span></span>
                        </div>

                        <div class="schedule-info">
                            <strong>Diskusi Program Kerja</strong>
                            <span>Ruang Rapat Nusantara</span>
                        </div>

                    </div>


                    <div class="schedule-item">

                        <div class="time">
                            <strong>14:30</strong>
                            <span>16:00</span>
                        </div>

                        <div class="timeline-line">
                            <span></span>
                        </div>

                        <div class="schedule-info">
                            <strong>Rapat Internal</strong>
                            <span>Ruang Rapat Merah Putih</span>
                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- QUICK ACTION -->
        <section class="quick-action">

            <div>
                <span class="quick-label">AKSI CEPAT</span>

                <h2>Siap mengatur rapat?</h2>

                <p>
                    Buat pemesanan ruang rapat baru dengan cepat.
                </p>
            </div>

            <button>
                ＋ Pesan Ruang Rapat
            </button>

        </section>


        <footer>
            Meeting App • Kantor Regional V BKN Jakarta • 2026
        </footer>

    </main>

</div>

    <!-- MODAL KONFIRMASI LOGOUT -->
    <div id="logoutModal" class="logout-modal-overlay">
        <div class="logout-modal-card">
            <div class="logout-modal-icon">
                ⚠️
            </div>
            <h3>Konfirmasi Keluar</h3>
            <p>Apakah Anda yakin ingin keluar dari Sistem Informasi Manajemen Ruang Rapat (SIM-RAPAT BKN)?</p>
            <div class="logout-modal-actions">
                <button type="button" class="btn-logout-cancel" onclick="closeLogoutModal()">Batal</button>
                <a href="/" class="btn-logout-confirm">Ya, Keluar</a>
            </div>
        </div>
    </div>

    <script>
    function showLogoutModal(event) {
        if (event) event.preventDefault();
        document.getElementById("logoutModal").classList.add("show");
    }

    function closeLogoutModal() {
        document.getElementById("logoutModal").classList.remove("show");
    }

    window.addEventListener("click", function(event) {
        const modal = document.getElementById("logoutModal");
        if (event.target === modal) {
            closeLogoutModal();
        }
    });
    </script>
</body>
</html>
