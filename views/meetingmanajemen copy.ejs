<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Meeting | Meeting App BKN</title>
    <link rel="stylesheet" href="/dashboard.css">
</head>

<body>

    <div class="dashboard">

        <!-- ANIMASI EMBLEM BKN BACKGROUND (1 KANAN ATAS & 1 KIRI BAWAH) -->
        <div class="bubble bubble-top-right"></div>
        <div class="bubble bubble-bottom-left"></div>

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="brand">
                <div class="brand-logo">
                    <img src="/logo-bkn-asli.png" alt="Logo BKN">
                </div>
                <div>
                    <h2>Meeting App</h2>
                    <span>BKN Regional V</span>
                </div>
            </div>

            <nav class="menu">
                <a href="/dashboard" class="menu-item">
                    <span>🏠</span>
                    <span>Dashboard</span>
                </a>

                <a href="/manajemenmeeting" class="menu-item active">
                    <span>📋</span>
                    <span>Manajemen Meeting</span>
                </a>

                <a href="#" class="menu-item">
                    <span>📝</span>
                    <span>Manajemen Presensi</span>
                </a>

                <a href="#" class="menu-item">
                    <span>📜</span>
                    <span>Manajemen Sertifikat</span>
                </a>

                <a href="/" class="menu-item" onclick="showLogoutModal(event)">
                    <span>🚪</span>
                    <span>Manajemen Logout</span>
                </a>
            </nav>

            <div class="sidebar-bottom">
                <div class="help-box">
                    <span class="help-icon">?</span>
                    <div>
                        <strong>Butuh bantuan?</strong>
                        <p>Hubungi administrator sistem.</p>
                    </div>
                </div>

                <a href="/" class="logout" onclick="showLogoutModal(event)">
                    <span>↪</span>
                    Keluar
                </a>
            </div>

        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">

            <!-- MANAGEMENT TOP BAR -->
            <section class="management-top-bar">
                <div class="management-title-wrapper">
                    <div class="management-icon-badge">
                        📑
                    </div>
                    <div class="management-title-text">
                        <h1>Manajemen Meeting</h1>
                        <p>Halaman untuk menambah, edit dan kelola daftar meeting BKN</p>
                    </div>
                </div>

                <div class="management-actions">
                    <div class="search-box-wrapper">
                        <span class="search-icon">🔍</span>
                        <input type="text" id="searchMeeting" placeholder="Cari Meeting..." onkeyup="filterMeetings()">
                    </div>

                    <button type="button" class="btn-add-primary" onclick="openMeetingModal()">
                        ＋ Tambah Meeting
                    </button>
                </div>
            </section>

            <!-- CARDS GRID (3 KOLOM SAMPAI SELESAI) -->
            <section class="meeting-cards-grid" id="meetingGrid">

                <% if (typeof meetings !== 'undefined' && meetings && meetings.length > 0) { %>
                    <% meetings.forEach(function(m) { %>
                        <div class="meeting-card">
                            <div class="meeting-card-banner">
                                <img src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?q=80&w=600&auto=format&fit=crop" alt="Meeting BKN" onerror="this.onerror=null; this.src='/logo-bkn-asli.png'; this.style.objectFit='contain'; this.style.padding='20px'; this.style.background='linear-gradient(135deg, #0d2b5c, #2563eb)';">
                                <span class="meeting-card-badge"><%= m.m_tipe || 'Rapat Offline' %></span>
                            </div>
                            <div class="meeting-card-content">
                                <h3 class="meeting-card-title"><%= m.m_nama %></h3>
                                <p class="meeting-card-meta">📅 Tanggal: <%= m.tanggal || '21 Agustus 2026' %></p>
                                <p class="meeting-card-desc" style="display:none;"><%= m.deskripsi || 'Pembahasan agenda rutin BKN Regional V.' %></p>
                                <div class="meeting-card-actions">
                                    <button type="button" class="btn-card-view" onclick="openViewModal(this)">
                                        👁️ View
                                    </button>
                                    <button type="button" class="btn-card-edit" onclick="openEditModal(this)">
                                        ✏️ Edit
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } %>

                <!-- DATA KARTU MEETING -->

                <!-- KARTU 1 -->
                <div class="meeting-card">
                    <div class="meeting-card-banner">
                        <img src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?q=80&w=600&auto=format&fit=crop" alt="Sosialisasi Kenaikan Pangkat" onerror="this.onerror=null; this.src='/logo-bkn-asli.png'; this.style.objectFit='contain'; this.style.padding='20px'; this.style.background='linear-gradient(135deg, #0d2b5c, #2563eb)';">
                        <span class="meeting-card-badge">Rapat Offline</span>
                    </div>
                    <div class="meeting-card-content">
                        <h3 class="meeting-card-title">Kanreg V BKN Sosialisasikan Kenaikan Pangkat Otomatis, Layanan Makin Praktis</h3>
                        <p class="meeting-card-meta">📅 Tanggal: 21 Agustus 2026</p>
                        <p class="meeting-card-desc" style="display:none;">Pelaksanaan sosialisasi sistem peremajaan data dan kenaikan pangkat otomatis bagi seluruh pegawai ASN wilayah Kanreg V BKN.</p>
                        <div class="meeting-card-actions">
                            <button type="button" class="btn-card-view" onclick="openViewModal(this)">👁️ View</button>
                            <button type="button" class="btn-card-edit" onclick="openEditModal(this)">✏️ Edit</button>
                        </div>
                    </div>
                </div>

                <!-- KARTU 2 -->
                <div class="meeting-card">
                    <div class="meeting-card-banner">
                        <img src="https://images.unsplash.com/photo-1542744836-56758bfd3237?q=80&w=600&auto=format&fit=crop" alt="Peringatan HUT RI" onerror="this.onerror=null; this.src='/logo-bkn-asli.png'; this.style.objectFit='contain'; this.style.padding='20px'; this.style.background='linear-gradient(135deg, #0d2b5c, #2563eb)';">
                        <span class="meeting-card-badge">Rapat Offline</span>
                    </div>
                    <div class="meeting-card-content">
                        <h3 class="meeting-card-title">Peringatan HUT ke-81 RI di Kanreg V BKN, Perkuat Semangat Jaga Persatuan</h3>
                        <p class="meeting-card-meta">📅 Tanggal: 17 Agustus 2026</p>
                        <p class="meeting-card-desc" style="display:none;">Rapat pembentukan panitia serta koordinasi persiapan upacara dan perlombaan peringatan HUT ke-81 Republik Indonesia.</p>
                        <div class="meeting-card-actions">
                            <button type="button" class="btn-card-view" onclick="openViewModal(this)">👁️ View</button>
                            <button type="button" class="btn-card-edit" onclick="openEditModal(this)">✏️ Edit</button>
                        </div>
                    </div>
                </div>

                <!-- KARTU 3 -->
                <div class="meeting-card">
                    <div class="meeting-card-banner">
                        <img src="https://images.unsplash.com/photo-1577412647305-991150c7d163?q=80&w=600&auto=format&fit=crop" alt="Profiling ASN" onerror="this.onerror=null; this.src='/logo-bkn-asli.png'; this.style.objectFit='contain'; this.style.padding='20px'; this.style.background='linear-gradient(135deg, #0d2b5c, #2563eb)';">
                        <span class="meeting-card-badge">Zoom</span>
                    </div>
                    <div class="meeting-card-content">
                        <h3 class="meeting-card-title">Ukur Potensi hingga Preferensi Karir, Kanreg V BKN Fasilitasi Profiling ASN</h3>
                        <p class="meeting-card-meta">📅 Tanggal: 20 Agustus 2026</p>
                        <p class="meeting-card-desc" style="display:none;">Pelaksanaan kegiatan profiling kompetensi dan analisis preferensi karir ASN menggunakan platform penilaian online.</p>
                        <div class="meeting-card-actions">
                            <button type="button" class="btn-card-view" onclick="openViewModal(this)">👁️ View</button>
                            <button type="button" class="btn-card-edit" onclick="openEditModal(this)">✏️ Edit</button>
                        </div>
                    </div>
                </div>

                <!-- KARTU 4 -->
                <div class="meeting-card">
                    <div class="meeting-card-banner">
                        <img src="https://images.unsplash.com/photo-1531497865144-0464ef8fb9a9?q=80&w=600&auto=format&fit=crop" alt="Forum SIGAP Pensiun" onerror="this.onerror=null; this.src='/logo-bkn-asli.png'; this.style.objectFit='contain'; this.style.padding='20px'; this.style.background='linear-gradient(135deg, #0d2b5c, #2563eb)';">
                        <span class="meeting-card-badge">Rapat Offline</span>
                    </div>
                    <div class="meeting-card-content">
                        <h3 class="meeting-card-title">Forum Kanreg V SIGAP, Matangkan Kesiapan Implementasi Pensiun Otomatis bagi ASN</h3>
                        <p class="meeting-card-meta">📅 Tanggal: 20 Agustus 2026</p>
                        <p class="meeting-card-desc" style="display:none;">Pertemuan koordinasi tim SIGAP untuk memastikan validitas data pensiun otomatis ASN terintegrasi secara cepat.</p>
                        <div class="meeting-card-actions">
                            <button type="button" class="btn-card-view" onclick="openViewModal(this)">👁️ View</button>
                            <button type="button" class="btn-card-edit" onclick="openEditModal(this)">✏️ Edit</button>
                        </div>
                    </div>
                </div>

                <!-- KARTU 5 -->
                <div class="meeting-card">
                    <div class="meeting-card-banner">
                        <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=600&auto=format&fit=crop" alt="Etika Disiplin ASN" onerror="this.onerror=null; this.src='/logo-bkn-asli.png'; this.style.objectFit='contain'; this.style.padding='20px'; this.style.background='linear-gradient(135deg, #0d2b5c, #2563eb)';">
                        <span class="meeting-card-badge">Webinar</span>
                    </div>
                    <div class="meeting-card-content">
                        <h3 class="meeting-card-title">Kanreg V BKN Dorong Etika, Integritas dan Disiplin sebagai Fondasi ASN BerAKHLAK</h3>
                        <p class="meeting-card-meta">📅 Tanggal: 19 Agustus 2026</p>
                        <p class="meeting-card-desc" style="display:none;">Webinar sosialisasi nilai-nilai dasar ASN BerAKHLAK guna meningkatkan integritas dan kedisiplinan kerja aparatur.</p>
                        <div class="meeting-card-actions">
                            <button type="button" class="btn-card-view" onclick="openViewModal(this)">👁️ View</button>
                            <button type="button" class="btn-card-edit" onclick="openEditModal(this)">✏️ Edit</button>
                        </div>
                    </div>
                </div>

                <!-- KARTU 6 -->
                <div class="meeting-card">
                    <div class="meeting-card-banner">
                        <img src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?q=80&w=600&auto=format&fit=crop" alt="Vaksinasi KORPRI" onerror="this.onerror=null; this.src='/logo-bkn-asli.png'; this.style.objectFit='contain'; this.style.padding='20px'; this.style.background='linear-gradient(135deg, #0d2b5c, #2563eb)';">
                        <span class="meeting-card-badge">Rapat Offline</span>
                    </div>
                    <div class="meeting-card-content">
                        <h3 class="meeting-card-title">Perluas Akses Perlindungan Kesehatan, Kanreg V BKN dan KORPRI Gelar Vaksinasi</h3>
                        <p class="meeting-card-meta">📅 Tanggal: 13 Agustus 2026</p>
                        <p class="meeting-card-desc" style="display:none;">Rapat persiapan serta pelaksanaan vaksinasi kesehatan bagi keluarga besar pegawai Kanreg V BKN.</p>
                        <div class="meeting-card-actions">
                            <button type="button" class="btn-card-view" onclick="openViewModal(this)">👁️ View</button>
                            <button type="button" class="btn-card-edit" onclick="openEditModal(this)">✏️ Edit</button>
                        </div>
                    </div>
                </div>

                <!-- KARTU 7 -->
                <div class="meeting-card">
                    <div class="meeting-card-banner">
                        <img src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?q=80&w=600&auto=format&fit=crop" alt="Manajemen Talenta" onerror="this.onerror=null; this.src='/logo-bkn-asli.png'; this.style.objectFit='contain'; this.style.padding='20px'; this.style.background='linear-gradient(135deg, #0d2b5c, #2563eb)';">
                        <span class="meeting-card-badge">Zoom</span>
                    </div>
                    <div class="meeting-card-content">
                        <h3 class="meeting-card-title">Percepat Implementasi Manajemen Talenta, Kanreg V BKN Awali Pelaksanaan Profiling</h3>
                        <p class="meeting-card-meta">📅 Tanggal: 5 Agustus 2026</p>
                        <p class="meeting-card-desc" style="display:none;">Pertemuan virtual membahas pemetaan talent pool ASN serta akselerasi pola karir berbasis kualifikasi.</p>
                        <div class="meeting-card-actions">
                            <button type="button" class="btn-card-view" onclick="openViewModal(this)">👁️ View</button>
                            <button type="button" class="btn-card-edit" onclick="openEditModal(this)">✏️ Edit</button>
                        </div>
                    </div>
                </div>

                <!-- KARTU 8 -->
                <div class="meeting-card">
                    <div class="meeting-card-banner">
                        <img src="https://images.unsplash.com/photo-1515187029135-18ee286d815b?q=80&w=600&auto=format&fit=crop" alt="Forum Konsultasi" onerror="this.onerror=null; this.src='/logo-bkn-asli.png'; this.style.objectFit='contain'; this.style.padding='20px'; this.style.background='linear-gradient(135deg, #0d2b5c, #2563eb)';">
                        <span class="meeting-card-badge">Rapat Offline</span>
                    </div>
                    <div class="meeting-card-content">
                        <h3 class="meeting-card-title">Kanreg V BKN Gelar Forum Konsultasi Publik, Perkuat Kolaborasi Standar Pelayanan</h3>
                        <p class="meeting-card-meta">📅 Tanggal: 5 Agustus 2026</p>
                        <p class="meeting-card-desc" style="display:none;">Forum konsultasi publik yang melibatkan stakeholder eksternal dalam penyempurnaan maklumat pelayanan publik.</p>
                        <div class="meeting-card-actions">
                            <button type="button" class="btn-card-view" onclick="openViewModal(this)">👁️ View</button>
                            <button type="button" class="btn-card-edit" onclick="openEditModal(this)">✏️ Edit</button>
                        </div>
                    </div>
                </div>

                <!-- KARTU 9 -->
                <div class="meeting-card">
                    <div class="meeting-card-banner">
                        <img src="https://images.unsplash.com/photo-1560439514-4e9645039924?q=80&w=600&auto=format&fit=crop" alt="AKSARA Vol 4" onerror="this.onerror=null; this.src='/logo-bkn-asli.png'; this.style.objectFit='contain'; this.style.padding='20px'; this.style.background='linear-gradient(135deg, #0d2b5c, #2563eb)';">
                        <span class="meeting-card-badge">Webinar</span>
                    </div>
                    <div class="meeting-card-content">
                        <h3 class="meeting-card-title">Kupas Tuntas Jabatan Fungsional, AKSARA Vol. 4 Bahas Penilaian Angka Kredit</h3>
                        <p class="meeting-card-meta">📅 Tanggal: 16 Juli 2026</p>
                        <p class="meeting-card-desc" style="display:none;">Acara rutin seri AKSARA Vol. 4 membedah juknis dan mekanisme angka kredit jabatan fungsional kepegawaian.</p>
