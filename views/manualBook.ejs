        let activeVideoIdx = 0;
        let isPlaying = false;
        let simCurrentStep = 0;
        let simTimer = null;
        let simSecondsElapsed = 0;
        let isLocalMp4Mode = false;

        function updateVideoUI() {
            const mod = VIDEO_MODULES[activeVideoIdx];
            document.getElementById('videoTopTitle').innerText = mod.title;
            document.getElementById('coverTitle').innerText = mod.title;
            document.getElementById('coverDesc').innerText = mod.desc;
            document.getElementById('coverDuration').innerText = mod.durationText;
            document.getElementById('videoTimeText').innerText = `00:00 / ${mod.durationText}`;
            document.getElementById('progressBarFill').style.width = '0%';

            // Render Quick Steps list
            const stepsListEl = document.getElementById('quickStepsList');
            stepsListEl.innerHTML = mod.quickSteps.map(step => `
                <div style="background: #ffffff; border: 1px solid #e2e8f0; padding: 0.45rem 0.65rem; border-radius: 8px; display: flex; align-items: center; gap: 0.4rem;">
                    <span style="color: #10b981; font-weight: 800;">✓</span>
                    <span style="font-weight: 600;">${step}</span>
                </div>
            `).join('');

            // Render Step 0
            renderSimulationStep(0);
        }

        function renderSimulationStep(stepIdx) {
            const mod = VIDEO_MODULES[activeVideoIdx];
            const step = mod.steps[stepIdx];
            if (!step) return;

            // Update Mock Browser URL
            document.getElementById('mockBrowserUrl').innerText = mod.url;

            // Render Real UI HTML into Viewport
            const viewport = document.getElementById('realWebUiViewport');
            if (viewport && typeof step.renderUI === 'function') {
                viewport.innerHTML = step.renderUI();
            }

            // Update Animated Cursor Position
            const cursor = document.getElementById('simAnimatedCursor');
            if (cursor && step.cursorPos) {
                cursor.style.left = step.cursorPos.x;
                cursor.style.top = step.cursorPos.y;
            }

            // Update Subtitle Bar
            document.getElementById('simStepBadge').innerText = `Langkah ${stepIdx + 1}/${mod.steps.length}`;
            document.getElementById('simStepTitle').innerText = step.title;
            document.getElementById('simStepAction').innerText = step.action;
        }

        function selectVideo(index) {
            pauseVideo();
            activeVideoIdx = index;
            isLocalMp4Mode = false;

            // Reset video tag
            const html5Video = document.getElementById('realHtml5Video');
            html5Video.pause();
            html5Video.style.display = 'none';
            document.getElementById('simulatedScreen').style.display = 'flex';
            document.getElementById('videoCover').style.display = 'flex';
            document.getElementById('videoCover').style.opacity = '1';
            document.getElementById('videoModeBadge').innerText = '⚡ Simulasi BKN';

            // Update playlist active card
            const cards = document.querySelectorAll('.playlist-card');
            cards.forEach((c, idx) => {
                if (idx === index) {
                    c.classList.add('active');
                } else {
                    c.classList.remove('active');
                }
            });

            simSecondsElapsed = 0;
            simCurrentStep = 0;
            updateVideoUI();
        }

        function startVideoPlay() {
            document.getElementById('videoCover').style.opacity = '0';
            setTimeout(() => {
                document.getElementById('videoCover').style.display = 'none';
            }, 300);
            playVideo();
        }

        function playVideo() {
            if (isLocalMp4Mode) {
                const vid = document.getElementById('realHtml5Video');
                vid.play();
                isPlaying = true;
                document.getElementById('btnPlayPause').innerText = '⏸';
                return;
            }

            isPlaying = true;
            document.getElementById('btnPlayPause').innerText = '⏸';

            const mod = VIDEO_MODULES[activeVideoIdx];
            const stepDuration = Math.floor(mod.durationSec / mod.steps.length);

            clearInterval(simTimer);
            simTimer = setInterval(() => {
                simSecondsElapsed++;

                // Hitung step sekarang
                const nextStep = Math.min(Math.floor(simSecondsElapsed / stepDuration), mod.steps.length - 1);
                if (nextStep !== simCurrentStep) {
                    simCurrentStep = nextStep;
                    renderSimulationStep(simCurrentStep);
                }

                // Update progress bar
                const percent = Math.min((simSecondsElapsed / mod.durationSec) * 100, 100);
                document.getElementById('progressBarFill').style.width = percent + '%';

                // Update time text
                const m = Math.floor(simSecondsElapsed / 60);
                const s = simSecondsElapsed % 60;
                const curTimeStr = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
                document.getElementById('videoTimeText').innerText = `${curTimeStr} / ${mod.durationText}`;

                // Selesai
                if (simSecondsElapsed >= mod.durationSec) {
                    pauseVideo();
                    simSecondsElapsed = 0;
                    simCurrentStep = 0;
                    document.getElementById('videoCover').style.display = 'flex';
                    document.getElementById('videoCover').style.opacity = '1';
                }
            }, 1000);
        }

        function pauseVideo() {
            isPlaying = false;
            document.getElementById('btnPlayPause').innerText = '▶';
            clearInterval(simTimer);

            if (isLocalMp4Mode) {
                const vid = document.getElementById('realHtml5Video');
                vid.pause();
            }
        }

        function togglePlayPause() {
            if (document.getElementById('videoCover').style.display !== 'none') {
                startVideoPlay();
                return;
            }

            if (isPlaying) {
                pauseVideo();
            } else {
                playVideo();
            }
        }

        function restartVideo() {
            pauseVideo();
            simSecondsElapsed = 0;
            simCurrentStep = 0;
            document.getElementById('progressBarFill').style.width = '0%';
            renderSimulationStep(0);
            const mod = VIDEO_MODULES[activeVideoIdx];
            document.getElementById('videoTimeText').innerText = `00:00 / ${mod.durationText}`;

            if (isLocalMp4Mode) {
                const vid = document.getElementById('realHtml5Video');
                vid.currentTime = 0;
            }

            playVideo();
        }

        function seekVideo(e) {
            const rect = e.currentTarget.getBoundingClientRect();
            const pos = (e.clientX - rect.left) / rect.width;
            const mod = VIDEO_MODULES[activeVideoIdx];

            if (isLocalMp4Mode) {
                const vid = document.getElementById('realHtml5Video');
                if (vid.duration) {
                    vid.currentTime = pos * vid.duration;
                }
                return;
            }

            simSecondsElapsed = Math.floor(pos * mod.durationSec);
            const stepDuration = Math.floor(mod.durationSec / mod.steps.length);
            simCurrentStep = Math.min(Math.floor(simSecondsElapsed / stepDuration), mod.steps.length - 1);
            renderSimulationStep(simCurrentStep);

            const percent = Math.min((simSecondsElapsed / mod.durationSec) * 100, 100);
            document.getElementById('progressBarFill').style.width = percent + '%';
        }

        function triggerFileInput() {
            document.getElementById('localVideoUploader').click();
        }

        function handleLocalVideo(e) {
            const file = e.target.files[0];
            if (!file) return;

            pauseVideo();
            isLocalMp4Mode = true;

            const fileUrl = URL.createObjectURL(file);
            const vid = document.getElementById('realHtml5Video');
            vid.src = fileUrl;
            vid.style.display = 'block';

            document.getElementById('simulatedScreen').style.display = 'none';
            document.getElementById('videoCover').style.display = 'none';
            document.getElementById('videoModeBadge').innerText = '📹 MP4 File';
            document.getElementById('videoTopTitle').innerText = 'File Lokal: ' + file.name;

            vid.play();
            isPlaying = true;
            document.getElementById('btnPlayPause').innerText = '⏸';

            vid.ontimeupdate = () => {
                if (vid.duration) {
                    const percent = (vid.currentTime / vid.duration) * 100;
                    document.getElementById('progressBarFill').style.width = percent + '%';
                    const curM = Math.floor(vid.currentTime / 60);
                    const curS = Math.floor(vid.currentTime % 60);
                    const durM = Math.floor(vid.duration / 60);
                    const durS = Math.floor(vid.duration % 60);
                    document.getElementById('videoTimeText').innerText = 
                        `${String(curM).padStart(2, '0')}:${String(curS).padStart(2, '0')} / ${String(durM).padStart(2, '0')}:${String(durS).padStart(2, '0')}`;
                }
            };
        }

        // Inisialisasi saat halaman dimuat
        document.addEventListener('DOMContentLoaded', () => {
            updateVideoUI();
        });

        function showLogoutModal(e) {
            e.preventDefault();
            if (confirm("Apakah Anda yakin ingin keluar dari sistem Meeting App?")) {
                window.location.href = "/logout";
            }
        }

        function openUploadPdfModal() {
            const modal = document.getElementById('uploadPdfModal');
            if (modal) modal.style.display = 'flex';
        }

        function closeUploadPdfModal() {
            const modal = document.getElementById('uploadPdfModal');
            if (modal) modal.style.display = 'none';
        }
    </script>

    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
    <!-- MODAL GANTI FILE PDF SENDIRI (KHUSUS ADMIN) -->
    <div id="uploadPdfModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 1.5rem; overflow-y: auto;">
        <div style="background: #ffffff; width: 100%; max-width: 680px; border-radius: 20px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); border: 1px solid #e2e8f0; overflow: hidden;">
            
            <!-- Modal Header -->
            <div style="background: linear-gradient(135deg, #0d2b5c 0%, #1d4ed8 100%); color: #ffffff; padding: 1.25rem 1.75rem; display: flex; align-items: center; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <span style="font-size: 1.4rem;">📑</span>
                    <div>
                        <h3 style="margin: 0; font-size: 1.1rem; font-weight: 800;">Kelola File PDF Manual Book Sendiri</h3>
                        <small style="color: #bfdbfe; font-size: 0.75rem;">Gunakan berkas file PDF (.pdf) resmi milik Anda untuk tombol panduan</small>
                    </div>
                </div>
                <button type="button" onclick="closeUploadPdfModal()" style="background: rgba(255,255,255,0.15); border: none; color: #ffffff; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; font-size: 1.2rem; display: flex; align-items: center; justify-content: center; transition: background 0.2s;">&times;</button>
            </div>

            <!-- Modal Body -->
            <div style="padding: 1.5rem 1.75rem; display: flex; flex-direction: column; gap: 1.25rem;">

                <!-- Section 1: PDF User -->
                <div style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 14px; padding: 1.25rem;">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
                        <strong style="font-size: 0.92rem; color: #1e293b; display: flex; align-items: center; gap: 0.4rem;">
                            <span>📘</span> 1. File PDF Manual Book Pegawai (User)
                        </strong>
                        <% if (typeof hasCustomUserPdf !== 'undefined' && hasCustomUserPdf) { %>
                            <span style="background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; font-size: 0.72rem; font-weight: 800; padding: 0.2rem 0.6rem; border-radius: 9999px;">✓ PDF Custom Aktif</span>
                        <% } else { %>
                            <span style="background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; font-size: 0.72rem; font-weight: 800; padding: 0.2rem 0.6rem; border-radius: 9999px;">Template Standar</span>
                        <% } %>
                    </div>
                    <p style="font-size: 0.8rem; color: #64748b; margin: 0 0 0.85rem; line-height: 1.45;">
                        File ini akan dibuka saat pegawai mengeklik tombol <strong>Cetak / Unduh PDF User</strong>.
                    </p>
                    <form action="/manual-book/upload-pdf" method="POST" enctype="multipart/form-data" style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
                        <input type="hidden" name="type" value="user">
                        <input type="file" name="pdf_file" accept=".pdf" required style="font-size: 0.8rem; color: #475569; flex: 1; min-width: 220px; padding: 0.4rem 0.6rem; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px;">
                        <button type="submit" style="background: #2563eb; color: #ffffff; border: none; font-weight: 700; font-size: 0.82rem; padding: 0.55rem 1.1rem; border-radius: 8px; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem; transition: background 0.2s;">
                            <span>⬆️</span> Unggah PDF User
                        </button>
                    </form>
                </div>

                <!-- Section 2: PDF Admin -->
                <div style="background: #fffafa; border: 1.5px solid #fee2e2; border-radius: 14px; padding: 1.25rem;">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
                        <strong style="font-size: 0.92rem; color: #1e293b; display: flex; align-items: center; gap: 0.4rem;">
                            <span>📕</span> 2. File PDF Pedoman Administrator (Admin)
                        </strong>
                        <% if (typeof hasCustomAdminPdf !== 'undefined' && hasCustomAdminPdf) { %>
                            <span style="background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; font-size: 0.72rem; font-weight: 800; padding: 0.2rem 0.6rem; border-radius: 9999px;">✓ PDF Custom Aktif</span>
                        <% } else { %>
                            <span style="background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; font-size: 0.72rem; font-weight: 800; padding: 0.2rem 0.6rem; border-radius: 9999px;">Template Standar</span>
                        <% } %>
                    </div>
                    <p style="font-size: 0.8rem; color: #64748b; margin: 0 0 0.85rem; line-height: 1.45;">
                        File ini akan dibuka saat admin mengeklik tombol <strong>Cetak / Unduh PDF Admin</strong>.
                    </p>
                    <form action="/manual-book/upload-pdf" method="POST" enctype="multipart/form-data" style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
                        <input type="hidden" name="type" value="admin">
                        <input type="file" name="pdf_file" accept=".pdf" required style="font-size: 0.8rem; color: #475569; flex: 1; min-width: 220px; padding: 0.4rem 0.6rem; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px;">
                        <button type="submit" style="background: #dc2626; color: #ffffff; border: none; font-weight: 700; font-size: 0.82rem; padding: 0.55rem 1.1rem; border-radius: 8px; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem; transition: background 0.2s;">
                            <span>⬆️</span> Unggah PDF Admin
                        </button>
                    </form>
                </div>

                <!-- Info Box -->
                <div style="background: #eff6ff; border-left: 4px solid #3b82f6; border-radius: 10px; padding: 0.85rem 1rem; font-size: 0.78rem; color: #1e40af; line-height: 1.5;">
                    💡 <strong>Tips Alternatif:</strong> Anda juga dapat langsung menempelkan file PDF Anda secara manual ke folder proyek:<br>
                    • User: <code>public/docs/manual-book-user.pdf</code><br>
                    • Admin: <code>public/docs/manual-book-admin.pdf</code>
                </div>

            </div>

            <!-- Modal Footer -->
            <div style="background: #f8fafc; border-top: 1px solid #e2e8f0; padding: 0.9rem 1.75rem; display: flex; justify-content: flex-end;">
                <button type="button" onclick="closeUploadPdfModal()" style="background: #64748b; color: #ffffff; border: none; font-weight: 700; font-size: 0.82rem; padding: 0.55rem 1.25rem; border-radius: 8px; cursor: pointer;">
                    Tutup
                </button>
            </div>

        </div>
    </div>
    <% } %>

    <script src="/js/sidebar.js"></script>
</body>

</html>
