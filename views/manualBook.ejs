                    { title: "Klik Buat Rapat Baru", desc: "Tentukan nama kegiatan, waktu, pimpinan rapat, dan pilih ruang rapat fisik kantor.", action: '👉 Pilih Ruang Rapat & Tanggal' },
                    { title: "Bagikan Tautan ke Peserta", desc: "Salin link rapat atau tampilkan QR Code presensi di layar proyektor ruang rapat.", action: '👉 Klik tombol "Salin Tautan Presensi"' },
                    { title: "Monitor Daftar Kehadiran", desc: "Klik tombol '📝 Lihat Presensi' untuk memantau peserta yang sudah mengisi absensi secara real-time.", action: '👉 Rekap kehadiran otomatis terbarui' }
                ],
                quickSteps: [
