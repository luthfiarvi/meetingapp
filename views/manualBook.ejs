<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manual Book & Panduan Pengguna | Meeting App BKN</title>
    <link rel="stylesheet" href="/dashboard.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        .manual-container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 1.5rem 2rem 4rem;
        }

        /* Top Banner Hero */
        .manual-hero-card {
            background: linear-gradient(135deg, #0d2b5c 0%, #174f99 60%, #2563eb 100%);
            border-radius: 20px;
            padding: 2.2rem 2.5rem;
            color: #ffffff;
            box-shadow: 0 15px 35px rgba(13, 43, 92, 0.18);
            position: relative;
            overflow: hidden;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 2rem;
        }

        .manual-hero-card::after {
            content: "";
            position: absolute;
            right: -30px;
            bottom: -40px;
            width: 260px;
            height: 260px;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.12) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .hero-left h1 {
            font-size: 1.85rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .hero-left p {
            color: #bfdbfe;
            font-size: 0.95rem;
            line-height: 1.5;
            max-width: 620px;
        }

        .hero-actions {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            flex-shrink: 0;
            z-index: 2;
        }

        .btn-print-doc {
            background: #ffffff;
            color: #102f63;
            border: none;
            padding: 0.75rem 1.4rem;
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
            transition: all 0.2s;
        }

        .btn-print-doc:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.22);
            background: #f8fafc;
        }

        /* Quick Search & Nav Tabs */
        .manual-nav-bar {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 0.75rem 1rem;
            box-shadow: 0 4px 16px rgba(13, 43, 92, 0.04);
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-wrap: wrap;
            position: sticky;
            top: 20px;
            z-index: 90;
            backdrop-filter: blur(8px);
        }

        .search-manual-wrap {
            position: relative;
            flex: 1;
            min-width: 220px;
        }

        .search-manual-wrap input {
            width: 100%;
            padding: 0.6rem 1rem 0.6rem 2.4rem;
            border: 1.5px solid #cbd5e1;
            border-radius: 10px;
            font-size: 0.85rem;
            outline: none;
            transition: border-color 0.2s;
        }

        .search-manual-wrap input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        .search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 0.9rem;
        }

        .nav-pills {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            overflow-x: auto;
        }

        .nav-pill-btn {
            background: #f1f5f9;
            color: #475569;
            border: 1px solid #e2e8f0;
            padding: 0.5rem 0.9rem;
            border-radius: 9px;
            font-size: 0.78rem;
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap;
            transition: all 0.2s;
            cursor: pointer;
        }

        .nav-pill-btn:hover {
            background: #eff6ff;
            color: #2563eb;
            border-color: #bfdbfe;
        }

        /* Module Section Cards */
        .manual-section {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            padding: 2rem 2.2rem;
            margin-bottom: 2rem;
            box-shadow: 0 6px 20px rgba(13, 43, 92, 0.05);
            scroll-margin-top: 90px;
            position: relative;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 2px solid #f1f5f9;
            padding-bottom: 1rem;
            margin-bottom: 1.5rem;
            gap: 1rem;
        }

        .section-title-wrap {
            display: flex;
            align-items: center;
            gap: 0.85rem;
        }

        .section-icon-badge {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: linear-gradient(135deg, #eff6ff, #dbeafe);
            color: #1d4ed8;
            font-size: 1.35rem;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 4px 10px rgba(37, 99, 235, 0.12);
        }

        .section-title-wrap h2 {
            font-size: 1.3rem;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.015em;
        }

        .section-title-wrap span {
            font-size: 0.8rem;
            color: #64748b;
            font-weight: 500;
            display: block;
            margin-top: 2px;
        }

        .role-badge {
            font-size: 0.72rem;
            font-weight: 800;
            padding: 0.3rem 0.75rem;
            border-radius: 9999px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .role-all {
            background: #f0fdf4;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        .role-admin {
            background: #fef2f2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        /* Step by Step Grid */
        .step-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.25rem;
            margin-bottom: 1.5rem;
        }

        .step-card {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 1.25rem 1.4rem;
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
            transition: all 0.2s;
        }

        .step-card:hover {
            background: #ffffff;
            border-color: #cbd5e1;
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
            transform: translateY(-2px);
        }

        .step-num-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.72rem;
            font-weight: 800;
            color: #2563eb;
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            padding: 0.2rem 0.6rem;
            border-radius: 9999px;
            width: fit-content;
        }

        .step-card h3 {
            font-size: 0.95rem;
            font-weight: 800;
            color: #1e293b;
            line-height: 1.35;
        }

        .step-card p {
            font-size: 0.835rem;
            color: #475569;
            line-height: 1.55;
        }

        .feature-callout {
            background: #eff6ff;
            border-left: 4.5px solid #2563eb;
            border-radius: 12px;
            padding: 1rem 1.25rem;
            margin-top: 1rem;
            font-size: 0.85rem;
            color: #1e40af;
            line-height: 1.55;
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
        }

        .feature-callout.warning {
            background: #fffbeb;
            border-left-color: #f59e0b;
            color: #92400e;
        }

        .feature-callout.success {
            background: #f0fdf4;
            border-left-color: #10b981;
            color: #065f46;
        }

        .callout-icon {
            font-size: 1.25rem;
            line-height: 1;
            flex-shrink: 0;
            margin-top: 2px;
        }

        /* Workflow diagram box */
        .workflow-box {
            background: #f8fafc;
            border: 1.5px dashed #cbd5e1;
            border-radius: 14px;
            padding: 1.25rem;
            margin-top: 1.25rem;
        }

        .workflow-steps {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .flow-step-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 0.4rem;
            flex: 1;
            min-width: 140px;
        }

        .flow-step-icon {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: #ffffff;
            border: 2px solid #2563eb;
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            font-weight: 800;
            box-shadow: 0 3px 8px rgba(37, 99, 235, 0.15);
        }

        .flow-step-title {
            font-size: 0.82rem;
            font-weight: 800;
            color: #1e293b;
        }

        .flow-step-desc {
            font-size: 0.72rem;
            color: #64748b;
            line-height: 1.35;
        }

        .flow-arrow {
            color: #94a3b8;
            font-size: 1.3rem;
            font-weight: 800;
        }

        /* FAQ Accordion items */
        .faq-item {
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            margin-bottom: 0.75rem;
            overflow: hidden;
            background: #ffffff;
        }

        .faq-question {
            padding: 1rem 1.25rem;
            font-size: 0.9rem;
            font-weight: 800;
            color: #1e293b;
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            user-select: none;
            background: #f8fafc;
            transition: background 0.2s;
        }

        .faq-question:hover {
            background: #eff6ff;
            color: #2563eb;
        }

        .faq-answer {
            padding: 1rem 1.25rem;
            font-size: 0.85rem;
            color: #475569;
            line-height: 1.6;
            border-top: 1px solid #e2e8f0;
            display: none;
            background: #ffffff;
        }

        .faq-item.open .faq-answer {
            display: block;
        }

        .faq-item.open .faq-question {
            background: #eff6ff;
            color: #2563eb;
        }

        /* Print formatting */
        @media print {
            .sidebar, .manual-nav-bar, .hero-actions, .topbar-right-only {
                display: none !important;
            }
            .dashboard {
                display: block !important;
            }
            .main-content {
                margin-left: 0 !important;
                padding: 0 !important;
            }
            .manual-container {
                max-width: 100% !important;
                padding: 0 !important;
            }
            .manual-section {
                box-shadow: none !important;
                border: 1px solid #000 !important;
                page-break-inside: avoid;
            }
            .manual-hero-card {
                background: #0d2b5c !important;
                color: #fff !important;
                -webkit-print-color-adjust: exact;
            }
        }

        @media (max-width: 768px) {
            .manual-hero-card {
                flex-direction: column;
                align-items: stretch;
                padding: 1.5rem;
            }
            .manual-container {
                padding: 1rem;
            }
            .step-grid {
                grid-template-columns: 1fr;
            }
            .flow-arrow {
                display: none;
            }
        }

        /* ==============================================================
           VIDEO TUTORIAL HUB & INTERACTIVE PLAYER
           ============================================================== */
        .video-hub-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            padding: 2rem;
            margin-bottom: 2.5rem;
            box-shadow: 0 10px 30px rgba(13, 43, 92, 0.07);
            position: relative;
            scroll-margin-top: 90px;
        }

        .video-hub-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            border-bottom: 2px solid #f1f5f9;
            padding-bottom: 1.25rem;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
        }

        .video-hub-grid {
            display: grid;
            grid-template-columns: 1.55fr 1fr;
            gap: 1.5rem;
        }

        @media (max-width: 960px) {
            .video-hub-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Player Box */
        .video-player-frame {
            background: #0b1329;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 12px 36px rgba(11, 19, 41, 0.28);
            border: 1px solid #1e293b;
            display: flex;
            flex-direction: column;
        }

        .video-topbar {
            background: #111c38;
            padding: 0.65rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #1e2e4a;
        }

        .window-dots {
            display: flex;
            gap: 6px;
        }

        .window-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .dot-red { background: #ef4444; }
        .dot-yellow { background: #f59e0b; }
        .dot-green { background: #10b981; }

        .video-stage {
            position: relative;
            background: #0b1329;
            min-height: 440px;
            height: 440px;
            display: flex;
            align-items: stretch;
            justify-content: stretch;
            overflow: hidden;
        }

        /* Real UI Simulation Styles */
        .sim-ui-canvas {
            flex: 1;
            background: #f1f5f9;
            overflow-y: auto;
            position: relative;
            padding: 0.85rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .sim-mock-header {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 0.5rem 0.85rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
        }

        .sim-mock-card {
            background: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 12px;
            padding: 0.9rem 1.1rem;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
            position: relative;
        }

        .sim-focus-box {
            outline: 2.5px solid #2563eb !important;
            outline-offset: 2px !important;
            box-shadow: 0 0 0 5px rgba(37, 99, 235, 0.25), 0 6px 16px rgba(37, 99, 235, 0.3) !important;
            animation: simPulseGlow 1.8s infinite alternate !important;
        }

        @keyframes simPulseGlow {
            0% { outline-color: #2563eb; box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2); }
            100% { outline-color: #3b82f6; box-shadow: 0 0 0 7px rgba(59, 130, 246, 0.45); }
        }

        .sim-animated-cursor {
            position: absolute;
            z-index: 50;
            font-size: 1.5rem;
            pointer-events: none;
            transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
            filter: drop-shadow(0 4px 8px rgba(0,0,0,0.4));
            transform: translate(-30%, -30%);
            animation: simCursorFloat 1.6s ease-in-out infinite;
        }

        @keyframes simCursorFloat {
            0%, 100% { transform: translate(-30%, -30%); }
            50% { transform: translate(-30%, -42%); }
        }

        .play-btn-circle {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            cursor: pointer;
            box-shadow: 0 0 0 10px rgba(37, 99, 235, 0.25), 0 8px 24px rgba(37, 99, 235, 0.4);
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            margin-bottom: 1rem;
        }

        .play-btn-circle:hover {
            transform: scale(1.08);
            box-shadow: 0 0 0 14px rgba(37, 99, 235, 0.35), 0 12px 28px rgba(37, 99, 235, 0.6);
        }

        /* Controls */
        .video-control-bar {
            background: #0f182e;
            padding: 0.75rem 1rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            border-top: 1px solid #1e293b;
        }

        .btn-ctrl {
            background: none;
            border: none;
            color: #cbd5e1;
            font-size: 1.15rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0.25rem 0.5rem;
            border-radius: 6px;
            transition: all 0.2s;
        }

        .btn-ctrl:hover {
            color: #ffffff;
            background: #1e293b;
        }

        .progress-bar-wrap {
            flex: 1;
            height: 6px;
            background: #1e293b;
            border-radius: 9999px;
            overflow: hidden;
            cursor: pointer;
            position: relative;
        }

        .progress-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, #3b82f6, #60a5fa);
            width: 0%;
            transition: width 0.15s linear;
        }

        /* Playlist */
        .video-playlist-container {
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
            max-height: 480px;
            overflow-y: auto;
            padding-right: 0.25rem;
        }

        .playlist-card {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 0.85rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.85rem;
            cursor: pointer;
            transition: all 0.2s;
            user-select: none;
        }

        .playlist-card:hover {
            background: #f1f5f9;
            border-color: #cbd5e1;
            transform: translateX(3px);
        }

        .playlist-card.active {
            background: #eff6ff;
            border-color: #93c5fd;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.08);
        }

        .playlist-thumb {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            background: #ffffff;
            border: 1px solid #cbd5e1;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        }

        .playlist-card.active .playlist-thumb {
            background: #2563eb;
            color: #ffffff;
            border-color: #2563eb;
        }
    </style>
</head>

<body>

    <div class="dashboard">

        <!-- ANIMASI EMBLEM BKN BACKGROUND -->
        <div class="bubble bubble-top-right"></div>
        <div class="bubble bubble-bottom-left"></div>

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="brand">
                <div class="brand-info">
                    <div class="brand-logo">
                        <img src="/logo-bkn-asli.png" alt="Logo BKN">
                    </div>
                    <div class="brand-text">
                        <h2>Meeting App</h2>
                        <span>BKN Regional V</span>
                    </div>
                </div>
                <button type="button" class="btn-sidebar-toggle" id="btnSidebarToggle" title="Kecilkan Sidebar (Perluas Tampilan Tengah)" onclick="toggleSidebar()">
                    <svg class="toggle-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 18l-6-6 6-6"/>
                    </svg>
                </button>
            </div>

            <nav class="menu">
                <a href="/dashboard" class="menu-item" data-tooltip="Dashboard">
                    <span>🏠</span>
                    <span>Dashboard</span>
                </a>

                <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                <a href="/manajemenuser" class="menu-item" data-tooltip="Manajemen User">
                    <span>👥</span>
                    <span>Manajemen User</span>
                </a>
                <% } %>

                <a href="/manajemenmeeting" class="menu-item" data-tooltip="Manajemen Meeting">
                    <span>📋</span>
                    <span>Manajemen Meeting</span>
                </a>

                <a href="/request-zoom" class="menu-item" data-tooltip="Request Zoom">
                    <span>📹</span>
                    <span>Request Zoom</span>
                </a>

                <a href="/infografis" class="menu-item" data-tooltip="App Infografis">
                    <span>📊</span>
                    <span>App Infografis</span>
                </a>

                <!-- MENU MANUAL BOOK -->
                <a href="/manual-book" class="menu-item active" data-tooltip="Manual Book">
                    <span>📖</span>
                    <span>Manual Book</span>
                </a>
            </nav>

            <div class="sidebar-bottom">
                <div class="help-box">
                    <span class="help-icon">?</span>
                    <div>
                        <strong>Butuh bantuan?</strong>
                        <p>Hubungi administrator sistem.</p>
                    </div>
                </div>

                <a href="/" class="logout" onclick="showLogoutModal(event)">
                    <span>↪</span>
                    Keluar
                </a>
            </div>

        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">

            <!-- TOPBAR / PROFILE -->
            <header class="topbar-right-only">
                <div class="profile">
                    <div class="notification">
                        🔔
                        <span></span>
                    </div>

                    <div class="profile-info">
                        <strong><%= (typeof user !== 'undefined' && user && (user.full_name || user.username)) ? (user.full_name || user.username) : "Administrator" %></strong>
                        <small><%= (typeof user !== 'undefined' && user && user.role) ? user.role.toUpperCase() : "PENGGUNA SISTEM" %></small>
                    </div>

                    <div class="avatar" title="<%= (typeof user !== 'undefined' && user && user.full_name) ? user.full_name : 'Avatar' %>">
                        <img src="<%= (typeof user !== 'undefined' && user && user.avatar_path) ? user.avatar_path : '/images/default_avatar.png' %>" alt="Avatar">
                    </div>
                </div>
            </header>

            <div class="manual-container">

                <% if (typeof msg !== 'undefined' && msg) { %>
