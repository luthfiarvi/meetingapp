<%- include('layouts/header') %>
<link rel="stylesheet" href="/css/notulen.css">

<!-- Banner Notifikasi Jika Ada Notula Menunggu Persetujuan Akun Ini -->
<% if (typeof pendingApprovals !== 'undefined' && pendingApprovals && pendingApprovals.length > 0) { %>
<div style="max-width: 1600px; margin: 1rem auto 0; padding: 0 1.5rem;">
  <div style="background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%); border: 1.5px solid #F59E0B; border-radius: 0.75rem; padding: 0.85rem 1.25rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.15);">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <span style="font-size: 1.5rem;">📋</span>
      <div>
        <div style="font-weight: 700; color: #92400E; font-size: 0.9rem;">
          Anda Memiliki <%= pendingApprovals.length %> Notula Menunggu Persetujuan / Pengesahan
        </div>
        <div style="font-size: 0.785rem; color: #78350F;">
          Sebagai Pejabat yang ditunjuk untuk Mengetahui, mohon periksa dan sahkan notula rapat berikut agar resmi terbit.
        </div>
      </div>
    </div>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
      <% pendingApprovals.slice(0, 3).forEach(function(pa) { %>
        <a href="/notulen?id=<%= pa.id %>" class="btn btn-sm" style="background: #92400E; color: #fff; font-size: 0.75rem; font-weight: 700; text-decoration: none; padding: 0.35rem 0.75rem; border-radius: 6px;">
          Buka: <%= pa.title ? (pa.title.length > 25 ? pa.title.substring(0, 22) + '...' : pa.title) : ('Notula #' + pa.id) %>
        </a>
      <% }); %>
    </div>
  </div>
</div>
<% } %>

<div class="notulen-workspace">
  <!-- Left Panel: Form & AI Smart Assistant -->
  <div class="notulen-form-panel">
    <div class="notulen-form-header">
      <div>
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
          <span style="font-size: 0.75rem; font-weight: 700; color: #D97706; text-transform: uppercase; letter-spacing: 0.05em;">
            Tata Naskah Dinas BKN
          </span>
          <span id="headerStatusPill" class="status-pill status-pill-<%= (initialData.approvalStatus === 'approved') ? 'approved' : ((initialData.approvalStatus === 'pending_approval') ? 'pending' : ((initialData.approvalStatus === 'rejected') ? 'rejected' : 'draft')) %>">
            <%= (initialData.approvalStatus === 'approved') ? '✓ Disahkan' : ((initialData.approvalStatus === 'pending_approval') ? '⏳ Menunggu Persetujuan' : ((initialData.approvalStatus === 'rejected') ? '⚠️ Perlu Revisi' : '📝 Draft')) %>
          </span>
        </div>
        <h2 style="font-size: 1.15rem; font-weight: 700; color: #0A2540; margin: 0;">
          Editor Notula Rapat Kedinasan
        </h2>
      </div>
      <div style="display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap;">
        <!-- Tombol Aksi Simpan Draft -->
        <button type="button" id="btnSaveNotulen" class="btn btn-secondary btn-sm" style="font-size: 0.8rem; font-weight: 700; padding: 0.45rem 0.85rem; border-radius: 8px; display: inline-flex; align-items: center; gap: 5px; cursor: pointer;">
          💾 Simpan Draft
        </button>

        <!-- Tombol Pengesahan / Persetujuan (HANYA MUNCUL UNTUK PEJABAT YANG DITUNJUK) -->
        <% 
          const curUid = (typeof user !== 'undefined' && user && user.id) ? String(user.id).trim().toLowerCase() : '';
          const curNip = (typeof user !== 'undefined' && user && user.nip) ? String(user.nip).trim().toLowerCase() : '';
          const targetApproverId = (initialData && initialData.approverId) ? String(initialData.approverId).trim().toLowerCase() : '';
          const targetApproverNip = (initialData && initialData.approverNip) ? String(initialData.approverNip).trim().toLowerCase() : '';
          const isDesignatedApprover = (targetApproverId && curUid && targetApproverId === curUid) || 
                                       (targetApproverNip && curNip && targetApproverNip === curNip);
        %>
        <% if (initialData.approvalStatus === 'pending_approval' && isDesignatedApprover) { %>
          <button type="button" id="btnApproveNotulen" class="btn btn-sm" style="font-size: 0.8rem; font-weight: 700; padding: 0.45rem 0.95rem; background: #059669; color: #fff; border: none; border-radius: 8px; display: inline-flex; align-items: center; gap: 5px; cursor: pointer; box-shadow: 0 4px 10px rgba(5,150,105,0.3);">
            ✓ Sahkan Notula
          </button>
          <button type="button" id="btnRejectNotulen" class="btn btn-secondary btn-sm" style="font-size: 0.8rem; font-weight: 600; padding: 0.45rem 0.8rem; color: #DC2626; border-color: #FCA5A5; border-radius: 8px; cursor: pointer;">
            ⚠️ Minta Revisi
          </button>
        <% } else if (initialData.approvalStatus !== 'approved') { %>
          <button type="button" id="btnSubmitApproval" class="btn btn-primary btn-sm" style="font-size: 0.8rem; font-weight: 700; padding: 0.45rem 0.95rem; background: #D97706; border: none; border-radius: 8px; display: inline-flex; align-items: center; gap: 5px; color: #fff; cursor: pointer; box-shadow: 0 4px 10px rgba(217,119,6,0.3);">
            🚀 Ajukan Pengesahan
          </button>
        <% } %>
      </div>
    </div>

    <div class="notulen-form-body">

      <!-- Peringatan Catatan Revisi Jika Ada -->
      <% if (initialData.approvalStatus === 'rejected' && initialData.approvalNotes) { %>
      <div style="background: #FEF2F2; border: 1.5px solid #F87171; border-radius: 8px; padding: 0.85rem 1rem; margin-bottom: 1.25rem;">
        <div style="font-weight: 700; color: #991B1B; font-size: 0.825rem; margin-bottom: 0.25rem; display: flex; align-items: center; gap: 0.4rem;">
          <span>⚠️</span> <span>Catatan Revisi dari Pejabat yang Mengetahui:</span>
        </div>
        <div style="font-size: 0.8rem; color: #7F1D1D; line-height: 1.4;">
          <%= initialData.approvalNotes %>
        </div>
      </div>
      <% } %>

      <!-- AI Smart Assistant Box -->
      <div style="background: linear-gradient(135deg, #071C33 0%, #0A2540 100%); border-radius: 0.65rem; padding: 1.15rem; color: #fff; margin-bottom: 1.5rem; border-left: 4px solid #D97706;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
          <div style="display: flex; align-items: center; gap: 0.4rem;">
            <span style="font-size: 1rem;">⚡</span>
            <span style="font-size: 0.85rem; font-weight: 700; color: #FBBF24;">AI Smart Notulis BKN</span>
          </div>
          <span style="font-size: 0.7rem; background: rgba(217, 119, 6, 0.3); border: 1px solid rgba(217, 119, 6, 0.5); padding: 0.15rem 0.5rem; border-radius: 9999px; color: #FDE68A;">
            Format Resmi Baru
          </span>
        </div>
        <p style="font-size: 0.775rem; color: #94A3B8; margin-bottom: 0.75rem; line-height: 1.4;">
          Tempelkan catatan atau unggah berkas transkrip. AI akan otomatis menyusun agenda, peserta, serta <strong>4 tahapan Pelaksanaan (Pembukaan, Pembahasan, Diskusi, Rekomendasi)</strong>.
        </p>

        <!-- Upload File Transkrip Box -->
        <div style="margin-bottom: 0.75rem; background: rgba(255, 255, 255, 0.05); border: 1px dashed rgba(255, 255, 255, 0.25); border-radius: 6px; padding: 0.5rem 0.75rem; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
          <div style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; color: #CBD5E1;">
            <span>📎</span>
            <span>Unggah Dokumen Transkrip (</span>
            <span style="color: #FBBF24; font-family: monospace;">.docx, .pdf, .txt, .md</span>
            <span>)</span>
          </div>
          <label class="btn btn-secondary btn-sm" style="margin: 0; font-size: 0.725rem; padding: 0.25rem 0.65rem; cursor: pointer; background: rgba(255,255,255,0.15); color: #fff; border-color: rgba(255,255,255,0.3);">
            <span id="transcriptFileStatusText">Pilih File</span>
            <input type="file" id="transcriptFileInput" accept=".docx,.pdf,.txt,.md" style="display: none;">
          </label>
        </div>

        <textarea id="aiTranscriptInput" class="form-input" style="background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.2); color: #fff; font-size: 0.8rem; min-height: 80px; margin-bottom: 0.75rem;" placeholder="Contoh: Rapat Koordinasi Pelaksanaan Manajemen Talenta tanggal 10 September 2026 jam 09.00-11.30 WIB via Zoom membahas implementasi SIMATA dan MyASN..."></textarea>
        <button type="button" id="btnAiProcess" class="btn btn-secondary w-full" style="font-size: 0.8rem; font-weight: 700; background: #ffffff; color: #0A2540; border: none; padding: 0.55rem; cursor: pointer;">
          ⚡ Proses & Ekstrak Format Notula dengan AI
        </button>
      </div>

      <!-- Formulir Section 1: Identitas & Pelaksanaan Kegiatan -->
      <div style="margin-bottom: 1.5rem;">
        <div style="font-size: 0.8rem; font-weight: 700; color: #0A2540; border-bottom: 2px solid #E2E8F0; padding-bottom: 0.35rem; margin-bottom: 0.85rem; text-transform: uppercase;">
          1. Identitas & Pelaksanaan Kegiatan
        </div>

        <% if ((typeof meetings !== 'undefined' && Array.isArray(meetings) && meetings.length > 0) || (typeof isEditing !== 'undefined' && isEditing)) { %>
        <!-- Pilihan Hubungkan ke Manajemen Meeting -->
        <div class="form-group" style="margin-bottom: 0.85rem; background: #F0FDF4; border: 1px solid #BBF7D0; border-radius: 8px; padding: 10px;">
          <label class="form-label" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
            <span style="font-weight: 700; color: #166534;">🔗 Terhubung ke Rapat Manajemen Meeting:</span>
            <span style="font-size: 0.7rem; color: #15803D; font-weight: 700;">*Otomatis Terintegrasi</span>
          </label>
          <select id="selectMeetingId" class="form-input" style="font-size: 0.825rem; font-weight: 600; background: #ffffff; border-color: #86EFAC; color: #14532D;">
            <% if (typeof meetings !== 'undefined' && Array.isArray(meetings) && meetings.length > 0) { %>
              <% meetings.forEach(function(m) { %>
                <option value="<%= m.meeting_id %>" <%= (typeof selectedMeetingId !== 'undefined' && selectedMeetingId && String(selectedMeetingId) === String(m.meeting_id)) ? 'selected' : '' %>>
                  [ID: <%= m.meeting_id %>] <%= m.meeting_nama %> (<%= m.tanggal ? (m.tanggal.toISOString ? m.tanggal.toISOString().split('T')[0] : String(m.tanggal).split('T')[0]) : '-' %>)
                </option>
              <% }); %>
            <% } else { %>
              <option value="" disabled>-- Anda belum memiliki agenda rapat terdaftar --</option>
            <% } %>
          </select>
        </div>
        <% } %>

        <!-- Judul Notula -->
        <div class="form-group" style="margin-bottom: 0.85rem;">
          <label class="form-label" style="display: flex; justify-content: space-between; align-items: center;">
            <span>Tema / Judul Kegiatan Rapat (Notula):</span>
            <span style="font-size: 0.7rem; color: #DC2626; font-weight: 600;">*HURUF KAPITAL</span>
          </label>
          <textarea id="notulaTitle" class="form-input" style="min-height: 54px; font-weight: 600; font-size: 0.85rem;" placeholder="Contoh: PENDAMPINGAN PEMBANGUNAN MANAJEMEN TALENTA KABUPATEN LAMPUNG BARAT"></textarea>
        </div>

        <!-- Waktu & Tanggal -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.85rem;">
          <div class="form-group">
            <label class="form-label">
              <span>Tanggal Pelaksanaan:</span>
            </label>
            <input type="date" id="notulaDate" class="form-input" style="font-size: 0.825rem;">
          </div>
          <div class="form-group">
            <label class="form-label">
              <span>Waktu / Jam:</span>
            </label>
            <input type="text" id="notulaTime" class="form-input" placeholder="09.00 – 11.30 WIB" style="font-size: 0.825rem;">
          </div>
        </div>

        <!-- Tempat Pelaksanaan Rapat -->
        <div class="form-group" style="margin-bottom: 0.85rem;">
          <label class="form-label">Tempat Rapat / Pertemuan:</label>
          <select id="notulaPlace" class="form-input" style="font-size: 0.825rem; margin-bottom: 0.4rem;">
            <option value="Daring melalui Zoom Meeting">1. Daring melalui Zoom Meeting</option>
            <option value="Di Tempat">2. Di Tempat (Luring di Kantor / Ruang Rapat)</option>
            <option value="custom">3. Tulis Tempat Lainnya...</option>
          </select>
          <input type="text" id="notulaCustomPlace" class="form-input" placeholder="Tuliskan nama ruangan / platform rapat..." style="font-size: 0.825rem; display: none;">
        </div>
      </div>

      <!-- Formulir Section 2: Agenda Rapat -->
      <div style="margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #E2E8F0; padding-bottom: 0.35rem; margin-bottom: 0.85rem;">
          <span style="font-size: 0.8rem; font-weight: 700; color: #0A2540; text-transform: uppercase;">2. Agenda Rapat</span>
          <button type="button" class="btn btn-secondary btn-sm" style="font-size: 0.725rem; padding: 0.2rem 0.55rem;" onclick="addListItem('agenda')">+ Tambah Agenda</button>
        </div>
        <div id="agendaContainer"></div>
      </div>

      <!-- Formulir Section 3: Peserta Rapat -->
      <div style="margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #E2E8F0; padding-bottom: 0.35rem; margin-bottom: 0.85rem;">
          <div>
            <span style="font-size: 0.8rem; font-weight: 700; color: #0A2540; text-transform: uppercase;">3. Peserta Rapat</span>
            <span style="font-size: 0.68rem; color: #64748B; display: block;">Cantumkan jabatan struktural / nama tim perwakilan</span>
          </div>
          <button type="button" class="btn btn-secondary btn-sm" style="font-size: 0.725rem; padding: 0.2rem 0.55rem;" onclick="addListItem('attendees')">+ Tambah Peserta</button>
        </div>
        <div id="attendeesContainer"></div>
      </div>

      <!-- Formulir Section 4: Pelaksanaan (4 Tahap Resmi BKN) -->
      <div style="margin-bottom: 1.5rem;">
        <div style="font-size: 0.8rem; font-weight: 700; color: #0A2540; border-bottom: 2px solid #E2E8F0; padding-bottom: 0.35rem; margin-bottom: 0.85rem; text-transform: uppercase;">
          4. Pelaksanaan (4 Tahapan Kedinasan BKN)
        </div>

        <!-- 4.1 Pembukaan -->
        <div class="form-group" style="margin-bottom: 0.85rem;">
          <label class="form-label" style="font-weight: 700;">1. Pembukaan:</label>
          <textarea id="pelaksanaanPembukaan" class="form-input" style="min-height: 65px; font-size: 0.825rem;" placeholder="Uraian jalannya pembukaan rapat oleh MC / Pimpinan..."></textarea>
        </div>

        <!-- 4.2 Pembahasan -->
        <div class="form-group" style="margin-bottom: 0.85rem;">
          <label class="form-label" style="font-weight: 700;">2. Pembahasan:</label>
          <textarea id="pelaksanaanPembahasan" class="form-input" style="min-height: 85px; font-size: 0.825rem;" placeholder="Uraian komprehensif materi pokok bahasan rapat..."></textarea>
        </div>

        <!-- Khusus MT: Kertas Kerja Evaluasi MT -->
        <div id="kertasKerjaMtCard" style="margin-bottom: 1rem; background: #FFFBEB; border: 1.5px solid #FCD34D; border-radius: 0.5rem; padding: 0.85rem;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; margin: 0;">
              <input type="checkbox" id="toggleKertasKerjaMt" style="width: 17px; height: 17px; accent-color: #D97706; cursor: pointer;">
              <span style="font-size: 0.825rem; font-weight: 700; color: #92400E;">Sertakan Tabel Kertas Kerja Manajemen Talenta (MT)</span>
            </label>
            <span style="font-size: 0.7rem; background: #FEF3C7; color: #B45309; border: 1px solid #FDE68A; padding: 2px 7px; border-radius: 4px; font-weight: 600;">Khusus MT</span>
          </div>
          <div id="kertasKerjaMtBody" style="display: none; margin-top: 0.85rem;">
            <div style="font-size: 0.725rem; color: #78350F; margin-bottom: 0.6rem; line-height: 1.4; background: #FEF3C7; padding: 0.5rem; border-radius: 4px;">
              💡 15 butir standar BKN Dit. Bangtarier. Ubah status menjadi <strong>✓</strong> (jika ada eviden) atau <strong>-</strong> (jika belum ada eviden).
            </div>
            <div id="kertasKerjaMtContainer" style="overflow-x: auto;"></div>
          </div>
        </div>

        <!-- 4.3 Diskusi / Tanya Jawab -->
        <div class="form-group" style="margin-bottom: 0.85rem;">
          <label class="form-label" style="font-weight: 700;">3. Diskusi / Tanya Jawab:</label>
          <textarea id="pelaksanaanDiskusi" class="form-input" style="min-height: 75px; font-size: 0.825rem;" placeholder="Uraian dinamika diskusi, tanya jawab, kendala, dan tanggapan..."></textarea>
        </div>

        <!-- 4.4 Rekomendasi/Tindak Lanjut -->
        <div class="form-group" style="margin-bottom: 0.85rem;">
          <label class="form-label" style="font-weight: 700;">4. Rekomendasi / Tindak Lanjut:</label>
          <textarea id="pelaksanaanRekomendasi" class="form-input" style="min-height: 75px; font-size: 0.825rem;" placeholder="Butir-butir rekomendasi konkret dan penugasan tindak lanjut..."></textarea>
        </div>
      </div>

      <!-- Formulir Section 5: Bukti Kegiatan / Dokumentasi Foto -->
      <div style="margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #E2E8F0; padding-bottom: 0.35rem; margin-bottom: 0.85rem;">
          <div>
            <span style="font-size: 0.8rem; font-weight: 700; color: #0A2540; text-transform: uppercase;">5. Dokumentasi Kegiatan</span>
            <span style="font-size: 0.7rem; color: #64748B; display: block;">Foto, screenshoot, evidence, link dok pendukung</span>
          </div>
          <label class="btn btn-secondary btn-sm" style="font-size: 0.725rem; padding: 0.25rem 0.6rem; cursor: pointer; margin: 0;">
            <span>+ Unggah Foto</span>
            <input type="file" id="documentationFileInput" accept="image/*" style="display: none;">
          </label>
        </div>
        <div id="documentationPhotosContainer" style="display: flex; flex-direction: column; gap: 0.6rem;"></div>
      </div>

      <!-- Formulir Section 6: Penutup -->
      <div style="margin-bottom: 1.5rem;">
        <div style="font-size: 0.8rem; font-weight: 700; color: #0A2540; border-bottom: 2px solid #E2E8F0; padding-bottom: 0.35rem; margin-bottom: 0.85rem; text-transform: uppercase;">
          6. Penutup
        </div>
        <div class="form-group">
          <textarea id="notulaClosing" class="form-input" style="min-height: 55px; font-size: 0.825rem;" placeholder="Demikian notula ini disusun untuk dipergunakan sebagaimana mestinya."></textarea>
        </div>
      </div>

      <!-- Formulir Section 7: Pengesahan & Tanda Tangan (Opsi A: Alur Akun Login Pejabat) -->
      <div style="margin-bottom: 1.5rem; background: #F8FAFC; border: 1.5px solid #CBD5E1; border-radius: 8px; padding: 1rem;">
        <div style="font-size: 0.825rem; font-weight: 700; color: #0A2540; border-bottom: 2px solid #E2E8F0; padding-bottom: 0.35rem; margin-bottom: 0.85rem; text-transform: uppercase; display: flex; align-items: center; justify-content: space-between;">
          <span>7. Pengesahan (Pihak Mengetahui & Notulis)</span>
          <span style="font-size: 0.7rem; color: #2563EB; font-weight: 600;">Opsi A: Digital Approval</span>
        </div>

        <!-- Kolom Kiri: Pihak yang Mengetahui (Pejabat yang Mengesahkan) -->
        <div style="background: #ffffff; border: 1px solid #E2E8F0; border-radius: 6px; padding: 0.85rem; margin-bottom: 0.85rem;">
          <div style="font-weight: 700; color: #1E293B; font-size: 0.8rem; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.35rem;">
            <span>🛡️</span> <span>Pihak yang Mengetahui (Pejabat yang Mengesahkan):</span>
          </div>

          <div class="form-group" style="margin-bottom: 0.5rem;">
            <label class="form-label" style="font-size: 0.75rem;">Pilih dari Akun Pegawai / Pejabat Sistem:</label>
            <select id="selectApproverUser" class="form-input" style="font-size: 0.8rem; font-weight: 600;">
              <option value="">-- Ketik Manual / Pilih Akun Pejabat --</option>
              <% if (typeof approverList !== 'undefined' && approverList) { %>
                <% approverList.forEach(function(ap) { %>
                  <option value="<%= ap.id %>" data-name="<%= ap.full_name %>" data-nip="<%= ap.nip || '' %>" data-role="<%= ap.division || (ap.role === 'admin' ? 'Administrator' : 'Pegawai') %>" <%= (initialData.approverId && String(initialData.approverId) === String(ap.id)) ? 'selected' : '' %>>
                    <%= ap.full_name %> (<%= ap.role === 'admin' ? 'Pimpinan/Admin' : (ap.division || ap.role) %>)
                  </option>
                <% }); %>
              <% } %>
            </select>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
            <div class="form-group">
              <label class="form-label" style="font-size: 0.75rem;">Nama Pejabat:</label>
              <input type="text" id="approverName" class="form-input" style="font-size: 0.8rem;" placeholder="Nama Lengkap Pejabat">
            </div>
            <div class="form-group">
              <label class="form-label" style="font-size: 0.75rem;">NIP Pejabat:</label>
              <input type="text" id="approverNip" class="form-input" style="font-size: 0.8rem;" placeholder="NIP. ...">
            </div>
          </div>

          <div class="form-group" style="margin-top: 0.5rem;">
            <label class="form-label" style="font-size: 0.75rem;">Nama Jabatan yang Mengesahkan:</label>
            <input type="text" id="approverRole" class="form-input" style="font-size: 0.8rem;" placeholder="Contoh: Kepala Kantor Regional V BKN / Kepala BKPSDM...">
          </div>
        </div>

        <!-- Kolom Kanan: Notulis -->
        <div style="background: #ffffff; border: 1px solid #E2E8F0; border-radius: 6px; padding: 0.85rem;">
          <div style="font-weight: 700; color: #1E293B; font-size: 0.8rem; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.35rem;">
            <span>✍️</span> <span>Notulis (Penyusun Notula):</span>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
            <div class="form-group">
              <label class="form-label" style="font-size: 0.75rem;">Nama Notulis:</label>
              <input type="text" id="notulisName" class="form-input" style="font-size: 0.8rem;" placeholder="Nama Lengkap Notulis">
            </div>
            <div class="form-group">
              <label class="form-label" style="font-size: 0.75rem;">NIP Notulis:</label>
              <input type="text" id="notulisNip" class="form-input" style="font-size: 0.8rem;" placeholder="NIP. ...">
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-top: 0.5rem;">
            <div class="form-group">
              <label class="form-label" style="font-size: 0.75rem;">Jabatan / Unit Kerja Notulis:</label>
              <input type="text" id="notulisRole" class="form-input" style="font-size: 0.8rem;" placeholder="Jabatan Notulis">
            </div>
            <div class="form-group">
              <label class="form-label" style="font-size: 0.75rem;">Kota Tanda Tangan:</label>
              <input type="text" id="notulisCity" class="form-input" style="font-size: 0.8rem;" placeholder="Jakarta">
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>

  <!-- Right Panel: Live BKN Document Preview -->
  <div class="notulen-preview-panel">
    <!-- Toolbar Aksi Preview -->
    <div class="preview-toolbar">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span style="width: 8px; height: 8px; background: #10B981; border-radius: 50%; display: inline-block;"></span>
        <span style="font-size: 0.85rem; font-weight: 700; color: #0A2540;">Preview Notula Resmi BKN</span>
      </div>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <button type="button" id="btnPrintNotulen" class="btn btn-primary btn-sm" style="display: flex; align-items: center; gap: 0.4rem; font-weight: 600; font-size: 0.825rem; cursor: pointer;">
          <svg style="width: 1rem; height: 1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
          <span>Cetak / PDF A4</span>
        </button>
      </div>
    </div>

    <!-- Official BKN Paper Sheet (Sesuai Template PDF Contoh) -->
    <div class="notula-paper" id="notulaPaper">
      
      <!-- Kop Surat Resmi dengan Lambang Garuda Pancasila -->
      <div class="notula-kop">
        <img src="/images/garuda_pancasila.png" alt="Lambang Garuda Pancasila" class="notula-garuda">
        <div class="notula-kop-title">
          <%= (typeof user !== 'undefined' && user.institution_kop) ? user.institution_kop : 'BADAN KEPEGAWAIAN NEGARA KANTOR REGIONAL V' %>
        </div>
        <div class="notula-kop-address">
          <%= (typeof user !== 'undefined' && user.kop_address) ? user.kop_address : 'Jalan Raya Ciracas Nomor 36, Ciracas, Jakarta Timur, Jakarta 13730' %><br>
          <%= (typeof user !== 'undefined' && user.kop_contact) ? user.kop_contact : 'Telepon (021) 87721084 - 87721085; Faksimile (021) 87721085; Laman: jakarta.bkn.go.id; Pos-el: kanreg5.jakarta@bkn.go.id' %>
        </div>
        <div class="notula-kop-divider"></div>
      </div>

      <!-- Judul Notula & Metadata Pelaksanaan -->
      <div class="notula-title-block">
        <div class="notula-main-title">NOTULA</div>
        <div class="notula-sub-title" id="previewTitle">
          (<%= initialData.title %>)
        </div>
        <div class="notula-meta-line" id="previewDateTime">
          Hari, Tanggal, Waktu: <%= initialData.formattedDate %>, <%= initialData.meetingTime %>
        </div>
        <div class="notula-meta-line" id="previewPlace">
          Tempat: <%= initialData.meetingPlace %>
        </div>
      </div>

      <!-- 1. AGENDA RAPAT (Kotak Shaded Grey Sesuai Template) -->
      <div class="notula-shaded-box">
        AGENDA RAPAT
      </div>
      <ul class="notula-list" id="previewAgendaList">
        <% (initialData.agenda || []).forEach(function(item) { %>
          <li><%= item %></li>
        <% }); %>
      </ul>

      <!-- 2. PESERTA RAPAT (Kotak Shaded Grey Sesuai Template) -->
      <div class="notula-shaded-box">
        PESERTA RAPAT
      </div>
      <ol class="notula-num-list" id="previewAttendeesList">
        <% (initialData.attendees || []).forEach(function(item) { %>
          <li><%= item %></li>
        <% }); %>
      </ol>

      <!-- 3. PELAKSANAAN (4 Tahapan Sesuai Template) -->
      <div class="notula-shaded-box">
        PELAKSANAAN
      </div>
      <div>
        <div class="pelaksanaan-subheading">1. Pembukaan</div>
        <div class="pelaksanaan-text" id="previewPembukaan">
          <%= initialData.pelaksanaanPembukaan || (initialData.activities && initialData.activities[0]?.points ? initialData.activities[0].points.join('\n') : '-') %>
        </div>

        <div class="pelaksanaan-subheading">2. Pembahasan</div>
        <div class="pelaksanaan-text" id="previewPembahasan">
          <%= initialData.pelaksanaanPembahasan || (initialData.activities && initialData.activities.length > 1 ? initialData.activities.slice(1).map(a => a.sectionTitle + ':\n' + (a.points || []).join('\n')).join('\n\n') : '-') %>
        </div>

        <!-- Khusus Rapat MT: Live Preview Tabel Kertas Kerja -->
        <div id="previewKertasKerjaMtSection" style="margin-top: 1rem; margin-bottom: 1.5rem; display: none;">
          <div class="notula-subsection-title" style="font-weight: bold; margin-bottom: 0.6rem; font-size: 11pt;">
            Penyampaian Kertas Kerja Evaluasi Manajemen Talenta
          </div>
          <table style="width: 100%; border-collapse: collapse; border: 1px solid #000; font-family: 'Times New Roman', serif;">
            <thead>
              <tr style="background-color: #D9E2EC; border: 1px solid #000; text-align: center; font-weight: bold; font-size: 9.5pt;">
                <th style="border: 1px solid #000; padding: 6px 4px; width: 35px;">No</th>
                <th style="border: 1px solid #000; padding: 6px 6px; width: 140px;">Komponen Penilaian</th>
                <th style="border: 1px solid #000; padding: 6px 6px;">Indikator Penilaian</th>
                <th style="border: 1px solid #000; padding: 6px 6px; width: 140px;">Bukti Output</th>
                <th style="border: 1px solid #000; padding: 6px 4px; width: 45px; text-align: center;">Status</th>
                <th style="border: 1px solid #000; padding: 6px 6px; width: 130px;">Keterangan</th>
              </tr>
            </thead>
            <tbody id="previewKertasKerjaMtBody"></tbody>
          </table>
        </div>

        <div class="pelaksanaan-subheading">3. Diskusi / Tanya Jawab</div>
        <div class="pelaksanaan-text" id="previewDiskusi">
          <%= initialData.pelaksanaanDiskusi || '-' %>
        </div>

        <div class="pelaksanaan-subheading">4. Rekomendasi/Tindak Lanjut</div>
        <div class="pelaksanaan-text" id="previewRekomendasi">
          <%= initialData.pelaksanaanRekomendasi || (initialData.actionItems ? initialData.actionItems.map((item, idx) => (idx + 1) + '. ' + item).join('\n') : '-') %>
        </div>
      </div>

      <!-- 4. DOKUMENTASI (Kotak Shaded Grey Sesuai Template) -->
      <div class="notula-shaded-box">
        DOKUMENTASI
      </div>
      <div class="notula-subnote">(Foto, screenshoot, evidence, link dok pendukung, dll)</div>
      <div id="previewEvidenceSection" style="margin-top: 0.5rem; margin-bottom: 1.25rem; <%= (initialData.documentationPhotos && initialData.documentationPhotos.length > 0) ? '' : 'display: none;' %>">
        <div id="previewEvidenceGrid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem;">
          <% (initialData.documentationPhotos || []).forEach(function(photo) { %>
            <div style="border: 1px solid #CBD5E1; border-radius: 4px; padding: 6px; background: #fafafa; text-align: center;">
              <img src="<%= photo.url || photo.dataUrl || photo.previewUrl || '' %>" alt="<%= photo.caption || 'Bukti Kegiatan' %>" style="max-height: 180px; width: 100%; object-fit: cover; border-radius: 2px;">
              <% if (photo.caption) { %>
                <div style="font-size: 8.5pt; color: #475569; margin-top: 4px; font-style: italic;"><%= photo.caption %></div>
              <% } %>
            </div>
          <% }); %>
        </div>
      </div>

      <!-- 5. PENUTUP (Kotak Shaded Grey Sesuai Template) -->
      <div class="notula-shaded-box">
        PENUTUP
      </div>
      <p style="text-align: justify; margin-bottom: 1.75rem; line-height: 1.5; font-size: 10.5pt;" id="previewClosing">
        <%= initialData.closingText || 'Demikian notula ini disusun untuk dipergunakan sebagaimana mestinya.' %>
      </p>

      <!-- 6. Tanda Tangan 2 Kolom (Mengetahui di Kiri, Notulis di Kanan Sesuai Template Baru) -->
      <table class="notula-sig-table">
        <tr>
          <!-- Kolom Kiri: Mengetahui -->
          <td class="notula-sig-cell-left">
            <div>Mengetahui,</div>
            <div style="font-weight: bold; margin-bottom: 4px;" id="previewApproverRole"><%= initialData.approverRole || '(Nama Jabatan)' %></div>
            <div class="notula-sig-space" id="previewApproverSigArea">
              <% if (initialData.approverSignature) { %>
                <img id="previewApproverSigImg" src="<%= initialData.approverSignature %>" alt="Tanda Tangan Pejabat" style="max-height: 68px; max-width: 170px; object-fit: contain; margin: 2px auto; display: block;" />
              <% } else if (initialData.approvalStatus === 'approved') { %>
                <div class="notula-approval-badge">
                  <div style="font-weight: bold; font-size: 8.5pt; color: #047857;">✓ DISAHKAN RESMI</div>
                  <div id="previewApprovedByName"><%= initialData.approverName || 'Pejabat' %></div>
                  <div style="font-size: 7.5pt; color: #059669;" id="previewApprovedDate"><%= initialData.approvedAt ? new Date(initialData.approvedAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : initialData.formattedDate %></div>
                </div>
              <% } else { %>
                <div style="font-style: italic; color: #666; font-size: 9.5pt;">ttd</div>
              <% } %>
            </div>
            <div style="font-weight: bold; text-decoration: underline;" id="previewApproverName"><%= initialData.approverName || 'Nama' %></div>
            <div id="previewApproverNip"><%= initialData.approverNip ? (String(initialData.approverNip).startsWith('NIP') ? initialData.approverNip : 'NIP. ' + initialData.approverNip) : '' %></div>
          </td>

          <!-- Kolom Kanan: Notulis -->
          <td class="notula-sig-cell-right">
            <div><span id="previewSigCity"><%= (typeof user !== 'undefined' && user.sig_city) ? user.sig_city : 'Jakarta' %></span>, <span id="previewSigDate"><%= initialData.formattedDate.includes(',') ? initialData.formattedDate.split(',')[1].trim() : initialData.formattedDate %></span></div>
            <div style="font-weight: bold; margin-bottom: 4px;">Notulis,</div>
            <div class="notula-sig-space" id="previewNotulisSigSpace">
              <% if (initialData.notulisSignature || initialData.notulis_signature || (typeof user !== 'undefined' && user.signature_path)) { %>
                <img id="previewNotulisSigImg" src="<%= initialData.notulisSignature || initialData.notulis_signature || user.signature_path %>" alt="Tanda Tangan Notulis" style="max-height: 68px; max-width: 170px; object-fit: contain; margin: 2px auto; display: block;" />
              <% } else { %>
                <div style="font-style: italic; color: #666; font-size: 9.5pt;">ttd</div>
              <% } %>
            </div>
            <div style="font-weight: bold; text-decoration: underline;" id="previewSigName"><%= initialData.notulisName || (typeof user !== 'undefined' ? user.full_name : '') %></div>
            <div id="previewSigNip"><%= (initialData.notulisNip || (typeof user !== 'undefined' && user.nip)) ? (String(initialData.notulisNip || user.nip).startsWith('NIP') ? String(initialData.notulisNip || user.nip) : 'NIP. ' + (initialData.notulisNip || user.nip)) : '' %></div>
            <div id="previewSigRole" style="font-size: 9.5pt; color: #333;"><%= initialData.notulisRole || (typeof user !== 'undefined' ? user.division : '') %></div>
          </td>
        </tr>
      </table>

      <!-- Running Footer Cetak -->
      <div class="notula-running-footer">
        <span id="runningTitle">Notula <%= initialData.title %></span>
        <span><%= (typeof user !== 'undefined' && user.running_footer) ? user.running_footer : 'Dokumen Resmi Kanreg V BKN' %></span>
      </div>

    </div>
  </div>
</div>

<!-- MODAL PENGESAHAN NOTULA & BUKTI TANDA TANGAN DIGITAL (OPSI A: PROFIL / FILE TTD) -->
<div id="approvalModal" style="display: none; position: fixed; inset: 0; z-index: 99999; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(4px); justify-content: center; align-items: center; padding: 1rem;">
  <div style="background: #ffffff; border-radius: 14px; max-width: 520px; width: 100%; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); overflow: hidden; animation: fadeInModal 0.2s ease-out;">
    <div style="background: linear-gradient(135deg, #065F46, #059669); color: #fff; padding: 1rem 1.25rem; display: flex; justify-content: space-between; align-items: center;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="font-size: 1.25rem;">✍️</span>
        <h3 style="margin: 0; font-size: 1.05rem; font-weight: 700; color: #fff;">Pengesahan Notula Rapat Resmi</h3>
      </div>
      <button type="button" onclick="closeApprovalModal()" style="background: transparent; border: none; color: #fff; font-size: 1.5rem; cursor: pointer; line-height: 1; padding: 0 4px;">&times;</button>
    </div>
    
    <div style="padding: 1.25rem; max-height: 78vh; overflow-y: auto;">
      <!-- Ringkasan Pejabat Pengesah -->
      <div style="background: #F0FDF4; border: 1px solid #BBF7D0; border-radius: 8px; padding: 0.85rem; margin-bottom: 1rem;">
        <div style="font-size: 0.725rem; text-transform: uppercase; font-weight: 700; color: #166534; letter-spacing: 0.5px; margin-bottom: 3px;">Pejabat Penandatangan / Mengetahui:</div>
        <div style="font-weight: 700; color: #14532D; font-size: 0.95rem;"><%= user.full_name %></div>
        <div style="font-size: 0.825rem; color: #15803D;"><%= user.division || user.institution || 'Kantor Regional V BKN' %></div>
        <div style="font-size: 0.75rem; color: #166534;"><%= user.nip ? (String(user.nip).startsWith('NIP') ? user.nip : 'NIP. ' + user.nip) : '' %></div>
      </div>

      <!-- Pemilihan Tanda Tangan File (Tanpa QR Code) -->
      <div style="margin-bottom: 1rem;">
        <label style="display: block; font-weight: 700; font-size: 0.85rem; color: #1F2937; margin-bottom: 0.4rem;">
          Tanda Tangan Kedinasan (File Gambar TTD):
        </label>
        
        <!-- Opsi 1: TTD Tersimpan di Profil -->
        <div id="profileSigSection" style="<%= (user.signature_path) ? '' : 'display: none;' %> margin-bottom: 0.75rem;">
          <div style="border: 1.5px solid #10B981; background: #F8FAFC; border-radius: 8px; padding: 0.75rem; display: flex; align-items: center; justify-content: space-between; gap: 10px;">
            <div>
              <div style="font-size: 0.8rem; font-weight: 700; color: #047857; margin-bottom: 4px;">✓ Tanda Tangan Resmi Tersimpan di Profil</div>
              <img id="profileSigPreview" src="<%= user.signature_path || '' %>" style="max-height: 52px; max-width: 140px; object-fit: contain; background: #fff; padding: 2px 6px; border-radius: 4px; border: 1px dashed #CBD5E1;" alt="TTD Profil">
            </div>
            <label style="display: flex; align-items: center; gap: 6px; font-size: 0.8rem; color: #1E293B; cursor: pointer; font-weight: 600;">
              <input type="checkbox" id="chkUseProfileSig" <%= (user.signature_path) ? 'checked' : '' %> onchange="handleUseProfileSigChange()" style="accent-color: #059669; width: 16px; height: 16px;"> Gunakan TTD ini
            </label>
          </div>
        </div>

        <!-- Opsi 2: Upload File TTD Baru (PNG / JPG) -->
        <div id="uploadSigSection" style="<%= (user.signature_path) ? 'display: none;' : '' %>">
          <div style="border: 1.5px dashed #CBD5E1; border-radius: 8px; padding: 0.85rem; text-align: center; background: #F8FAFC;">
            <input type="file" id="modalSigFileInput" accept="image/png, image/jpeg, image/jpg" style="display: none;" onchange="handleModalSigFileSelect(event)">
            <button type="button" onclick="document.getElementById('modalSigFileInput').click()" class="btn btn-secondary btn-sm" style="font-size: 0.8rem; padding: 0.4rem 0.85rem; margin-bottom: 5px; cursor: pointer;">
              📁 Pilih File Gambar Tanda Tangan (PNG / JPG)
            </button>
            <div style="font-size: 0.75rem; color: #64748B;">Disarankan gambar berlatar transparan (PNG) atau latar putih bersih.</div>
            
            <div id="modalNewSigPreviewContainer" style="display: none; margin-top: 8px;">
              <div style="font-size: 0.75rem; color: #059669; font-weight: 600; margin-bottom: 4px;">Pratinjau File TTD:</div>
              <img id="modalNewSigPreview" src="" style="max-height: 58px; max-width: 150px; object-fit: contain; background: #fff; padding: 3px 8px; border-radius: 6px; border: 1px solid #E2E8F0;" alt="Preview TTD Baru">
            </div>
          </div>

          <div style="margin-top: 6px;">
            <label style="display: flex; align-items: center; gap: 6px; font-size: 0.775rem; color: #475569; cursor: pointer;">
              <input type="checkbox" id="chkSaveToProfile" checked style="accent-color: #059669;">
              Simpan file tanda tangan ini ke profil saya agar otomatis digunakan selanjutnya
            </label>
          </div>
        </div>

        <!-- Tombol Beralih Ganti File TTD -->
        <% if (user.signature_path) { %>
          <div style="margin-top: 5px; text-align: right;">
            <button type="button" id="btnToggleUploadSig" onclick="toggleUploadSigSection()" style="background: none; border: none; color: #2563EB; font-size: 0.775rem; cursor: pointer; text-decoration: underline; font-weight: 600;">
              Ganti / Unggah File TTD Baru
            </button>
          </div>
        <% } %>
      </div>

      <!-- Catatan Pengesahan Opsional -->
      <div style="margin-bottom: 1.25rem;">
        <label for="modalApprovalNotes" style="display: block; font-weight: 600; font-size: 0.825rem; color: #374151; margin-bottom: 4px;">
          Catatan / Rekomendasi (Opsional):
        </label>
        <textarea id="modalApprovalNotes" rows="2" style="width: 100%; border: 1px solid #D1D5DB; border-radius: 6px; padding: 0.5rem; font-size: 0.825rem; box-sizing: border-box; font-family: inherit;" placeholder="Catatan persetujuan (opsional)..."></textarea>
      </div>

      <!-- Tombol Aksi Final -->
      <div style="display: flex; gap: 0.6rem; justify-content: flex-end; align-items: center; border-top: 1px solid #E2E8F0; padding-top: 0.85rem;">
        <button type="button" onclick="closeApprovalModal()" class="btn btn-secondary btn-sm" style="padding: 0.5rem 1rem; font-size: 0.825rem; cursor: pointer;">
          Batal
        </button>
        <button type="button" id="btnConfirmApprovalModal" onclick="submitFinalApproval()" class="btn btn-sm" style="background: #059669; color: #fff; border: none; border-radius: 6px; font-weight: 700; font-size: 0.85rem; padding: 0.5rem 1.2rem; cursor: pointer; box-shadow: 0 4px 10px rgba(5,150,105,0.3); display: inline-flex; align-items: center; gap: 5px;">
          ✓ Sahkan & Bubuhkan Tanda Tangan
        </button>
      </div>
    </div>
  </div>
</div>

<!-- MODERN CUSTOM DIALOG MODAL (CONFIRM & PROMPT BKN) -->
<div id="customDialogModal" class="custom-dialog-overlay" style="display: none;">
  <div class="custom-dialog-card">
    <!-- Header Icon -->
    <div id="customDialogIconContainer" class="custom-dialog-icon-wrap">
      <div id="customDialogIcon" class="custom-dialog-icon theme-amber">🚀</div>
    </div>
    
    <!-- Title & Body -->
    <div class="custom-dialog-content">
      <h3 id="customDialogTitle" class="custom-dialog-title">Ajukan Pengesahan Notula?</h3>
      <p id="customDialogMessage" class="custom-dialog-message">
        Kirimkan notula ini ke Pejabat yang Mengetahui untuk diverifikasi dan disahkan secara resmi.
      </p>

      <!-- Target Info Card -->
      <div id="customDialogCardDetails" class="custom-dialog-details" style="display: none;"></div>

      <!-- Prompt Input (untuk Catatan Revisi) -->
      <div id="customDialogInputContainer" style="display: none; margin-top: 1rem; text-align: left;">
        <label id="customDialogInputLabel" style="display: block; font-size: 0.825rem; font-weight: 600; color: #334155; margin-bottom: 0.35rem;">Catatan:</label>
        <textarea id="customDialogInput" rows="3" style="width: 100%; border: 1.5px solid #CBD5E1; border-radius: 10px; padding: 0.65rem; font-size: 0.85rem; font-family: inherit; resize: vertical; box-sizing: border-box; outline: none; transition: border-color 0.2s;" placeholder="Tuliskan catatan revisi..."></textarea>
      </div>
    </div>

    <!-- Actions -->
    <div class="custom-dialog-actions">
      <button type="button" id="customDialogBtnCancel" class="btn-dialog-cancel">Batal</button>
      <button type="button" id="customDialogBtnConfirm" class="btn-dialog-confirm theme-amber">
        <span id="customDialogBtnIcon">🚀</span> <span id="customDialogBtnText">Ya, Ajukan</span>
      </button>
    </div>
  </div>
</div>

<script>
  window.initialNotulenData = <%- JSON.stringify(typeof initialData !== 'undefined' ? initialData : {}) %>;
  window.todayFormattedString = "<%= typeof todayFormatted !== 'undefined' ? todayFormatted : '' %>";
  window.availableMeetings = <%- typeof meetings !== 'undefined' ? JSON.stringify(meetings || []) : '[]' %>;
  window.selectedMeetingId = <%= typeof selectedMeetingId !== 'undefined' && selectedMeetingId ? JSON.stringify(selectedMeetingId) : 'null' %>;
  window.isEditingNotulen = <%= typeof isEditing !== 'undefined' && isEditing ? 'true' : 'false' %>;
  window.currentUserNip = "<%= (typeof user !== 'undefined' && user.nip) ? user.nip : '' %>";
  window.currentUserId = "<%= (typeof user !== 'undefined' && user.id) ? user.id : '' %>";
  window.currentUserRole = "<%= (typeof user !== 'undefined' && user.role) ? user.role : 'user' %>";
  window.currentUserFullName = "<%= (typeof user !== 'undefined' && user.full_name) ? user.full_name : '' %>";
  window.currentUserDivision = "<%= (typeof user !== 'undefined' && user.division) ? user.division : '' %>";
  window.currentUserSignature = "<%= (typeof user !== 'undefined' && user.signature_path) ? user.signature_path : '' %>";
</script>
<script src="/js/notulen.js"></script>

<%- include('layouts/footer') %>
