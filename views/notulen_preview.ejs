<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/notulen.css">
  <style>
    body {
      background: #E2E8F0;
      margin: 0;
      padding: 2rem 1rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .preview-actions {
      width: 100%;
      max-width: 820px;
      margin-bottom: 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    @media print {
      body {
        background: #ffffff !important;
        padding: 0 !important;
      }
      .preview-actions {
        display: none !important;
      }
      .notula-paper {
        box-shadow: none !important;
        padding: 15mm 20mm !important;
        max-width: 100% !important;
        width: 100% !important;
      }
    }
  </style>
</head>
<body>

  <div class="preview-actions">
    <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
      <a href="/notulen?id=<%= doc.id %>" class="btn btn-secondary btn-sm" style="display: flex; align-items: center; gap: 0.4rem; text-decoration: none;">
        <svg style="width: 1rem; height: 1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        <span>Kembali ke Editor</span>
      </a>
      <% if (doc.approvalStatus === 'approved') { %>
        <span class="status-pill status-pill-approved">✓ Telah Disahkan</span>
      <% } else if (doc.approvalStatus === 'pending_approval') { %>
        <span class="status-pill status-pill-pending">⏳ Menunggu Pengesahan</span>
      <% } else if (doc.approvalStatus === 'rejected') { %>
        <span class="status-pill status-pill-rejected">⚠️ Perlu Revisi</span>
      <% } else { %>
        <span class="status-pill status-pill-draft">📝 Draft</span>
      <% } %>
    </div>

    <div style="display: flex; gap: 0.5rem; align-items: center;">
      <% 
        const pUid = (typeof user !== 'undefined' && user && user.id) ? String(user.id).trim().toLowerCase() : '';
        const pNip = (typeof user !== 'undefined' && user && user.nip) ? String(user.nip).trim().toLowerCase() : '';
        const docAppId = (doc && (doc.approver_id || doc.approverId)) ? String(doc.approver_id || doc.approverId).trim().toLowerCase() : '';
        const docAppNip = (doc && (doc.approver_nip || doc.approverNip)) ? String(doc.approver_nip || doc.approverNip).trim().toLowerCase() : '';
        const isTargetApprover = (docAppId && pUid && docAppId === pUid) || (docAppNip && pNip && docAppNip === pNip);
      %>
      <% if (doc.approvalStatus === 'pending_approval' && isTargetApprover) { %>
        <button type="button" onclick="confirmApproval(<%= doc.id %>)" class="btn btn-sm" style="background: #059669; color: #fff; font-weight: 700; border: none; box-shadow: 0 4px 10px rgba(5,150,105,0.3); display: flex; align-items: center; gap: 4px; padding: 0.45rem 0.9rem; border-radius: 6px; cursor: pointer;">
          ✓ Setujui & Sahkan Notula
        </button>
        <button type="button" onclick="confirmReject(<%= doc.id %>)" class="btn btn-secondary btn-sm" style="color: #DC2626; border-color: #FCA5A5; font-weight: 600; cursor: pointer;">
          ⚠️ Kembalikan (Revisi)
        </button>
      <% } %>
      <a href="/notulen/export-docx/<%= doc.id %>" class="btn btn-secondary btn-sm" style="display: flex; align-items: center; gap: 0.4rem; text-decoration: none;">
        <span>📄 Ekspor Word (.docx)</span>
      </a>
      <button type="button" onclick="window.print()" class="btn btn-primary btn-sm" style="display: flex; align-items: center; gap: 0.4rem;">
        <svg style="width: 1rem; height: 1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
        <span>Cetak / PDF A4</span>
      </button>
    </div>
  </div>

  <div class="notula-paper">
    <!-- Kop Surat Resmi -->
    <div class="notula-kop">
      <img src="/images/garuda_pancasila.png" alt="Lambang Garuda Pancasila" class="notula-garuda">
      <div class="notula-kop-title">
        <%= (typeof user !== 'undefined' && user.institution_kop) ? user.institution_kop : 'BADAN KEPEGAWAIAN NEGARA KANTOR REGIONAL V' %>
      </div>
      <div class="notula-kop-address">
        <%= (typeof user !== 'undefined' && user.kop_address) ? user.kop_address : 'Jalan Raya Ciracas Nomor 36, Ciracas, Jakarta Timur, Jakarta 13730' %><br>
        <%= (typeof user !== 'undefined' && user.kop_contact) ? user.kop_contact : 'Telepon (021) 87721084 - 87721085; Faksimile (021) 87721085; Laman: jakarta.bkn.go.id; Pos-el: kanreg5.jakarta@bkn.go.id' %>
      </div>
      <div class="notula-kop-divider"></div>
    </div>

    <!-- Judul Notula & Pelaksanaan -->
    <div class="notula-title-block">
      <div class="notula-main-title">NOTULA</div>
      <div class="notula-sub-title">
        (<%= doc.title %>)
      </div>
      <div class="notula-meta-line">
        Hari, Tanggal, Waktu: <%= doc.formattedDate %>, <%= doc.meetingTime %>
      </div>
      <div class="notula-meta-line">
        Tempat: <%= doc.meetingPlace %>
      </div>
    </div>

    <!-- 1. Agenda Rapat -->
    <div class="notula-shaded-box">
      AGENDA RAPAT
    </div>
    <ul class="notula-list">
      <% (doc.agenda || []).forEach(function(item) { %>
        <li><%= item %></li>
      <% }); %>
    </ul>

    <!-- 2. Peserta Rapat -->
    <div class="notula-shaded-box">
      PESERTA RAPAT
    </div>
    <ol class="notula-num-list">
      <% (doc.attendees || []).forEach(function(item) { %>
        <li><%= item %></li>
      <% }); %>
    </ol>

    <!-- 3. Pelaksanaan Rapat -->
    <div class="notula-shaded-box">
      PELAKSANAAN
    </div>
    <div>
      <div class="pelaksanaan-subheading">1. Pembukaan</div>
      <div class="pelaksanaan-text">
        <%= doc.pelaksanaanPembukaan || (doc.activities && doc.activities[0]?.points ? doc.activities[0].points.join('\n') : '-') %>
      </div>

      <div class="pelaksanaan-subheading">2. Pembahasan</div>
      <div class="pelaksanaan-text">
        <% if (doc.pelaksanaanPembahasan) { %>
          <%= doc.pelaksanaanPembahasan %>
        <% } else if (doc.activities && doc.activities.length > 1) { %>
          <% doc.activities.slice(1).forEach(function(a) { %>
            <strong><%= a.sectionTitle %></strong><br>
            <%= (a.points || []).join('\n') %><br><br>
          <% }); %>
        <% } else if (doc.activities && doc.activities.length === 1 && doc.activities[0].points) { %>
          <%= doc.activities[0].points.join('\n') %>
        <% } else { %>
          -
        <% } %>
      </div>

      <!-- Khusus Rapat MT: Tabel Kertas Kerja Evaluasi MT -->
      <% if (doc.kertasKerjaMt && doc.kertasKerjaMt.length > 0) { %>
        <div style="margin-top: 1rem; margin-bottom: 1.5rem;">
          <div class="notula-subsection-title" style="font-weight: bold; margin-bottom: 0.6rem; font-size: 11pt;">
            Penyampaian Kertas Kerja Evaluasi Manajemen Talenta
          </div>
          <table style="width: 100%; border-collapse: collapse; border: 1px solid #000; font-family: 'Times New Roman', serif;">
            <thead>
              <tr style="background-color: #D9E2EC; border: 1px solid #000; text-align: center; font-weight: bold; font-size: 9.5pt;">
                <th style="border: 1px solid #000; padding: 6px 4px; width: 35px;">No</th>
                <th style="border: 1px solid #000; padding: 6px 6px; width: 140px;">Komponen Penilaian</th>
                <th style="border: 1px solid #000; padding: 6px 6px;">Indikator Penilaian</th>
                <th style="border: 1px solid #000; padding: 6px 6px; width: 140px;">Bukti Output</th>
                <th style="border: 1px solid #000; padding: 6px 4px; width: 45px; text-align: center;">Status</th>
                <th style="border: 1px solid #000; padding: 6px 6px; width: 130px;">Keterangan</th>
              </tr>
            </thead>
            <tbody>
              <% let currentPilar = ''; %>
              <% doc.kertasKerjaMt.forEach(function(row) { %>
                <% if (row.pilar && row.pilar !== currentPilar) { %>
                  <% currentPilar = row.pilar; %>
                  <tr style="background-color: #FDE8D7; font-weight: bold; border: 1px solid #000;">
                    <td colspan="6" style="padding: 6px 8px; border: 1px solid #000; font-weight: bold; font-size: 9.5pt;"><%= row.pilar %></td>
                  </tr>
                <% } %>
                <tr style="border: 1px solid #000;">
                  <td style="border: 1px solid #000; padding: 5px 4px; text-align: center; vertical-align: top; font-size: 9.5pt;"><%= row.no || '-' %></td>
                  <td style="border: 1px solid #000; padding: 5px 6px; vertical-align: top; font-size: 9.5pt; font-weight: 500;"><%= row.komponen || '-' %></td>
                  <td style="border: 1px solid #000; padding: 5px 6px; vertical-align: top; font-size: 9.5pt;"><%= row.indikator || '-' %></td>
                  <td style="border: 1px solid #000; padding: 5px 6px; vertical-align: top; font-size: 9.5pt;"><%= row.buktiOutput || '-' %></td>
                  <td style="border: 1px solid #000; padding: 5px 4px; text-align: center; vertical-align: top; font-size: 11pt; font-weight: bold;"><%= row.status === '✓' ? '✓' : '-' %></td>
                  <td style="border: 1px solid #000; padding: 5px 6px; vertical-align: top; font-size: 9.5pt;"><%= row.keterangan || '-' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>

      <div class="pelaksanaan-subheading">3. Diskusi / Tanya Jawab</div>
      <div class="pelaksanaan-text">
        <%= doc.pelaksanaanDiskusi || '-' %>
      </div>

      <div class="pelaksanaan-subheading">4. Rekomendasi/Tindak Lanjut</div>
      <div class="pelaksanaan-text">
        <% if (doc.pelaksanaanRekomendasi) { %>
          <%= doc.pelaksanaanRekomendasi %>
        <% } else if (doc.actionItems && doc.actionItems.length > 0) { %>
          <% doc.actionItems.forEach(function(item, idx) { %>
            <%= idx + 1 %>. <%= item %><br>
          <% }); %>
        <% } else if (doc.conclusions && doc.conclusions.length > 0) { %>
          <% doc.conclusions.forEach(function(item, idx) { %>
            <%= idx + 1 %>. <%= item %><br>
          <% }); %>
        <% } else { %>
          -
        <% } %>
      </div>
    </div>

    <!-- 4. Dokumentasi -->
    <div class="notula-shaded-box">
      DOKUMENTASI
    </div>
    <div class="notula-subnote">(Foto, screenshoot, evidence, link dok pendukung, dll)</div>
    <% if (doc.documentationPhotos && doc.documentationPhotos.length > 0) { %>
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 0.5rem; margin-bottom: 1.25rem;">
        <% doc.documentationPhotos.forEach(function(photo) { %>
          <div style="border: 1px solid #CBD5E1; border-radius: 4px; padding: 6px; background: #fafafa; text-align: center;">
            <img src="<%= photo.url || photo.dataUrl || photo.previewUrl || '' %>" alt="<%= photo.caption || 'Dokumentasi Giat' %>" style="max-height: 180px; width: 100%; object-fit: cover; border-radius: 2px;">
            <% if (photo.caption) { %>
              <div style="font-size: 8.5pt; color: #475569; margin-top: 4px; font-style: italic;"><%= photo.caption %></div>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% } %>

    <!-- 5. Penutup -->
    <div class="notula-shaded-box">
      PENUTUP
    </div>
    <p style="text-align: justify; margin-bottom: 1.5rem; line-height: 1.5; font-size: 10.5pt;">
      <%= doc.closingText || 'Demikian notula ini disusun untuk dipergunakan sebagaimana mestinya.' %>
    </p>

    <!-- 6. Tanda Tangan 2 Kolom (Mengetahui di Kiri, Notulis di Kanan) -->
    <table class="notula-sig-table">
      <tr>
        <!-- Kolom Kiri: Mengetahui -->
        <td class="notula-sig-cell-left">
          <div>Mengetahui,</div>
          <div style="font-weight: bold; margin-bottom: 4px;"><%= doc.approverRole || doc.approver_role || '(Nama Jabatan)' %></div>
          <div class="notula-sig-space">
            <% if (doc.approverSignature || doc.approver_signature) { %>
              <img src="<%= doc.approverSignature || doc.approver_signature %>" alt="Tanda Tangan Pejabat" style="max-height: 68px; max-width: 170px; object-fit: contain; margin: 2px 0; display: block;" />
            <% } else if (doc.approvalStatus === 'approved' || doc.approval_status === 'approved') { %>
              <div class="notula-approval-badge">
                <div style="font-weight: bold; font-size: 8.5pt; color: #047857;">✓ DISAHKAN RESMI</div>
                <div><%= doc.approverName || doc.approver_name || 'Pejabat' %></div>
                <div style="font-size: 7.5pt; color: #059669;"><%= doc.approvedAt || doc.approved_at ? new Date(doc.approvedAt || doc.approved_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : doc.formattedDate %></div>
              </div>
            <% } else { %>
              <div style="font-style: italic; color: #666; font-size: 9.5pt;">ttd</div>
            <% } %>
          </div>
          <div style="font-weight: bold; text-decoration: underline;"><%= doc.approverName || doc.approver_name || 'Nama' %></div>
          <% const appNip = doc.approverNip || doc.approver_nip; %>
          <% if (appNip) { %>
            <div><%= String(appNip).startsWith('NIP') ? appNip : 'NIP. ' + appNip %></div>
          <% } %>
        </td>

        <!-- Kolom Kanan: Notulis -->
        <td class="notula-sig-cell-right">
          <div><%= (typeof user !== 'undefined' && user.sig_city) ? user.sig_city : 'Jakarta' %>, <%= doc.formattedDate.includes(',') ? doc.formattedDate.split(',')[1].trim() : doc.formattedDate %></div>
          <div style="font-weight: bold; margin-bottom: 4px;">Notulis,</div>
          <div class="notula-sig-space">
            <% if (doc.notulisSignature || doc.notulis_signature || (typeof user !== 'undefined' && user.signature_path)) { %>
              <img src="<%= doc.notulisSignature || doc.notulis_signature || user.signature_path %>" alt="Tanda Tangan Notulis" style="max-height: 68px; max-width: 170px; object-fit: contain; margin: 2px 0; display: block;" />
            <% } else { %>
              <div style="font-style: italic; color: #666; font-size: 9.5pt;">ttd</div>
            <% } %>
          </div>
          <div style="font-weight: bold; text-decoration: underline;"><%= doc.notulisName || doc.notulis_name || user.full_name %></div>
          <% const previewNip = doc.notulisNip || doc.notulis_nip || (typeof user !== 'undefined' && user.nip ? user.nip : ''); %>
          <% if (previewNip) { %>
            <div><%= String(previewNip).startsWith('NIP') ? previewNip : 'NIP. ' + previewNip %></div>
          <% } %>
        </td>
      </tr>
    </table>

    <!-- Running Footer Cetak -->
    <div class="notula-running-footer">
      <span>Notula <%= doc.title %></span>
      <span><%= (typeof user !== 'undefined' && user.running_footer) ? user.running_footer : 'Dokumen Resmi Kanreg V BKN' %></span>
    </div>

  </div>

  <!-- MODERN CUSTOM DIALOG MODAL (CONFIRM & PROMPT BKN) -->
  <div id="customDialogModal" class="custom-dialog-overlay" style="display: none;">
    <div class="custom-dialog-card">
      <div id="customDialogIconContainer" class="custom-dialog-icon-wrap">
        <div id="customDialogIcon" class="custom-dialog-icon theme-emerald">✍️</div>
      </div>
      
      <div class="custom-dialog-content">
        <h3 id="customDialogTitle" class="custom-dialog-title">Sahkan Notula Rapat?</h3>
        <p id="customDialogMessage" class="custom-dialog-message">
          Notula ini akan disahkan dan dibubuhkan tanda tangan resmi Anda sebagai Pejabat yang Mengetahui.
        </p>

        <div id="customDialogCardDetails" class="custom-dialog-details" style="display: none;"></div>

        <div id="customDialogInputContainer" style="display: none; margin-top: 1rem; text-align: left;">
          <label id="customDialogInputLabel" style="display: block; font-size: 0.825rem; font-weight: 600; color: #334155; margin-bottom: 0.35rem;">Catatan:</label>
          <textarea id="customDialogInput" rows="3" style="width: 100%; border: 1.5px solid #CBD5E1; border-radius: 10px; padding: 0.65rem; font-size: 0.85rem; font-family: inherit; resize: vertical; box-sizing: border-box; outline: none; transition: border-color 0.2s;" placeholder="Tuliskan catatan..."></textarea>
        </div>
      </div>

      <div class="custom-dialog-actions">
        <button type="button" id="customDialogBtnCancel" class="btn-dialog-cancel">Batal</button>
        <button type="button" id="customDialogBtnConfirm" class="btn-dialog-confirm theme-emerald">
          <span id="customDialogBtnIcon">✓</span> <span id="customDialogBtnText">Ya, Sahkan Notula</span>
        </button>
      </div>
    </div>
  </div>

  <script>
    function showCustomDialog({
      title = 'Konfirmasi',
      message = '',
      icon = '🚀',
      theme = 'emerald',
      confirmText = 'Lanjutkan',
      confirmIcon = '✓',
      cancelText = 'Batal',
      showCancel = true,
      details = null,
      isPrompt = false,
      promptLabel = 'Catatan:',
      promptPlaceholder = '',
      promptValue = ''
    } = {}) {
      return new Promise((resolve) => {
        let overlay = document.getElementById('customDialogModal');
        if (!overlay) {
          if (isPrompt) return resolve(window.prompt(message, promptValue));
          if (!showCancel) { window.alert(message); return resolve(true); }
          return resolve(window.confirm(message));
        }

        const iconEl = document.getElementById('customDialogIcon');
        const titleEl = document.getElementById('customDialogTitle');
        const msgEl = document.getElementById('customDialogMessage');
        const detailsContainer = document.getElementById('customDialogCardDetails');
        const inputContainer = document.getElementById('customDialogInputContainer');
        const inputEl = document.getElementById('customDialogInput');
        const inputLabelEl = document.getElementById('customDialogInputLabel');
        const btnCancel = document.getElementById('customDialogBtnCancel');
        const btnConfirm = document.getElementById('customDialogBtnConfirm');
        const btnIcon = document.getElementById('customDialogBtnIcon');
        const btnText = document.getElementById('customDialogBtnText');

        if (titleEl) titleEl.innerText = title;
        if (msgEl) msgEl.innerText = message;
        if (iconEl) {
          iconEl.className = 'custom-dialog-icon theme-' + theme;
          iconEl.innerText = icon;
        }
        if (btnConfirm) btnConfirm.className = 'btn-dialog-confirm theme-' + theme;
        if (btnIcon) btnIcon.innerText = confirmIcon;
        if (btnText) btnText.innerText = confirmText;
        if (btnCancel) {
          btnCancel.innerText = cancelText;
          btnCancel.style.display = showCancel ? 'block' : 'none';
        }

        if (details && Array.isArray(details) && details.length > 0 && detailsContainer) {
          detailsContainer.innerHTML = details.map(d => `
            <div class="custom-dialog-details-row">
              <span class="custom-dialog-details-label">${d.label}</span>
              <span class="custom-dialog-details-val">${d.value}</span>
            </div>
          `).join('');
          detailsContainer.style.display = 'block';
        } else if (detailsContainer) {
          detailsContainer.style.display = 'none';
        }

        if (isPrompt && inputContainer && inputEl) {
          inputContainer.style.display = 'block';
          if (inputLabelEl) inputLabelEl.innerText = promptLabel;
          inputEl.placeholder = promptPlaceholder;
          inputEl.value = promptValue;
        } else if (inputContainer) {
          inputContainer.style.display = 'none';
        }

        overlay.style.display = 'flex';
        requestAnimationFrame(() => {
          overlay.classList.add('show');
          if (isPrompt && inputEl) inputEl.focus();
        });

        const cleanup = () => {
          overlay.classList.remove('show');
          setTimeout(() => { overlay.style.display = 'none'; }, 250);
          if (btnConfirm) btnConfirm.onclick = null;
          if (btnCancel) btnCancel.onclick = null;
          overlay.onclick = null;
        };

        if (btnConfirm) {
          btnConfirm.onclick = () => {
            const val = isPrompt ? (inputEl ? inputEl.value.trim() : '') : true;
            cleanup();
            resolve(val);
          };
        }

        if (btnCancel) {
          btnCancel.onclick = () => {
            cleanup();
            resolve(isPrompt ? null : false);
          };
        }

        overlay.onclick = (e) => {
          if (e.target === overlay) {
            cleanup();
            resolve(isPrompt ? null : false);
          }
        };
      });
    }

    async function confirmApproval(id) {
      const confirmed = await showCustomDialog({
        title: 'Sahkan Notula Rapat Ini?',
        message: 'Anda akan menyetujui dan membubuhkan tanda tangan resmi kedinasan Anda pada dokumen notula ini.',
        icon: '✍️',
        theme: 'emerald',
        confirmText: 'Ya, Sahkan Dokumen',
        confirmIcon: '✓',
        cancelText: 'Batal',
        details: [
          { label: 'Judul Notula:', value: '<%= doc.title %>' },
          { label: 'Notulis Penyusun:', value: '<%= doc.notulisName || doc.notulis_name || "Pegawai BKN" %>' }
        ]
      });
      if (!confirmed) return;

      try {
        const res = await fetch("/api/notulen/approve", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id })
        });
        const result = await res.json();
        if (result.success) {
          await showCustomDialog({
            title: 'Notula Berhasil Disahkan!',
            message: 'Dokumen notula resmi telah disahkan dan tanda tangan Anda telah terpasang dengan sempurna.',
            icon: '✅',
            theme: 'emerald',
            confirmText: 'Lihat Dokumen',
            confirmIcon: '✓',
            showCancel: false
          });
          window.location.reload();
        } else {
          alert("Gagal mengesahkan: " + (result.message || "Terjadi kesalahan"));
        }
      } catch (e) {
        alert("Gagal koneksi ke server: " + e.message);
      }
    }

    async function confirmReject(id) {
      const reason = await showCustomDialog({
        title: 'Kembalikan Notula (Perlu Revisi)',
        message: 'Tuliskan catatan arahan atau poin koreksi yang perlu diperbaiki oleh Notulis:',
        icon: '⚠️',
        theme: 'rose',
        confirmText: 'Kirim Catatan Revisi',
        confirmIcon: '⚠️',
        cancelText: 'Batal',
        isPrompt: true,
        promptLabel: 'Catatan Revisi:',
        promptPlaceholder: 'Contoh: Mohon koreksi bagian kesimpulan rapat...',
        promptValue: ''
      });
      if (!reason) return;

      try {
        const res = await fetch("/api/notulen/reject", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id, notes: reason })
        });
        const result = await res.json();
        if (result.success) {
          await showCustomDialog({
            title: 'Notula Dikembalikan',
            message: 'Catatan revisi telah dikirimkan ke Notulis.',
            icon: 'ℹ️',
            theme: 'rose',
            confirmText: 'Selesai',
            confirmIcon: '✓',
            showCancel: false
          });
          window.location.reload();
        } else {
          alert("Gagal mengembalikan notula: " + (result.message || "Terjadi kesalahan"));
        }
      } catch (e) {
        alert("Gagal koneksi ke server: " + e.message);
      }
    }
  </script>

    <!-- Running Footer Cetak -->
    <div class="notula-running-footer">
      <span>Notula <%= doc.title %></span>
      <span><%= (typeof user !== 'undefined' && user.running_footer) ? user.running_footer : 'Dokumen Resmi Kanreg V BKN' %></span>
    </div>

  </div>

</body>
</html>
