        function handleModalSertifBgChange(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                if (file.size > 15 * 1024 * 1024) {
                    if (typeof showToast === 'function') {
                        showToast('Ukuran gambar background maksimal 15MB', 'error', 'File Terlalu Besar');
                    } else {
                        alert('Ukuran gambar background maksimal 15MB');
                    }
                    input.value = '';
                    return;
                }
                const reader = new FileReader();
                reader.onload = function (e) {
                    const hidBg = document.getElementById('modalHiddenSertifBg');
                    const previewImg = document.getElementById('modalSertifBgPreviewImg');
                    const badge = document.getElementById('modalSertifBgBadge');
                    if (hidBg) hidBg.value = e.target.result;
                    if (previewImg) previewImg.src = e.target.result;
                    if (badge) {
                        badge.textContent = 'Gambar Baru Dipilih (Belum Disimpan)';
                        badge.style.background = '#d97706';
                    }
                };
                reader.readAsDataURL(file);
            }
        }

        function resetModalSertifBgToDefault() {
            const fileInp = document.getElementById('modalSertifBgFile');
            const hidBg = document.getElementById('modalHiddenSertifBg');
            const previewImg = document.getElementById('modalSertifBgPreviewImg');
            const badge = document.getElementById('modalSertifBgBadge');
            if (fileInp) fileInp.value = '';
            if (hidBg) hidBg.value = '/images/bg-sertifikat.png';
            if (previewImg) previewImg.src = '/images/bg-sertifikat.png';
            if (badge) {
                badge.textContent = 'Kembali ke Default BKN';
