        function readFileAsBase64(file) {
            return new Promise((resolve, reject) => {
                if (!file) return resolve(null);
                const reader = new FileReader();
                reader.onload = (e) => resolve(e.target.result);
                reader.onerror = (e) => reject(e);
                reader.readAsDataURL(file);
            });
        }

        document.getElementById('editMeetingForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            if (!activeCardForEdit) return;
            const targetCard = activeCardForEdit;
            const meetingId = targetCard.dataset.meetingId;

            const name = document.getElementById('editName').value.trim();
            const date = document.getElementById('editDate').value.trim();
            const type = document.getElementById('editType').value.trim();
            const desc = document.getElementById('editDescription').value.trim();
            const fileInput = document.getElementById('editThumbnail');
            const pdfInput = document.getElementById('editNotulenPdf');
            const videoInput = document.getElementById('editVideoFile');

            // Button loading state
            const saveBtn = this.querySelector('.modal-save');
            const originalText = saveBtn.textContent;
            saveBtn.disabled = true;
            saveBtn.textContent = '⏳ Menyimpan...';

            try {
                // Read files asynchronously
                let thumbnailBase64 = null;
                if (fileInput.files && fileInput.files[0]) {
                    thumbnailBase64 = await readFileAsBase64(fileInput.files[0]);
                    // Instant optimistic visual feedback on card
                    targetCard.querySelector('.meeting-card-banner img').src = thumbnailBase64;
                }

                let pdfBase64 = null;
                if (pdfInput.files && pdfInput.files[0]) {
                    pdfBase64 = await readFileAsBase64(pdfInput.files[0]);
                }

                let videoBase64 = null;
                if (videoInput.files && videoInput.files[0]) {
                    videoBase64 = await readFileAsBase64(videoInput.files[0]);
                }

                // Send update payload to server
                const payload = {
                    meeting_id: meetingId,
                    m_nama: name,
                    deskripsi: desc,
                    tanggal: date,
                    m_tipe: type
                };
                if (thumbnailBase64) payload.thumbnail = thumbnailBase64;
                if (pdfBase64) payload.notulen_pdf = pdfBase64;
                if (videoBase64) payload.video_url = videoBase64;

                const response = await fetch('/updatemeeting', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    targetCard.querySelector('.meeting-card-title').textContent = name;
                    targetCard.querySelector('.meeting-card-badge').textContent = type;
                    targetCard.querySelector('.meeting-card-meta').textContent = `📅 Tanggal: ${date}`;
                    if (targetCard.querySelector('.meeting-card-desc')) {
                        targetCard.querySelector('.meeting-card-desc').textContent = desc;
                    }

                    if (result.data?.thumbnail) {
                        targetCard.querySelector('.meeting-card-banner img').src = result.data.thumbnail;
                        targetCard.dataset.thumbnail = result.data.thumbnail;
                    }
                    if (result.data?.notulen_pdf) {
                        targetCard.dataset.pdfUrl = result.data.notulen_pdf;
                    }
                    if (result.data?.video_url) {
                        targetCard.dataset.videoUrl = result.data.video_url;
                    }

                    showToast('Data Meeting dan Foto Thumbnail berhasil diperbarui!', 'success', 'Perubahan Disimpan');
                    closeEditModal();
                } else {
                    showToast(result.message || 'Gagal memperbarui meeting.', 'error', 'Gagal Simpan');
                }
            } catch (err) {
                console.error('Error updating meeting:', err);
                showToast('Terjadi kesalahan saat memperbarui meeting.', 'error', 'Koneksi Terganggu');
            } finally {
                saveBtn.disabled = false;
                saveBtn.textContent = originalText;
            }
        });

