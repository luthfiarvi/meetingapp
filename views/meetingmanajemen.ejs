    <script>
        const meetingModal = document.getElementById("meetingModal");
        const closeMeetingButton = document.getElementById("closeMeetingModal");
        const cancelMeetingButton = document.getElementById("cancelMeetingModal");

        let activeCardForEdit = null;
        let currentActivePdfBlob = null;
        let currentActiveVideoBlob = null;

        
        function generateClientFormatNomor(title, dateStr) {
            const d = dateStr ? new Date(dateStr) : new Date();
            const months = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII'];
            const bulanRomawi = months[d.getMonth()] || 'X';
            const tahun = d.getFullYear() || 2026;

            let kodeKegiatan = "WEBINAR.KR5";
            if (title) {
                const aksaraMatch = title.match(/AKSARA\s*(?:vol\.?\s*|volume\s*|\.|\-)?\s*(\d+)/i);
                if (aksaraMatch && aksaraMatch[1]) {
                    const volNum = String(aksaraMatch[1]).padStart(2, '0');
                    kodeKegiatan = `AKSARA.${volNum}`;
                } else if (/AKSARA/i.test(title)) {
                    kodeKegiatan = "AKSARA";
                }
            }
            return `[NOMOR]/${kodeKegiatan}/KR5/${bulanRomawi}/${tahun}`;
        }

        function updateModalCertNumberPreview() {
            const inp = document.getElementById('modalSertifFormatNomor');
            const previewText = document.getElementById('modalCertNumberPreviewText');
            if (!inp || !previewText) return;

            const configMId = document.getElementById('configMeetingId');
            const meetingId = configMId ? configMId.value : null;
            const card = meetingId ? document.querySelector(`.meeting-card[data-meeting-id="${meetingId}"]`) : null;
            const title = card ? (card.querySelector('.meeting-card-title')?.textContent?.trim() || '') : '';
            const dateStr = card?.dataset?.meetingDate || '';

            let pattern = inp.value.trim() || generateClientFormatNomor(title, dateStr);

            const d = dateStr ? new Date(dateStr) : new Date();
            const months = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII'];
            const bulanRomawi = months[d.getMonth()] || 'X';
            const tahun = d.getFullYear() || 2026;

            let preview = pattern
                .replaceAll(/\[BULAN\]|\{BULAN\}|\<BULAN\>/gi, bulanRomawi)
                .replaceAll(/\[TAHUN\]|\{TAHUN\}|\<TAHUN\>/gi, String(tahun));

            if (/\[NOMOR\]|\{NOMOR\}|\<NOMOR\>/i.test(preview)) {
                preview = preview.replaceAll(/\[NOMOR\]|\{NOMOR\}|\<NOMOR\>/gi, '001');
            } else if (preview.startsWith('/')) {
                preview = '001' + preview;
            } else {
                preview = '001/' + preview;
            }

            previewText.textContent = preview;
        }

        function resetModalSertifFormatNomor() {
            const configMId = document.getElementById('configMeetingId');
            const meetingId = configMId ? configMId.value : null;
            const card = meetingId ? document.querySelector(`.meeting-card[data-meeting-id="${meetingId}"]`) : null;
            const title = card ? (card.querySelector('.meeting-card-title')?.textContent?.trim() || '') : '';
            const dateStr = card?.dataset?.meetingDate || '';

            const defaultFmt = generateClientFormatNomor(title, dateStr);
            const inp = document.getElementById('modalSertifFormatNomor');
            if (inp) {
                inp.value = defaultFmt;
                updateModalCertNumberPreview();
            }
        }

        
        function toggleLayoutModeUI(mode) {
            const signerBox = document.getElementById('modalSertifSignerBox');
            const penyelenggaraBox = document.getElementById('modalSertifPenyelenggaraBox');
            if (mode === 'full') {
                if (signerBox) signerBox.style.display = 'grid';
                if (penyelenggaraBox) penyelenggaraBox.style.display = 'block';
            } else {
                if (signerBox) signerBox.style.display = 'none';
                if (penyelenggaraBox) penyelenggaraBox.style.display = 'none';
            }
        }

        function switchSertifTab(tab) {
            const btnList = document.getElementById('tabBtnSertifList');
            const btnConfig = document.getElementById('tabBtnSertifConfig');
            const contentList = document.getElementById('tabContentSertifList');
            const contentConfig = document.getElementById('tabContentSertifConfig');

            if (tab === 'config') {
                if (btnList) {
                    btnList.style.color = '#64748b';
                    btnList.style.borderBottom = 'none';
                }
                if (btnConfig) {
                    btnConfig.style.color = '#2563eb';
                    btnConfig.style.borderBottom = '3px solid #2563eb';
                }
                if (contentList) contentList.style.display = 'none';
                if (contentConfig) contentConfig.style.display = 'block';
            } else {
                if (btnConfig) {
                    btnConfig.style.color = '#64748b';
                    btnConfig.style.borderBottom = 'none';
                }
                if (btnList) {
                    btnList.style.color = '#2563eb';
                    btnList.style.borderBottom = '3px solid #2563eb';
                }
                if (contentList) contentList.style.display = 'block';
                if (contentConfig) contentConfig.style.display = 'none';

                const configMId = document.getElementById('configMeetingId');
                const meetingId = configMId ? configMId.value : null;
                if (meetingId) loadSertifikatList(meetingId);
            }
        }

        async function loadSertifikatList(meetingId) {
            const loading = document.getElementById('sertifikatModalLoading');
            const list = document.getElementById('sertifikatModalList');
            const empty = document.getElementById('sertifikatModalEmpty');
            if (!loading || !list || !empty) return;

            loading.style.display = 'block';
            list.style.display = 'none';
            empty.style.display = 'none';

            try {
                const res = await fetch(`/api/sertifikat/${meetingId}?_t=${Date.now()}`);
                const result = await res.json();

                loading.style.display = 'none';
                if (result.meeting) {
                    const m = result.meeting;
                    const card = document.querySelector(`.meeting-card[data-meeting-id="${meetingId}"]`);
                    if (card) {
                        if (m.sertifikat_bg) card.dataset.sertifBg = m.sertifikat_bg;
                        if (m.sertifikat_signer) card.dataset.sertifSigner = m.sertifikat_signer;
                        if (m.sertifikat_signer_role) card.dataset.sertifSignerRole = m.sertifikat_signer_role;
                        if (m.sertifikat_penyelenggara) card.dataset.sertifPenyelenggara = m.sertifikat_penyelenggara;
                        if (m.sertifikat_enable_ttd !== undefined) card.dataset.sertifEnableTtd = m.sertifikat_enable_ttd ? 'true' : 'false';
                        if (m.sertifikat_layout_mode) card.dataset.sertifLayoutMode = m.sertifikat_layout_mode;
                        if (m.sertifikat_format_nomor) card.dataset.sertifFormatNomor = m.sertifikat_format_nomor;
                    }

                    const hidBg = document.getElementById('modalHiddenSertifBg');
                    const previewImg = document.getElementById('modalSertifBgPreviewImg');
                    const badge = document.getElementById('modalSertifBgBadge');
                    if (m.sertifikat_bg && previewImg && badge && hidBg && (!hidBg.value || hidBg.value === '/images/bg-sertifikat.png')) {
                        hidBg.value = m.sertifikat_bg;
                        previewImg.src = m.sertifikat_bg;
                        badge.textContent = m.sertifikat_bg.includes('aksara') ? 'Template AKSARA Vol. 7 Aktif' : 'Template Kustom Aktif';
                        badge.style.background = '#059669';
                    }
                }

                const controls = document.getElementById('sertifikatModalControls');
                const countBadge = document.getElementById('sertifikatCountBadge');
                const paginationBox = document.getElementById('sertifikatPaginationControls');
                const searchInput = document.getElementById('sertifikatSearchInput');

                if (result.success && result.data && result.data.length > 0) {
                    window.__allCertificates = result.data;
                    window.__filteredCertificates = result.data;
                    window.__certDisplayCount = 50;

                    if (searchInput) searchInput.value = '';
                    if (controls) controls.style.display = 'flex';
                    renderSertifikatListItems();
                    list.style.display = 'block';
                } else {
                    window.__allCertificates = [];
                    window.__filteredCertificates = [];
                    if (controls) controls.style.display = 'none';
                    if (paginationBox) paginationBox.style.display = 'none';
                    empty.style.display = 'block';
                }
            } catch (err) {
                console.error('Error fetching certificates:', err);
                loading.style.display = 'none';
                empty.style.display = 'block';
            }
        }

        function renderSertifikatListItems() {
            const list = document.getElementById('sertifikatModalList');
            const countBadge = document.getElementById('sertifikatCountBadge');
            const paginationBox = document.getElementById('sertifikatPaginationControls');
            const btnMore = document.getElementById('btnLoadMoreSertif');
            if (!list) return;

            const items = window.__filteredCertificates || [];
            const total = items.length;
            const limit = window.__certDisplayCount || 50;
            const visibleItems = items.slice(0, limit);

            if (countBadge) {
                countBadge.textContent = total > limit 
                    ? `Menampilkan ${visibleItems.length} dari ${total.toLocaleString('id-ID')} Sertifikat`
                    : `${total.toLocaleString('id-ID')} Sertifikat Terbit`;
            }

            if (visibleItems.length === 0) {
                list.innerHTML = `
                    <div style="text-align:center; padding: 30px 10px; color: #64748b; font-size: 13px;">
                        🔍 Tidak ada peserta yang cocok dengan kata kunci pencarian.
                    </div>
                `;
                if (paginationBox) paginationBox.style.display = 'none';
                return;
            }

            list.innerHTML = visibleItems.map((cert, i) => `
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; margin-bottom: 9px; gap: 12px; box-shadow: 0 2px 6px rgba(0,0,0,0.03);">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span style="background: linear-gradient(135deg, #102f63, #2563eb); color: #ffffff; font-weight: 700; font-size: 11px; padding: 3px 8px; border-radius: 6px;">#${i + 1}</span>
                        <div>
                            <div style="font-weight: 700; font-size: 13.5px; color: #102f63;">${cert.nama}</div>
                            <div style="font-size: 11px; color: #64748b; margin-top: 2px;">NIP: ${cert.nip || '-'} • Terbit: ${cert.created_at ? new Date(cert.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-'}</div>
                        </div>
                    </div>
                    <a href="${cert.file_path}?t=${Date.now()}" target="_blank" style="display: inline-flex; align-items: center; gap: 5px; padding: 7px 14px; background: linear-gradient(135deg, #059669, #10b981); color: #ffffff; border-radius: 8px; font-size: 12px; font-weight: 700; text-decoration: none; box-shadow: 0 3px 10px rgba(5,150,105,0.25); white-space: nowrap;">
                        🎓 Buka Sertifikat ↗
                    </a>
                </div>
            `).join('');

            if (paginationBox && btnMore) {
                if (total > limit) {
                    paginationBox.style.display = 'block';
                    const remaining = total - limit;
                    btnMore.textContent = `Muat 50 Peserta Berikutnya (Sisa ${remaining.toLocaleString('id-ID')})`;
                } else {
                    paginationBox.style.display = 'none';
                }
            }
        }

        function handleSertifikatSearch(query) {
            const q = (query || '').toLowerCase().trim();
            const all = window.__allCertificates || [];
            if (!q) {
                window.__filteredCertificates = all;
            } else {
                window.__filteredCertificates = all.filter(c => 
                    (c.nama && c.nama.toLowerCase().includes(q)) || 
                    (c.nip && String(c.nip).toLowerCase().includes(q))
                );
            }
            window.__certDisplayCount = 50;
            renderSertifikatListItems();
        }

        function renderMoreSertifikat() {
            window.__certDisplayCount = (window.__certDisplayCount || 50) + 50;
            renderSertifikatListItems();
        }

        function downloadAllSertifikatPdf() {
            const meetingId = window.__currentSertifMeetingId || document.getElementById('configMeetingId')?.value;
            if (!meetingId) {
                alert('ID Rapat tidak ditemukan.');
                return;
            }
            const btn = document.getElementById('btnDownloadAllPdf');
            const oldText = btn ? btn.innerHTML : '';
            if (btn) {
                btn.innerHTML = '⏳ Menyiapkan PDF...';
                btn.disabled = true;
                btn.style.opacity = '0.7';
            }

            const downloadUrl = `/api/sertifikat/${meetingId}/download-pdf`;
            window.location.href = downloadUrl;

            setTimeout(() => {
                if (btn) {
                    btn.innerHTML = oldText;
                    btn.disabled = false;
                    btn.style.opacity = '1';
                }
            }, 5000);
        }

        function downloadAllSertifikatZip() {
            const meetingId = window.__currentSertifMeetingId || document.getElementById('configMeetingId')?.value;
            if (!meetingId) {
                alert('ID Rapat tidak ditemukan.');
                return;
            }
            const btn = document.getElementById('btnDownloadAllZip');
            const oldText = btn ? btn.innerHTML : '';
            if (btn) {
                btn.innerHTML = '⏳ Mengompres ZIP...';
                btn.disabled = true;
                btn.style.opacity = '0.7';
            }

            // Arahkan ke endpoint download ZIP
            const downloadUrl = `/api/sertifikat/${meetingId}/download-zip`;
            window.location.href = downloadUrl;

            setTimeout(() => {
                if (btn) {
                    btn.innerHTML = oldText;
                    btn.disabled = false;
                    btn.style.opacity = '1';
                }
            }, 6000);
        }

        async function openSertifikatModal(meetingId, meetingTitle, initialTab = 'list') {
            window.__currentSertifMeetingId = meetingId;
            const modal = document.getElementById('sertifikatModal');
            const subtitle = document.getElementById('sertifikatModalSubtitle');
            const configMId = document.getElementById('configMeetingId');

            if (configMId) configMId.value = meetingId;
            subtitle.textContent = `Agenda: ${meetingTitle || '#' + meetingId}`;
            modal.classList.add('show');

            // Load data dari kartu meeting terkait
            const card = document.querySelector(`.meeting-card[data-meeting-id="${meetingId}"]`);
            const curBg = card?.dataset?.sertifBg || '';
            const curSigner = card?.dataset?.sertifSigner || 'Myrna Amir, S.E., M.M.';
            const curRole = card?.dataset?.sertifSignerRole || 'Kepala Kantor Regional V';
            const curPenyelenggara = card?.dataset?.sertifPenyelenggara || 'Kantor Regional V BKN Jakarta';
            const curEnableTtd = card ? (card.dataset.sertifEnableTtd !== 'false') : true;
            const curLayoutMode = card?.dataset?.sertifLayoutMode || 'full';
            const curFormatNomor = card?.dataset?.sertifFormatNomor || '';
            const inpFormatNomor = document.getElementById('modalSertifFormatNomor');
            if (inpFormatNomor) {
                inpFormatNomor.value = curFormatNomor || generateClientFormatNomor(meetingTitle, card?.dataset?.meetingDate);
            }
            updateModalCertNumberPreview();

            const hidBg = document.getElementById('modalHiddenSertifBg');
            const inpSigner = document.getElementById('modalSertifSigner');
            const inpRole = document.getElementById('modalSertifSignerRole');
            const inpPenyelenggara = document.getElementById('modalSertifPenyelenggara');
            const previewImg = document.getElementById('modalSertifBgPreviewImg');
            const badge = document.getElementById('modalSertifBgBadge');

            if (hidBg) hidBg.value = curBg;
            if (inpSigner) inpSigner.value = curSigner;
            if (inpRole) inpRole.value = curRole;
            if (inpPenyelenggara) inpPenyelenggara.value = curPenyelenggara;

            // Set radio mode layout (default: name_only / Cetak Nama & Kode Unik Saja)
            const effectiveMode = (curLayoutMode === 'full') ? 'full' : 'name_only';
            if (effectiveMode === 'full') {
                const rFull = document.getElementById('layoutModeFull');
                if (rFull) rFull.checked = true;
            } else {
                const rName = document.getElementById('layoutModeNameOnly');
                if (rName) rName.checked = true;
            }
            toggleLayoutModeUI(effectiveMode);

            if (previewImg && badge) {
                if (curBg) {
                    previewImg.src = curBg;
                    badge.textContent = curBg.includes('aksara') ? 'Template AKSARA Vol. 7 Aktif' : 'Template Kustom Aktif';
                    badge.style.background = '#059669';
                } else {
                    previewImg.src = '/images/bg-sertifikat.png';
                    badge.textContent = 'Template Standar BKN';
                    badge.style.background = 'rgba(15,23,42,0.8)';
                }
            }
            const fileInp = document.getElementById('modalSertifBgFile');
            if (fileInp) fileInp.value = '';

            switchSertifTab(initialTab);
            loadSertifikatList(meetingId);
        }

        function toggleModalTtdFields(enabled) {
            const signerBox = document.getElementById('modalSertifSignerBox');
            const noTtdNotice = document.getElementById('noTtdNotice');
            const badgeState = document.getElementById('ttdBadgeState');
            if (enabled) {
                if (signerBox) signerBox.style.display = 'grid';
                if (noTtdNotice) noTtdNotice.style.display = 'none';
                if (badgeState) {
                    badgeState.textContent = 'Aktif';
                    badgeState.style.background = '#dcfce7';
                    badgeState.style.color = '#15803d';
                }
            } else {
                if (signerBox) signerBox.style.display = 'none';
                if (noTtdNotice) noTtdNotice.style.display = 'block';
                if (badgeState) {
                    badgeState.textContent = 'Nonaktif (Tanpa TTD)';
                    badgeState.style.background = '#fef3c7';
                    badgeState.style.color = '#b45309';
                }
            }
        }

        function applySertifPreset(presetType) {
            const hidBg = document.getElementById('modalHiddenSertifBg');
            const previewImg = document.getElementById('modalSertifBgPreviewImg');
            const badge = document.getElementById('modalSertifBgBadge');
            const fileInp = document.getElementById('modalSertifBgFile');
            const ttdBox = document.getElementById('modalSertifEnableTtd');
            const inpPenyelenggara = document.getElementById('modalSertifPenyelenggara');
            if (fileInp) fileInp.value = '';

            if (presetType === 'aksara') {
                if (hidBg) hidBg.value = '/images/bg-aksara-vol7.png';
                if (previewImg) previewImg.src = '/images/bg-aksara-vol7.png';
                if (badge) {
                    badge.textContent = 'Template AKSARA Vol. 7 (Siap Pakai)';
                    badge.style.background = '#2563eb';
                }
                const rName = document.getElementById('layoutModeNameOnly');
                if (rName) rName.checked = true;
                if (ttdBox) {
                    ttdBox.checked = false;
                    toggleModalTtdFields(false);
                }
                if (inpPenyelenggara) inpPenyelenggara.value = 'Kantor Regional V BKN';
                if (typeof showToast === 'function') {
                    showToast('Preset AKSARA Vol. 7 diterapkan (Mode Hanya Cetak Nama & Tanpa TTD)', 'info', 'Preset Diterapkan');
                }
            } else if (presetType === 'bkn_default') {
                resetModalSertifBgToDefault();
                const rFull = document.getElementById('layoutModeFull');
                if (rFull) rFull.checked = true;
                if (ttdBox) {
                    ttdBox.checked = true;
                    toggleModalTtdFields(true);
                }
                if (inpPenyelenggara) inpPenyelenggara.value = 'Kantor Regional V BKN Jakarta';
