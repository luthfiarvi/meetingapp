                if (statusBahan && this.files && this.files[0]) {
                    const fname = this.files[0].name;
                    statusBahan.textContent = `✓ File siap: ${fname.length > 20 ? fname.substring(0, 18) + '...' : fname}`;
                    statusBahan.style.color = '#15803d';
