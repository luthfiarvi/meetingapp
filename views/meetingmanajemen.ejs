        async function handleUploadGalleryPhotos(event) {
            const files = event.target.files;
            if (!files || files.length === 0 || !currentActiveCardForPhotos) return;

            const meetingId = currentActiveCardForPhotos.dataset.meetingId || currentActiveCardForPhotos.querySelector('.meeting-card-title').textContent.trim();
            let photos = await getPhotosForMeeting(meetingId);

            showToast('Sedang membaca dan mengunggah berkas foto...', 'info', 'Mengunggah');

            const readPromises = Array.from(files).map(file => {
                return new Promise(resolve => {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        const now = new Date();
                        const timeStr = `${String(now.getHours()).padStart(2, '0')}.${String(now.getMinutes()).padStart(2, '0')} WIB`;
                        resolve({
                            url: e.target.result,
                            caption: file.name.replace(/\.[^/.]+$/, "").replace(/[-_]/g, ' ') || `Foto Dokumentasi`,
                            time: timeStr
                        });
                    };
                    reader.readAsDataURL(file);
                });
            });

            const newPhotos = await Promise.all(readPromises);
            photos.push(...newPhotos);
            meetingPhotosStore[meetingId] = photos;
            renderGalleryGrid(meetingId);

            event.target.value = '';

            // Simpan foto secara permanen ke server
            try {
                const saveRes = await fetch('/meeting/photos/' + encodeURIComponent(meetingId), {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ photos })
                });
                const saveJson = await saveRes.json();
                if (saveJson.success && Array.isArray(saveJson.data)) {
                    meetingPhotosStore[meetingId] = saveJson.data;
                    renderGalleryGrid(meetingId);

                    // Perbarui visual cover kartu jika belum ada thumbnail manual
                    if (currentActiveCardForPhotos && saveJson.data.length > 0) {
                        const cardImg = currentActiveCardForPhotos.querySelector('.meeting-card-banner img');
                        if (cardImg && (!currentActiveCardForPhotos.dataset.thumbnail || currentActiveCardForPhotos.dataset.thumbnail.trim() === '')) {
                            cardImg.src = saveJson.data[0].url;
                        }
                    }
                }
            } catch (err) {
                console.error("Gagal menyimpan foto ke server:", err);
            }

            showToast('Foto dokumentasi kegiatan berhasil disimpan permanen ke arsip!', 'success', 'Foto Disimpan');
        }

        async function deleteGalleryPhoto(meetingId, index) {
            const confirmed = await showConfirmDialog({
                title: 'Hapus Foto Dokumentasi',
                message: 'Apakah Anda yakin ingin menghapus foto dokumentasi ini dari arsip kegiatan?',
                icon: '🗑️',
                confirmText: 'Ya, Hapus'
            });
            if (confirmed) {
                let photos = await getPhotosForMeeting(meetingId);
                photos.splice(index, 1);
                meetingPhotosStore[meetingId] = photos;
                renderGalleryGrid(meetingId);

                // Sinkronkan penghapusan ke server
                try {
                    const delRes = await fetch('/meeting/photos/' + encodeURIComponent(meetingId), {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ photos })
                    });
                    const delJson = await delRes.json();
                    if (delJson.success && Array.isArray(delJson.data)) {
                        meetingPhotosStore[meetingId] = delJson.data;
                        renderGalleryGrid(meetingId);
                    }
                } catch (err) {
                    console.error("Gagal sinkronisasi penghapusan ke server:", err);
                }

                showToast('Foto dokumentasi telah berhasil dihapus dari arsip.', 'info', 'Foto Dihapus');
            }
        }

