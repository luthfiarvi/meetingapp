        function handleSearchKatalogRapat(query) {
            const q = (query || '').trim().toLowerCase();
            if (!q) {
                renderKatalogRapat(allKatalogMeetings);
                return;
            }
            const filtered = allKatalogMeetings.filter(m => {
                const name = (m.meeting_nama || '').toLowerCase();
                const id = String(m.meeting_id || '');
                const tipe = (m.tipe_meeting || '').toLowerCase();
                return name.includes(q) || id.includes(q) || tipe.includes(q);
            });
            renderKatalogRapat(filtered);
        }

        async function enrollPegawaiMeeting(button, meetingId, meetingName) {
            const originalHtml = button.innerHTML;
            button.disabled = true;
            button.innerHTML = '<span>⏳</span> Menambahkan...';

            try {
                const res = await fetch('/api/pegawai/enroll-meeting', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ meeting_id: meetingId })
                });
                const json = await res.json();
                if (res.ok && json.success) {
                    hasPegawaiEnrolledChanges = true;
                    button.style.background = '#ecfdf5';
                    button.style.color = '#059669';
                    button.style.border = '1px solid #a7f3d0';
                    button.style.boxShadow = 'none';
                    button.innerHTML = '<span>✓</span> Sudah Diikuti';
                    
                    const found = allKatalogMeetings.find(x => String(x.meeting_id) === String(meetingId));
                    if (found) found.is_enrolled = true;

                    if (typeof showToast === 'function') {
                        showToast(`Rapat berhasil ditambahkan ke agenda pribadi Anda!`, 'success', 'Berhasil Menambahkan');
                    }
                } else {
                    button.disabled = false;
                    button.innerHTML = originalHtml;
                    alert('Gagal menambahkan rapat: ' + (json.message || 'Terjadi kesalahan'));
                }
            } catch (err) {
                button.disabled = false;
                button.innerHTML = originalHtml;
                alert('Gagal menghubungi server.');
            }
        }

        async function handleUnenrollPegawaiMeeting(meetingId, meetingTitle) {
            if (!confirm(`Apakah Anda yakin ingin membatalkan keikutsertaan dan menghapus rapat "${meetingTitle}" dari agenda pribadi Anda?`)) {
                return;
            }

            try {
                const res = await fetch('/api/pegawai/unenroll-meeting', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ meeting_id: meetingId })
                });
                const json = await res.json();
