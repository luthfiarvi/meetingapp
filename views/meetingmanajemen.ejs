        async function getPhotosForMeeting(meetingId) {
            if (meetingPhotosStore[meetingId] !== undefined) {
                return meetingPhotosStore[meetingId];
            }
            try {
                const res = await fetch('/meeting/photos/' + encodeURIComponent(meetingId));
                const json = await res.json();
                if (json.success && Array.isArray(json.data)) {
                    meetingPhotosStore[meetingId] = json.data;
                    return meetingPhotosStore[meetingId];
                }
            } catch (e) {
                console.warn("Gagal memuat arsip foto dari server:", e);
            }

            // Jika belum ada foto tersimpan di database, mulai dengan galeri kosong (TIDAK reset ke dummy lagi)
            meetingPhotosStore[meetingId] = [];
            return meetingPhotosStore[meetingId];
        }

