        async function previewCurrentMeetingSertif() {
            const configMId = document.getElementById('configMeetingId');
            const meetingId = configMId ? configMId.value : null;
            if (!meetingId) return;

            const btn = document.getElementById('btnPreviewSertif');
            const origHtml = btn ? btn.innerHTML : '';
            if (btn) {
                btn.innerHTML = '<span>⏳</span> Menyimpan & Menyiapkan Pratinjau...';
                btn.disabled = true;
            }

            try {
                // Selalu simpan otomatis konfigurasi template saat ini terlebih dahulu
                // sehingga apa pun gambar/mode/ttd yang dipilih langsung terlihat di tab preview!
                const saved = await saveMeetingSertifConfig({ silent: true });
                if (!saved) {
                    return; // pesan error sudah ditampilkan oleh saveMeetingSertifConfig
                }
                // Buka tab preview dengan timestamp cache-buster agar tidak di-cache oleh browser
                window.open(`/meeting/sertifikat/preview/${meetingId}?t=${Date.now()}`, '_blank');
            } catch (err) {
                console.warn('Auto-save error before preview:', err);
                if (typeof showToast === 'function') {
                    showToast('Gagal memproses pratinjau: ' + err.message, 'error', 'Error');
                } else {
                    alert('Gagal memproses pratinjau: ' + err.message);
                }
            } finally {
                if (btn) {
                    btn.innerHTML = origHtml;
                    btn.disabled = false;
                }
            }
        }

        async function saveMeetingSertifConfig(options = {}) {
            const { silent = false } = options;
            const configMId = document.getElementById('configMeetingId');
            const meetingId = configMId ? configMId.value : null;
            if (!meetingId) return false;

            const btn = document.getElementById('btnSaveSertifConfig');
            const originalText = btn ? btn.innerHTML : 'Simpan';
            if (btn && !silent) {
                btn.innerHTML = '<span>⏳</span> Menyimpan...';
                btn.disabled = true;
            }

            const sertifikat_bg = document.getElementById('modalHiddenSertifBg')?.value || '';
            const sertifikat_signer = document.getElementById('modalSertifSigner')?.value.trim() || '';
            const sertifikat_signer_role = document.getElementById('modalSertifSignerRole')?.value.trim() || '';
            const sertifikat_penyelenggara = document.getElementById('modalSertifPenyelenggara')?.value.trim() || '';
            const sertifikat_enable_ttd = true;
            const sertifikat_layout_mode = document.querySelector('input[name="modalSertifLayoutMode"]:checked')?.value || 'full';
            const sertifikat_format_nomor = document.getElementById('modalSertifFormatNomor')?.value.trim() || '';

            try {
                const res = await fetch('/updatemeeting', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        meeting_id: meetingId,
                        sertifikat_bg,
                        sertifikat_signer,
                        sertifikat_signer_role,
                        sertifikat_penyelenggara,
                        sertifikat_enable_ttd,
                        sertifikat_layout_mode,
                        sertifikat_format_nomor
                    })
                });
                const result = await res.json();
                if (result.success) {
                    if (!silent) {
                        if (typeof showToast === 'function') {
                            showToast('Pengaturan template sertifikat webinar berhasil diperbarui!', 'success', 'Template Tersimpan');
                        } else {
                            alert('Pengaturan template sertifikat webinar berhasil diperbarui!');
                        }
                    }

                    const savedBg = result.data?.sertifikat_bg || sertifikat_bg;
                    const hidBg = document.getElementById('modalHiddenSertifBg');
                    if (hidBg && savedBg) hidBg.value = savedBg;

                    const card = document.querySelector(`.meeting-card[data-meeting-id="${meetingId}"]`);
                    if (card) {
                        if (savedBg) card.dataset.sertifBg = savedBg;
                        if (sertifikat_signer) card.dataset.sertifSigner = sertifikat_signer;
                        if (sertifikat_signer_role) card.dataset.sertifSignerRole = sertifikat_signer_role;
                        if (sertifikat_penyelenggara) card.dataset.sertifPenyelenggara = sertifikat_penyelenggara;
                        card.dataset.sertifEnableTtd = sertifikat_enable_ttd ? 'true' : 'false';
                        card.dataset.sertifLayoutMode = sertifikat_layout_mode;
                        card.dataset.sertifFormatNomor = sertifikat_format_nomor;
                    }

                    const previewImg = document.getElementById('modalSertifBgPreviewImg');
                    if (previewImg && savedBg) {
                        previewImg.src = savedBg;
                    }

                    const badge = document.getElementById('modalSertifBgBadge');
                    if (badge) {
                        badge.textContent = 'Template Tersimpan Aktif';
                        badge.style.background = '#059669';
                    }

                    const fileInp = document.getElementById('modalSertifBgFile');
                    if (fileInp) fileInp.value = '';

                    loadSertifikatList(meetingId);
                    return true;
                } else {
                    const msg = result.message || 'Gagal menyimpan template';
                    if (typeof showToast === 'function') {
                        showToast(msg, 'error', 'Gagal');
                    } else {
                        alert(msg);
                    }
                    return false;
                }
            } catch (err) {
                console.error('Error saving sertif config:', err);
                const msg = 'Terjadi kesalahan saat menyimpan: ' + err.message;
                if (typeof showToast === 'function') {
                    showToast(msg, 'error', 'Error');
                } else {
                    alert(msg);
                }
                return false;
            } finally {
                if (btn && !silent) {
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            }
        }

