                videoBtn.download = `Video_${title.substring(0, 20)}.mp4`;
            } else {
                videoBtn.href = "#";
            }

            // Link ke form presensi
            const meetingId = card.dataset.meetingId || '1';
            const presensiLinkBtn = document.getElementById('btnOpenPresensiForm');
            if (presensiLinkBtn) {
                presensiLinkBtn.href = '/presensi/' + meetingId;
            }

            // Tampilkan tombol Forum Q&A & Kuis Interaktif (Slido BKN) HANYA untuk tipe Webinar
            const webinarBtn = document.getElementById('btnWebinarQa');
            if (webinarBtn) {
                const tipeMeeting = (card.dataset.tipeMeeting || badge || '').toLowerCase().trim();
                const isWebinar = tipeMeeting.includes('webinar');

                if (isWebinar) {
