        function switchWebinarTab(tab) {
            const tabList = document.getElementById('tabContentQaList');
            const tabZoom = document.getElementById('tabContentZoomChat');
            const tabQuiz = document.getElementById('tabContentQuiz');

            const btnList = document.getElementById('tabBtnQaList');
            const btnZoom = document.getElementById('tabBtnZoomChat');
            const btnQuiz = document.getElementById('tabBtnQuiz');

            // Reset tab styles
            [btnList, btnZoom, btnQuiz].forEach(b => {
                b.style.color = '#64748b';
                b.style.borderBottom = '2px solid transparent';
                b.style.fontWeight = '600';
            });

            // Hide all contents
            tabList.style.display = 'none';
            tabZoom.style.display = 'none';
            tabQuiz.style.display = 'none';

            if (tab === 'list') {
                tabList.style.display = 'block';
                btnList.style.color = '#7c3aed';
                btnList.style.borderBottom = '2px solid #7c3aed';
                btnList.style.fontWeight = '700';
