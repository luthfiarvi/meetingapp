                                        <div style="display:flex; justify-content:flex-end; gap:6px; margin-top:6px;">
                                            <button type="button" onclick="toggleEditAnswer(${q.id})" style="background:#f1f5f9; border:none; padding:4px 8px; font-size:11px; border-radius:4px; cursor:pointer;">Batal</button>
