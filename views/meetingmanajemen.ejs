        function renderQuizResultsTab(activeQuiz, quizResults) {
            const container = document.getElementById('quizResultsContainer');
            if (!activeQuiz) {
                container.innerHTML = '<p style="font-size:12.5px; color:#64748b; margin:0;">Belum ada kuis atau polling aktif saat ini. Anda dapat membuatnya melalui formulir di atas.</p>';
                return;
            }

            const results = quizResults || [];
            const totalVotes = results.reduce((acc, r) => acc + parseInt(r.total_votes || 0), 0);

            let optionsHtml = '';
            const options = activeQuiz.opsi_jawaban || [];

            options.forEach(opt => {
                const optResult = results.find(r => r.selected_option === opt);
                const votes = optResult ? parseInt(optResult.total_votes) : 0;
                const pct = totalVotes > 0 ? Math.round((votes / totalVotes) * 100) : 0;

                optionsHtml += `
                <div style="margin-bottom:10px;">
                    <div style="display:flex; justify-content:space-between; font-size:12.5px; font-weight:600; color:#1e293b; margin-bottom:4px;">
                        <span>${escapeHtml(opt)}</span>
                        <span>${pct}% (${votes} suara)</span>
                    </div>
                    <div style="height:10px; background:#f1f5f9; border-radius:999px; overflow:hidden;">
                        <div style="width:${pct}%; height:100%; background:linear-gradient(90deg, #c026d3, #7c3aed); border-radius:999px; transition:width 0.4s ease;"></div>
                    </div>
                </div>
            `;
            });

            container.innerHTML = `
            <div style="background:#fdf4ff; border:1px solid #f0abfc; border-radius:10px; padding:14px; margin-bottom:10px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                    <span style="background:#fae8ff; color:#a21caf; font-size:11px; font-weight:800; padding:2px 8px; border-radius:999px; text-transform:uppercase;">● KUIS SEDANG AKTIF</span>
                    <span style="font-size:12px; font-weight:700; color:#4a044e;">Total: ${totalVotes} Suara Masuk</span>
                </div>
                <h5 style="margin:0 0 12px 0; font-size:14px; font-weight:700; color:#3b0764;">${escapeHtml(activeQuiz.judul_kuis)}</h5>
                <div>${optionsHtml}</div>
            </div>
        `;
        }

