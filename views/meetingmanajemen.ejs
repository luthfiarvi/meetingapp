                            }
                        }, 300);
                    } else {
                        window.location.reload();
                    }
                } else {
                    alert('Gagal menghapus rapat: ' + (json.message || 'Terjadi kesalahan'));
                }
            } catch (err) {
                alert('Gagal menghubungi server.');
            }
        }



