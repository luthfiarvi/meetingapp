                                <textarea id="zoomChatPertanyaan" required rows="3" placeholder="Tuliskan pertanyaan peserta yang ada di chat Zoom..." style="width: 100%; padding: 8px 12px; font-size: 13px; border: 1px solid #cbd5e1; border-radius: 8px; box-sizing: border-box; resize: vertical;"></textarea>
