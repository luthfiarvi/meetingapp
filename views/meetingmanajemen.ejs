                    if (typeof showToast === 'function') {
                        showToast(`Rapat "${meetingTitle}" berhasil dihapus dari agenda Anda.`, 'info', 'Dihapus dari Agenda');
                    }
                    const card = document.querySelector(`.meeting-card[data-meeting-id="${meetingId}"]`);
                    if (card) {
                        card.style.transition = 'all 0.3s ease';
                        card.style.opacity = '0';
                        card.style.transform = 'scale(0.95)';
                        setTimeout(() => {
                            card.remove();
                            const remaining = document.querySelectorAll('.meeting-card');
                            if (remaining.length === 0) {
