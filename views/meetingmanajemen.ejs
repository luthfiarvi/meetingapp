                const res = await fetch('/api/webinar-quiz/answer', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        id: qId,
                        jawaban: input.value.trim()
                    })
                });
                const data = await res.json();
                if (data.success) {
                    showToast('Jawaban berhasil diperbarui!', 'success', 'Tersimpan');
                    loadWebinarQaData();
                } else {
                    showToast(data.message || 'Gagal menyimpan jawaban', 'error', 'Gagal');
                }
            } catch (err) {
                showToast(err.message, 'error', 'Kesalahan Sistem');
            }
        }

