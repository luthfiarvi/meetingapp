                }
            }

            // Tampilkan informasi Zoom jika ada
            const zoomLink = card.dataset.zoomLink;
            const zoomId = card.dataset.zoomId;
            const zoomPass = card.dataset.zoomPass;
            const zoomBox = document.getElementById('viewZoomBox');
            if (zoomBox) {
                if (zoomLink && zoomLink.trim() !== '') {
