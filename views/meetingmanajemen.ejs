<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Meeting | Meeting App BKN</title>
    <link rel="stylesheet" href="/dashboard.css">
</head>

<body>

    <div class="dashboard">

        <!-- ANIMASI EMBLEM BKN BACKGROUND (1 KANAN ATAS & 1 KIRI BAWAH) -->
        <div class="bubble bubble-top-right"></div>
        <div class="bubble bubble-bottom-left"></div>

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="brand">
                <div class="brand-info">
                    <div class="brand-logo">
                        <img src="/logo-bkn-asli.png" alt="Logo BKN">
                    </div>
                    <div class="brand-text">
                        <h2>Meeting App</h2>
                        <span>BKN Regional V</span>
                    </div>
                </div>
                <button type="button" class="btn-sidebar-toggle" id="btnSidebarToggle"
                    title="Kecilkan Sidebar (Perluas Tampilan Tengah)" onclick="toggleSidebar()">
                    <svg class="toggle-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 18l-6-6 6-6" />
                    </svg>
                </button>
            </div>

            <nav class="menu">
                <a href="/dashboard" class="menu-item" data-tooltip="Dashboard">
                    <span>🏠</span>
                    <span>Dashboard</span>
                </a>

                <% if (typeof user !=='undefined' && user && user.role==='admin' ) { %>
                    <a href="/manajemenuser" class="menu-item" data-tooltip="Manajemen User">
                        <span>👥</span>
                        <span>Manajemen User</span>
                    </a>
                    <% } %>

                        <a href="/manajemenmeeting" class="menu-item active" data-tooltip="Manajemen Meeting">
                            <span>📋</span>
                            <span>Manajemen Meeting</span>
                        </a>

                        <% if (typeof user === 'undefined' || !user || user.role !== 'pegawai') { %>
                        <a href="/request-zoom" class="menu-item" data-tooltip="Request Zoom">
                            <span>📹</span>
                            <span>Request Zoom</span>
                        </a>

                        <a href="/infografis" class="menu-item" data-tooltip="App Infografis">
                            <span>📊</span>
                            <span>App Infografis</span>
                        </a>

                        <a href="/manual-book" class="menu-item" data-tooltip="Manual Book">
                            <span>📖</span>
                            <span>Manual Book</span>
                        </a>
                        <% } %>
            </nav>

            <div class="sidebar-bottom">
                <a href="/" class="logout" onclick="showLogoutModal(event)">
                    <span>↪</span>
                    Keluar
                </a>
            </div>

        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">

            <!-- MANAGEMENT TOP BAR -->
            <section class="management-top-bar">
                <div class="management-title-wrapper">
                    <div class="management-icon-badge">
                        📑
                    </div>
                    <div class="management-title-text">
                        <h1><%= (typeof user !== 'undefined' && user && user.role === 'pegawai') ? 'Agenda Rapat Saya' : 'Manajemen Meeting' %></h1>
                        <p><%= (typeof user !== 'undefined' && user && user.role === 'pegawai') ? 'Daftar agenda ruang rapat yang Anda ikuti' : 'Halaman untuk menambah, edit dan kelola daftar meeting BKN' %></p>
                    </div>
                </div>

                <div class="management-actions"
                    style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">

                    <% if (typeof user !== 'undefined' && user && user.role === 'pegawai') { %>
                        <!-- KHUSUS USER PEGAWAI: TOMBOL TAMBAH RAPAT KE AGENDA PRIBADI -->
                        <button type="button" class="btn-add-primary" onclick="openPilihRapatPegawaiModal()"
                            style="background: linear-gradient(135deg, #4f46e5 0%, #2563eb 100%); display: inline-flex; align-items: center; gap: 0.5rem; box-shadow: 0 4px 14px rgba(79, 70, 229, 0.3); white-space: nowrap; cursor: pointer; border: none; padding: 0.65rem 1.15rem; font-weight: 700; font-size: 0.875rem; border-radius: 0.625rem; color: #fff;"
                            title="Pilih & tambahkan ruang rapat ke agenda pribadi Anda">
                            <span style="font-size: 1.1rem; line-height: 1;">＋</span>
                            <span>Tambah Rapat</span>
                        </button>
                    <% } %>

                    <div class="search-box-wrapper">
                        <span class="search-icon">🔍</span>
                        <input type="text" id="searchMeeting" placeholder="Cari Meeting..." onkeyup="filterMeetings()">
                    </div>

                    <% if (typeof user !=='undefined' && user && user.role==='admin' ) { %>
                        <!-- KHUSUS ADMIN (TIM KERJA SIDIGI) -->
                        <a href="/request-zoom"
                            style="background: linear-gradient(135deg, #0ea5e9, #0284c7); color: white; border: none; border-radius: 0.625rem; padding: 0.65rem 1.15rem; font-weight: 700; font-size: 0.875rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25); white-space: nowrap; transition: all 0.2s ease;">
                            <span>📋</span>
                            <span>Lihat Pengajuan Zoom</span>
                            <% if (typeof pendingZoomCount !=='undefined' && pendingZoomCount> 0) { %>
                                <span
                                    style="background: #ef4444; color: white; border-radius: 9999px; padding: 0.15rem 0.55rem; font-size: 0.75rem; font-weight: 800;">
                                    <%= pendingZoomCount %>
                                </span>
                                <% } %>
                        </a>

                        <button type="button" class="btn-add-primary" onclick="openMeetingModal()">
                            ＋ Tambah Meeting
                        </button>
                        <% } else if (typeof user === 'undefined' || !user || user.role !== 'pegawai') { %>
                            <!-- KHUSUS USER TIM (DIVISI LAIN) -->
                            <a href="/request-zoom" class="btn-add-primary"
                                style="background: linear-gradient(135deg, #0284c7 0%, #2563eb 100%); text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3); white-space: nowrap;"
                                title="Ajukan permohonan lisensi/jadwal rapat Zoom ke Tim Kerja Sidigi">
                                <span>📹</span>
                                <span>Request Zoom Meeting</span>
                            </a>
                        <% } %>
                </div>
            </section>

            <!-- FILTER & EXPORT TOOLBAR -->
            <section class="meeting-filter-toolbar">
                <div class="filter-controls-group">
                    <!-- Filter Jenis Rapat -->
                    <div class="filter-item">
                        <label for="filterMeetingType" class="filter-label">
                            <span>🏷️</span> Jenis Rapat
                        </label>
                        <select id="filterMeetingType" class="filter-input-control" onchange="filterMeetings()">
                            <option value="all">Semua Jenis Rapat</option>
                            <option value="offline">🏢 Rapat Offline</option>
                            <option value="zoom">📹 Zoom Biasa</option>
                            <option value="webinar">🎓 Webinar</option>
                        </select>
                    </div>

                    <!-- Filter Tanggal Mulai -->
                    <div class="filter-item">
                        <label for="filterStartDate" class="filter-label">
                            <span>📅</span> Dari Tanggal
                        </label>
                        <input type="date" id="filterStartDate" class="filter-input-control"
                            onchange="filterMeetings()">
                    </div>

                    <!-- Filter Tanggal Selesai -->
                    <div class="filter-item">
                        <label for="filterEndDate" class="filter-label">
                            <span>📅</span> Sampai Tanggal
                        </label>
                        <input type="date" id="filterEndDate" class="filter-input-control" onchange="filterMeetings()">
                    </div>

                    <!-- Tombol Reset Filter -->
                    <div class="filter-item">
                        <label class="filter-label" style="visibility: hidden;">Aksi</label>
                        <button type="button" class="btn-filter-reset" onclick="resetMeetingFilters()"
                            title="Reset semua filter">
                            <span>🔄</span>
                            <span>Reset</span>
                        </button>
                    </div>
                </div>

                <div class="filter-actions-group">
                    <span class="filter-counter-badge" id="filterCounterBadge">
                        Menampilkan <strong id="filterMeetingCount">
                            <%= (typeof meetings !=='undefined' && meetings) ? meetings.length : 0 %>
                        </strong> Rapat
                    </span>

                    <button type="button" class="btn-export-excel" onclick="exportMeetingsToExcel()"
                        title="Cetak / Unduh riwayat rapat ke format Excel sesuai filter">
                        <span class="excel-icon">📊</span>
                        <span>Printout Excel Riwayat</span>
                    </button>
                </div>
            </section>

            <!-- CARDS GRID (3 KOLOM SAMPAI SELESAI) -->
            <section class="meeting-cards-grid" id="meetingGrid">

                <% if (typeof meetings !=='undefined' && meetings && meetings.length> 0) { %>
                    <% meetings.forEach(function(m) { %>
                        <% 
                            let tipeDisplay = m.tipe_meeting || m.m_tipe || 'Rapat Offline';
                            if (tipeDisplay === '1') tipeDisplay = 'Rapat Offline';
                            else if (tipeDisplay === '2') tipeDisplay = 'Zoom';
                            else if (tipeDisplay === '3') tipeDisplay = 'Webinar';

                            let formattedTgl = '21 Agustus 2026';
                            let rawIsoDate = '';
                            if (m.tanggal) {
                                if (typeof m.tanggal === 'string' && m.tanggal.match(/^\d{4}-\d{2}-\d{2}/)) {
                                    rawIsoDate = m.tanggal.substring(0, 10);
                                    const parts = rawIsoDate.split('-');
                                    const dObj = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
                                    formattedTgl = !isNaN(dObj.getTime())
                                        ? dObj.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
                                        : rawIsoDate;
                                } else {
                                    const d = new Date(m.tanggal);
                                    if (!isNaN(d.getTime())) {
                                        const y = d.getFullYear();
                                        const mo = String(d.getMonth() + 1).padStart(2, '0');
                                        const dt = String(d.getDate()).padStart(2, '0');
                                        rawIsoDate = `${y}-${mo}-${dt}`;
                                        formattedTgl = d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
                                    } else {
                                        formattedTgl = m.tanggal;
                                    }
                                }
                            }

                            let currentUserId = (typeof user !== 'undefined' && user) ? (user.id || user.username || '') : '';
                            let currentUserNip = (typeof user !== 'undefined' && user) ? (user.nip || '') : '';
                            let currentUserName = (typeof user !== 'undefined' && user) ? (user.full_name || user.nama || '') : '';
                            let currentUserRole = (typeof user !== 'undefined' && user) ? (user.role || 'user') : 'user';

                            // Identitas pemohon/pembuat rapat dari berbagai kolom rapat & pengajuan zoom
                            let creatorCandidates = [
                                m.creator_user_id,
                                m.pembuat,
                                m.user_id,
                                m.zoom_nip,
                                m.zoom_pemohon
                            ].filter(Boolean).map(s => String(s).trim().toLowerCase());

                            // Identitas akun pengguna yang sedang login
                            let userIdentifiers = [
                                currentUserId,
                                user ? user.username : '',
                                currentUserNip,
                                currentUserName
                            ].filter(Boolean).map(s => String(s).trim().toLowerCase());

                            let isCreatorMatch = (currentUserRole === 'admin') || 
                                (creatorCandidates.length === 0) || 
                                creatorCandidates.some(c => userIdentifiers.some(u => u === c || c.includes(u) || u.includes(c)));

                            let meetingCreator = m.creator_user_id || m.pembuat || m.user_id || '';
                            let canManageMeeting = (typeof user !== 'undefined' && user && user.role !== 'pegawai') ? true : false;
                            let safeMeetingTitle = (m.meeting_nama || m.m_nama || 'Agenda Rapat BKN').replace(/"/g, '&quot;');
                            let safeMeetingDesc = (m.deskripsi || '').replace(/"/g, '&quot;');
                            let safeCreator = (meetingCreator || 'Admin BKN').replace(/"/g, '&quot;');

                            let wMulai = m.waktu_mulai || '';
                            let wSelesai = m.waktu_selesai || '';
                            if (!wMulai && m.deskripsi) {
                                const matchMulai = m.deskripsi.match(/Waktu:\s*(\d{1,2}[:.]\d{2})/i);
                                if (matchMulai) wMulai = matchMulai[1];
                            }
                            if (!wSelesai && m.deskripsi) {
                                const matchSelesai = m.deskripsi.match(/-\s*(\d{1,2}[:.]\d{2})/i);
                                if (matchSelesai) wSelesai = matchSelesai[1];
                            }
                            if (wMulai) wMulai = wMulai.replace(':', '.');
                            if (wSelesai) wSelesai = wSelesai.replace(':', '.');

                            let isZoomActive = true;
                            let zoomPillLabel = 'Zoom Aktif';
                            let zoomPillClass = 'zoom-status-active';

                            const nowUtc = new Date().getTime() + (new Date().getTimezoneOffset() * 60000);
                            const nowWIB = new Date(nowUtc + (7 * 3600000));
                            const y = nowWIB.getFullYear();
                            const mo = String(nowWIB.getMonth() + 1).padStart(2, '0');
                            const dt = String(nowWIB.getDate()).padStart(2, '0');
                            const todayStr = `${y}-${mo}-${dt}`;
                            const curHM = `${String(nowWIB.getHours()).padStart(2, '0')}:${String(nowWIB.getMinutes()).padStart(2, '0')}`;
                            const startHM = wMulai ? wMulai.replace('.', ':') : '';
                            const endHM = wSelesai ? wSelesai.replace('.', ':') : '23:59';

                            if (rawIsoDate) {
                                if (todayStr < rawIsoDate) {
                                    isZoomActive = false;
                                    zoomPillLabel = 'Belum Aktif';
                                    zoomPillClass = 'zoom-status-upcoming';
                                } else if (todayStr === rawIsoDate) {
                                    if (startHM && curHM < startHM) {
                                        isZoomActive = false;
                                        zoomPillLabel = 'Belum Aktif';
                                        zoomPillClass = 'zoom-status-upcoming';
                                    } else if (endHM && curHM > endHM) {
                                        isZoomActive = false;
                                        zoomPillLabel = 'Zoom Selesai';
                                        zoomPillClass = 'zoom-status-finished';
                                    } else {
                                        isZoomActive = true;
                                        zoomPillLabel = 'Zoom Aktif';
                                        zoomPillClass = 'zoom-status-active';
                                    }
                                } else {
                                    isZoomActive = false;
                                    zoomPillLabel = 'Zoom Selesai';
                                    zoomPillClass = 'zoom-status-finished';
                                }
                            } else {
                                zoomPillLabel = 'Belum Aktif';
                                zoomPillClass = 'zoom-status-upcoming';
                            }
                        %>
                        <div class="meeting-card" 
                             data-meeting-id="<%= m.meeting_id || m.m_id || m.id %>"
                             data-tipe-meeting="<%= tipeDisplay %>"
                             data-date="<%= rawIsoDate %>"
                             data-formatted-date="<%= formattedTgl %>"
                             data-title="<%= safeMeetingTitle %>"
                             data-creator="<%= safeCreator %>"
                             data-can-manage="<%= canManageMeeting ? 'true' : 'false' %>"
                             data-zoom-link="<%= m.zoom_link || '' %>"
                             data-zoom-id="<%= m.zoom_meeting_id || '' %>"
                             data-zoom-pass="<%= m.zoom_passcode || '' %>"
                             data-zoom-request-id="<%= m.zoom_request_id || '' %>"
                             data-waktu-mulai="<%= wMulai %>"
                             data-waktu-selesai="<%= wSelesai %>"
                             data-thumbnail="<%= m.thumbnail || '' %>"
                             data-pdf-url="<%= m.notulen_pdf || m.notulen || '' %>"
                             data-bahan-rapat="<%= m.bahan_rapat || '' %>"
                             data-video-url="<%= m.video_url || '' %>"
                             data-absensi="<%= m.absensi || '' %>"
                             data-sertif-bg="<%= m.sertifikat_bg || '' %>"
                             data-sertif-signer="<%= m.sertifikat_signer || 'Myrna Amir, S.E., M.M.' %>"
                             data-sertif-signer-role="<%= m.sertifikat_signer_role || 'Kepala Kantor Regional V' %>"
                             data-sertif-penyelenggara="<%= m.sertifikat_penyelenggara || 'Kantor Regional V BKN Jakarta' %>"
                             data-sertif-enable-ttd="<%= m.sertifikat_enable_ttd !== false ? 'true' : 'false' %>"
                             data-sertif-layout-mode="<%= m.sertifikat_layout_mode || 'full' %>"
                             data-sertif-format-nomor="<%= m.sertifikat_format_nomor || '' %>"
                             data-meeting-date="<%= m.tanggal ? new Date(m.tanggal).toISOString() : '' %>"
                             data-desc="<%= safeMeetingDesc %>">
                            <div class="meeting-card-banner">
                                <img src="<%= m.thumbnail || 'https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?q=80&w=600&auto=format&fit=crop' %>" alt="Meeting BKN" onerror="this.onerror=null; this.src='/logo-bkn-asli.png'; this.style.objectFit='contain'; this.style.padding='20px'; this.style.background='linear-gradient(135deg, #0d2b5c, #2563eb)';">
                                <span class="meeting-card-badge"><%= tipeDisplay %></span>

                                    <% if (m.zoom_link && m.zoom_link.trim() !=='' ) { %>
                                        <a href="<%= m.zoom_link %>" target="_blank" class="card-zoom-float-badge"
                                            onclick="event.stopPropagation();" title="Buka tautan Zoom Meeting resmi">
                                            <span>📹</span>
                                            <span>Link Zoom ↗</span>
                                        </a>
                                        <% } %>
                                </div>
                                <div class="meeting-card-content">
                                    <h3 class="meeting-card-title">
                                        <%= m.meeting_nama || m.m_nama || 'Agenda Rapat BKN' %>
                                    </h3>
                                    <p class="meeting-card-meta">📅 Tanggal: <%= formattedTgl %>
                                    </p>

                                    <% if (m.zoom_link && m.zoom_link.trim() !=='' ) { %>
                                        <div class="card-zoom-pill-wrapper">
                                            <a href="<%= m.zoom_link %>" target="_blank"
                                                class="card-zoom-pill-link <%= zoomPillClass %>"
                                                title="Buka ruang rapat Zoom resmi BKN">
                                                <span class="pill-left">
                                                    <% if (isZoomActive) { %>
                                                        <span class="pulsing-dot"></span>
                                                        <span>📹</span>
                                                        <span class="zoom-status-text">
                                                            <%= zoomPillLabel %>
                                                        </span>
                                                        <% } else if (zoomPillClass==='zoom-status-upcoming' ) { %>
                                                            <span class="upcoming-clock">⏰</span>
                                                            <span class="zoom-status-text">
                                                                <%= zoomPillLabel %>
                                                            </span>
                                                            <% } else { %>
                                                                <span class="finished-check">✓</span>
                                                                <span class="zoom-status-text">
                                                                    <%= zoomPillLabel %>
                                                                </span>
                                                                <% } %>
                                                </span>
                                                <span class="pill-right">Buka Zoom ↗</span>
                                            </a>
                                        </div>
                                        <% } %>

                                            <p class="meeting-card-desc" style="display:none;">
                                                <%= m.deskripsi || 'Pembahasan agenda rutin BKN Regional V.' %>
                                            </p>
                                            <div class="meeting-card-actions">
                                                <button type="button" class="btn-card-view"
                                                    onclick="openViewModal(this)">
                                                    👁️ View
                                                </button>
                                                <button type="button" class="btn-card-presensi"
                                                    onclick="handleLihatPresensi(this, '<%= m.meeting_id || m.m_id || m.id %>')">
                                                    📝 Lihat Presensi
                                                </button>
                                                <% if (canManageMeeting) { %>
                                                    <button type="button" class="btn-card-edit"
                                                        onclick="openEditModal(this)">
                                                        ✏️ Edit
                                                    </button>
                                                    <% } %>
                                                        <% if (tipeDisplay &&
                                                            String(tipeDisplay).toLowerCase().includes('webinar')) { %>
                                                            <button type="button" class="btn-card-sertif"
                                                                onclick="openSertifikatModal('<%= m.meeting_id %>', '<%= safeMeetingTitle %>', 'list')">
                                                                📜 Sertifikat
                                                            </button>
                                                            <% if (canManageMeeting) { %>
                                                            <button type="button" class="btn-card-action"
                                                                style="background:#fffbeb; color:#b45309; border:1px solid #fde68a; font-weight:700; border-radius:8px; font-size:11.5px; padding:6px 10px; cursor:pointer;"
                                                                onclick="openSertifikatModal('<%= m.meeting_id %>', '<%= safeMeetingTitle %>', 'config')"
                                                                title="Atur Desain Background & Penandatangan E-Sertifikat">
                                                                🎨 Template
                                                            </button>
                                                            <% } %>
                                                            <% } %>
                                                            <button type="button" class="btn-card-bahan"
                                                                onclick="openBahanRapatModal(this, '<%= m.meeting_id || m.m_id || m.id %>', '<%= safeMeetingTitle %>')"
                                                                title="Lihat Bahan Rapat">
                                                                📁 Bahan Rapat
                                                            </button>

                                                            <% if (typeof user !== 'undefined' && user && user.role === 'pegawai') { %>
                                                            <button type="button" class="btn-card-unenroll"
                                                                onclick="handleUnenrollPegawaiMeeting('<%= m.meeting_id || m.m_id || m.id %>', '<%= safeMeetingTitle %>')"
                                                                title="Hapus rapat ini dari agenda pribadi saya">
                                                                ❌ Batal Ikuti
                                                            </button>
                                                            <% } %>
                                            </div>
                                </div>
                            </div>
                            <% }); %>
                                <% } else if (typeof user !== 'undefined' && user && user.role === 'pegawai') { %>
                                    <!-- EMPTY STATE KHUSUS PEGAWAI BELUM IKUT RAPAT -->
                                    <div id="pegawaiEmptyAgenda" style="grid-column: 1 / -1; text-align: center; padding: 60px 24px; background: #ffffff; border-radius: 20px; border: 2px dashed #cbd5e1; box-shadow: 0 4px 20px rgba(0,0,0,0.03); margin: 12px 0 30px;">
                                        <div style="width: 72px; height: 72px; line-height: 72px; margin: 0 auto 16px; background: #eef2ff; border-radius: 20px; font-size: 36px;">
                                            📅
                                        </div>
                                        <h2 style="font-size: 19px; font-weight: 800; color: #1e293b; margin-bottom: 8px;">
                                            Agenda Rapat Anda Masih Kosong
                                        </h2>
                                        <p style="font-size: 14px; color: #64748b; max-width: 480px; margin: 0 auto 24px; line-height: 1.6;">
                                            Anda belum menambahkan ruang rapat ke agenda pribadi. Silakan klik tombol di bawah untuk memilih rapat yang ingin Anda ikuti.
                                        </p>
                                        <button type="button" onclick="openPilihRapatPegawaiModal()"
                                            style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 28px; background: linear-gradient(135deg, #4f46e5 0%, #2563eb 100%); color: #ffffff; border: none; border-radius: 12px; font-size: 14px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 16px rgba(79, 70, 229, 0.35); transition: all 0.2s;">
                                            <span style="font-size: 18px; line-height: 1;">＋</span>
                                            <span>Pilih & Tambah Rapat Sekarang</span>
                                        </button>
                                    </div>
                                <% } %>

                                    <!-- EMPTY STATE NOT FOUND -->
                                    <div id="noMeetingMatch"
                                        style="display: none; grid-column: 1 / -1; text-align: center; padding: 48px 24px; background: #ffffff; border-radius: 16px; border: 2px dashed #cbd5e1; margin-top: 10px;">
                                        <div style="font-size: 42px; margin-bottom: 12px;">🔍</div>
                                        <h3
                                            style="font-size: 17px; font-weight: 700; color: #1e293b; margin-bottom: 6px;">
                                            Tidak Ada Rapat Ditemukan</h3>
                                        <p style="font-size: 13.5px; color: #64748b; margin-bottom: 16px;">Tidak ada
