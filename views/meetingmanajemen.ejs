<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Meeting | Meeting App BKN</title>
    <link rel="stylesheet" href="/dashboard.css">
</head>

<body>

    <div class="dashboard">

        <!-- ANIMASI EMBLEM BKN BACKGROUND (1 KANAN ATAS & 1 KIRI BAWAH) -->
        <div class="bubble bubble-top-right"></div>
        <div class="bubble bubble-bottom-left"></div>

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="brand">
                <div class="brand-info">
                    <div class="brand-logo">
                        <img src="/logo-bkn-asli.png" alt="Logo BKN">
                    </div>
                    <div class="brand-text">
                        <h2>Meeting App</h2>
                        <span>BKN Regional V</span>
                    </div>
                </div>
                <button type="button" class="btn-sidebar-toggle" id="btnSidebarToggle" title="Kecilkan Sidebar (Perluas Tampilan Tengah)" onclick="toggleSidebar()">
                    <svg class="toggle-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 18l-6-6 6-6"/>
                    </svg>
                </button>
            </div>

            <nav class="menu">
                <a href="/dashboard" class="menu-item" data-tooltip="Dashboard">
                    <span>🏠</span>
                    <span>Dashboard</span>
                </a>

                <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                <a href="/manajemenuser" class="menu-item" data-tooltip="Manajemen User">
                    <span>👥</span>
                    <span>Manajemen User</span>
                </a>
                <% } %>

                <a href="/manajemenmeeting" class="menu-item active" data-tooltip="Manajemen Meeting">
                    <span>📋</span>
                    <span>Manajemen Meeting</span>
                </a>

                <a href="/request-zoom" class="menu-item" data-tooltip="Request Zoom">
                    <span>📹</span>
                    <span>Request Zoom</span>
                </a>

                <a href="/infografis" class="menu-item" data-tooltip="App Infografis">
                    <span>📊</span>
                    <span>App Infografis</span>
                </a>

                <a href="/manual-book" class="menu-item" data-tooltip="Manual Book">
                    <span>📖</span>
                    <span>Manual Book</span>
                </a>
            </nav>

            <div class="sidebar-bottom">
                <div class="help-box">
                    <span class="help-icon">?</span>
                    <div>
                        <strong>Butuh bantuan?</strong>
                        <p>Hubungi administrator sistem.</p>
                    </div>
                </div>

                <a href="/" class="logout" onclick="showLogoutModal(event)">
                    <span>↪</span>
                    Keluar
                </a>
            </div>

        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">

            <!-- MANAGEMENT TOP BAR -->
            <section class="management-top-bar">
                <div class="management-title-wrapper">
                    <div class="management-icon-badge">
                        📑
                    </div>
                    <div class="management-title-text">
                        <h1>Manajemen Meeting</h1>
                        <p>Halaman untuk menambah, edit dan kelola daftar meeting BKN</p>
                    </div>
                </div>

                <div class="management-actions" style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                    <div class="search-box-wrapper">
                        <span class="search-icon">🔍</span>
                        <input type="text" id="searchMeeting" placeholder="Cari Meeting..." onkeyup="filterMeetings()">
                    </div>

                    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                        <!-- KHUSUS ADMIN (TIM KERJA SIDIGI) -->
                        <a href="/request-zoom" style="background: linear-gradient(135deg, #0ea5e9, #0284c7); color: white; border: none; border-radius: 0.625rem; padding: 0.65rem 1.15rem; font-weight: 700; font-size: 0.875rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25); white-space: nowrap; transition: all 0.2s ease;">
                            <span>📋</span>
                            <span>Lihat Pengajuan Zoom</span>
                            <% if (typeof pendingZoomCount !== 'undefined' && pendingZoomCount > 0) { %>
                                <span style="background: #ef4444; color: white; border-radius: 9999px; padding: 0.15rem 0.55rem; font-size: 0.75rem; font-weight: 800;">
                                    <%= pendingZoomCount %>
                                </span>
                            <% } %>
                        </a>

                        <button type="button" class="btn-add-primary" onclick="openMeetingModal()">
                            ＋ Tambah Meeting
                        </button>
                    <% } else { %>
                        <!-- KHUSUS USER (DIVISI LAIN) -->
                        <a href="/request-zoom" class="btn-add-primary" style="background: linear-gradient(135deg, #0284c7 0%, #2563eb 100%); text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3); white-space: nowrap;" title="Ajukan permohonan lisensi/jadwal rapat Zoom ke Tim Kerja Sidigi">
                            <span>📹</span>
                            <span>Request Zoom Meeting</span>
                        </a>
                    <% } %>
                </div>
            </section>

            <!-- CARDS GRID (3 KOLOM SAMPAI SELESAI) -->
            <section class="meeting-cards-grid" id="meetingGrid">

                <% if (typeof meetings !== 'undefined' && meetings && meetings.length > 0) { %>
                    <% meetings.forEach(function(m) { %>
                        <% 
                            let tipeDisplay = m.tipe_meeting || m.m_tipe || 'Rapat Offline';
                            if (tipeDisplay === '1') tipeDisplay = 'Rapat Offline';
                            else if (tipeDisplay === '2') tipeDisplay = 'Zoom';
                            else if (tipeDisplay === '3') tipeDisplay = 'Webinar';
                            
                            let formattedTgl = '21 Agustus 2026';
                            if (m.tanggal) {
                                const d = new Date(m.tanggal);
                                formattedTgl = !isNaN(d) ? d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : m.tanggal;
                            }
                        %>
                        <div class="meeting-card" 
                             data-meeting-id="<%= m.meeting_id || m.m_id || m.id %>"
                             data-tipe-meeting="<%= tipeDisplay %>"
                             data-title="<%= m.meeting_nama || m.m_nama || 'Agenda Rapat BKN' %>"
                             data-zoom-link="<%= m.zoom_link || '' %>"
                             data-zoom-id="<%= m.zoom_meeting_id || '' %>"
                             data-zoom-pass="<%= m.zoom_passcode || '' %>"
                             data-zoom-request-id="<%= m.zoom_request_id || '' %>"
                             data-thumbnail="<%= m.thumbnail || '' %>"
                             data-pdf-url="<%= m.notulen_pdf || '' %>"
                             data-video-url="<%= m.video_url || '' %>">
                            <div class="meeting-card-banner">
                                <img src="<%= m.thumbnail || 'https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?q=80&w=600&auto=format&fit=crop' %>" alt="Meeting BKN" onerror="this.onerror=null; this.src='/logo-bkn-asli.png'; this.style.objectFit='contain'; this.style.padding='20px'; this.style.background='linear-gradient(135deg, #0d2b5c, #2563eb)';">
                                <span class="meeting-card-badge"><%= tipeDisplay %></span>
                            </div>
                            <div class="meeting-card-content">
                                <h3 class="meeting-card-title"><%= m.meeting_nama || m.m_nama || 'Agenda Rapat BKN' %></h3>
                                <p class="meeting-card-meta">📅 Tanggal: <%= formattedTgl %></p>
                                <p class="meeting-card-desc" style="display:none;"><%= m.deskripsi || 'Pembahasan agenda rutin BKN Regional V.' %></p>
                                <div class="meeting-card-actions">
                                    <button type="button" class="btn-card-view" onclick="openViewModal(this)">
                                        👁️ View
                                    </button>
                                    <button type="button" class="btn-card-presensi" onclick="window.location.href='/daftar-presensi/' + this.closest('.meeting-card').dataset.meetingId">
                                        📝 Lihat Presensi
                                    </button>
                                    <button type="button" class="btn-card-edit" onclick="openEditModal(this)">
                                        ✏️ Edit
                                    </button>
                                    <button type="button" class="btn-card-sertif" onclick="openSertifikatModal(this.closest('.meeting-card').dataset.meetingId, this.closest('.meeting-card').dataset.title)">
                                        📜 Lihat Sertifikat
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } %>

                
                

            </section>

            <footer>
                Meeting App • Kantor Regional V BKN Jakarta • 2026
            </footer>

        </main>

    </div>

    <!-- MODAL TAMBAH MEETING -->
    <div class="meeting-modal" id="meetingModal">
        <div class="meeting-modal-content">
            <button type="button" class="modal-close" id="closeMeetingModal">×</button>

            <div class="modal-title">
                <div class="modal-icon">📅</div>
                <div>
                    <h2>Tambah Meeting Baru</h2>
                    <p>Lengkapi informasi agenda rapat BKN</p>
                </div>
            </div>

            <form action="/inputmeeting" method="POST" id="meetingForm">
                <div class="modal-form-group">
                    <label for="meetingName">Nama Meeting</label>
                    <input type="text" id="meetingName" name="m_nama" placeholder="Masukkan Nama Meetingnya..." required>
                </div>

                <div class="modal-form-group">
                    <label for="meetingDescription">Deskripsi Meeting</label>
                    <textarea id="meetingDescription" name="deskripsi" rows="3" placeholder="Masukkan deskripsi singkat meeting..."></textarea>
                </div>

                <div class="modal-form-row">
                    <div class="modal-form-group">
                        <label for="meetingDate">Tanggal Meeting</label>
                        <input type="date" id="meetingDate" name="tanggal" required>
                    </div>

                    <div class="modal-form-group">
                        <label for="meetingType">Tipe Meeting</label>
                        <select id="meetingType" name="m_tipe" required>
                            <option value="">Pilih Tipe Meeting</option>
                            <option value="Rapat Offline">Rapat Offline</option>
                            <option value="Zoom">Zoom</option>
                            <option value="Webinar">Webinar</option>
                        </select>
                    </div>
                </div>

                <div class="modal-actions">
                    <button type="button" class="modal-cancel" id="cancelMeetingModal">Batal</button>
                    <button type="submit" class="modal-save">✓ Simpan Meeting</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL VIEW DETAIL MEETING -->
    <div class="meeting-modal" id="viewMeetingModal">
        <div class="meeting-modal-content">
            <button type="button" class="modal-close" onclick="closeViewModal()">×</button>

            <div class="modal-title">
                <div class="modal-icon">👁️</div>
                <div>
                    <h2>Detail Meeting</h2>
                    <p>Informasi lengkap agenda rapat & unduhan berkas</p>
                </div>
            </div>

            <div style="margin-bottom: 16px; border-radius: 12px; overflow: hidden; height: 180px; background:#f1f5f9;">
                <img id="viewImage" src="" alt="Meeting" style="width:100%; height:100%; object-fit:cover;" onerror="this.onerror=null; this.src='/logo-bkn-asli.png'; this.style.objectFit='contain'; this.style.padding='20px'; this.style.background='linear-gradient(135deg, #0d2b5c, #2563eb)';">
            </div>

            <div class="modal-form-group">
                <span id="viewBadge" class="meeting-card-badge" style="position:static; display:inline-block; margin-bottom:10px;"></span>
                <h3 id="viewTitle" style="font-size: 16px; color:#0d2b5c; font-weight:700; margin-bottom: 8px;"></h3>
                <p id="viewDate" style="font-size: 12px; color:#64748b; margin-bottom: 14px; font-weight:600;"></p>
                <div style="background:#f8fafc; padding: 14px; border-radius: 10px; border:1px solid #e2e8f0; margin-bottom: 16px;">
                    <strong style="font-size: 12px; color:#334155;">Deskripsi Rapat:</strong>
                    <p id="viewDesc" style="font-size: 13px; color:#475569; margin-top: 4px; line-height: 1.5;"></p>
                </div>

                <!-- INFORMASI TAUTAN ZOOM RESMI (JIKA ADA) -->
                <div id="viewZoomBox" style="display:none; background: linear-gradient(135deg, #eff6ff, #dbeafe); border: 1px solid #bfdbfe; border-radius: 12px; padding: 14px; margin-bottom: 16px;">
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px; flex-wrap:wrap; gap:8px;">
                        <span style="font-size:12.5px; font-weight:700; color:#1e40af; display:inline-flex; align-items:center; gap:6px;">
                            <span>📹</span> Tautan Zoom Meeting Resmi
                        </span>
                        <div style="display:flex; gap:6px;">
                            <button type="button" onclick="copyViewZoomLink()" style="background:#ffffff; color:#1d4ed8; border:1px solid #bfdbfe; border-radius:6px; padding:5px 10px; font-size:11.5px; font-weight:700; cursor:pointer; display:inline-flex; align-items:center; gap:4px;">
                                📋 Salin Tautan
                            </button>
                            <a id="btnOpenViewZoom" href="#" target="_blank" style="background:#2563eb; color:#ffffff; border-radius:6px; padding:5px 12px; font-size:11.5px; font-weight:700; text-decoration:none; display:inline-flex; align-items:center; gap:4px; box-shadow:0 2px 6px rgba(37,99,235,0.25);">
                                Buka Zoom ↗
                            </a>
                        </div>
                    </div>
                    <input type="text" id="viewZoomLinkInput" readonly style="width:100%; font-size:11.5px; padding:6px 10px; border:1px solid #93c5fd; border-radius:6px; background:#ffffff; color:#1e293b; font-family:monospace; box-sizing:border-box; outline:none;" value="">
                    <div id="viewZoomCredentials" style="display:flex; gap:16px; font-size:12px; color:#334155; margin-top:8px; font-weight:600;">
                        <span id="viewZoomMeetingId"></span>
                        <span id="viewZoomPasscode"></span>
                    </div>
                </div>

                <!-- BERKAS UNDUHAN NOTULEN & VIDEO -->
                <div style="background:#f0f7ff; padding: 16px; border-radius: 12px; border: 1px solid #bfdbfe;">
                    <strong style="font-size: 13px; color:#1e40af; display:block; margin-bottom: 10px;">📄 Berkas & Dokumentasi Rapat:</strong>
                    <div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:12px;">
                        <a id="btnDownloadPdf" href="#" download="Notulen_Rapat_BKN.pdf" onclick="triggerPdfDownload(event)" style="flex:1; min-width:180px; display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:10px 14px; background:#2563eb; color:#ffffff; border-radius:10px; font-size:12px; font-weight:600; text-decoration:none; box-shadow: 0 4px 12px rgba(37,99,235,0.25); transition: 0.2s;">
                            📄 Unduh Notulen (PDF)
                        </a>
                        <a id="btnDownloadVideo" href="#" download="Dokumentasi_Rapat_BKN.mp4" onclick="triggerVideoDownload(event)" style="flex:1; min-width:180px; display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:10px 14px; background:#059669; color:#ffffff; border-radius:10px; font-size:12px; font-weight:600; text-decoration:none; box-shadow: 0 4px 12px rgba(5,150,105,0.25); transition: 0.2s;">
                            🎬 Unduh Video Rapat
                        </a>
                    </div>
                    <button type="button" id="btnViewPhotos" onclick="openPhotoGalleryModal()" style="width:100%; display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:12px 16px; background:linear-gradient(135deg, #f59e0b, #d97706); color:#ffffff; border:none; border-radius:10px; font-size:12.5px; font-weight:700; cursor:pointer; box-shadow: 0 4px 14px rgba(217,119,6,0.25); transition: 0.2s; margin-bottom:10px;">
                        📸 Lihat Dokumentasi Lengkap Kegiatan (Foto-Foto)
                    </button>
                    <a id="btnOpenPresensiForm" href="#" target="_blank" style="width:100%; display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:11px 16px; background:#eff6ff; color:#1d4ed8; border:1px solid #bfdbfe; border-radius:10px; font-size:12.5px; font-weight:700; text-decoration:none; transition: 0.2s;">
                        ✍️ Buka Link Form Presensi Peserta ↗
                    </a>
                    <a id="btnWebinarQa" href="#" target="_blank" style="display:none; width:100%; align-items:center; justify-content:center; gap:8px; padding:12px 16px; background:linear-gradient(135deg, #7c3aed, #6366f1); color:#ffffff; border:none; border-radius:10px; font-size:12.5px; font-weight:700; text-decoration:none; cursor:pointer; box-shadow: 0 4px 14px rgba(99,102,241,0.25); transition: 0.2s; margin-top:10px; box-sizing: border-box;">
                        <span>💬</span> Forum Q&A & Kuis Interaktif (Slido BKN) ↗
                    </a>
                </div>
            </div>

            <div class="modal-actions" style="margin-top: 20px;">
                <button type="button" class="modal-cancel" onclick="closeViewModal()" style="width:100%;">Tutup</button>
            </div>
        </div>
    </div>

    <!-- MODAL GALERI DOKUMENTASI FOTO KEGIATAN LENGKAP -->
    <div class="meeting-modal" id="photoGalleryModal" style="z-index: 10500;">
        <div class="meeting-modal-content" style="max-width: 880px; width: 92%; max-height: 88vh; display:flex; flex-direction:column;">
            <button type="button" class="modal-close" onclick="closePhotoGalleryModal()">×</button>

            <div class="modal-title" style="margin-bottom: 14px;">
                <div class="modal-icon" style="background:#fef3c7; color:#d97706;">📸</div>
                <div>
                    <h2>Dokumentasi Foto Kegiatan Rapat</h2>
                    <p id="galleryMeetingSubtitle" style="color:#64748b;">Arsip foto resmi saat pelaksanaan kegiatan rapat di lingkungan BKN</p>
                </div>
            </div>

            <!-- Action Bar -->
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; flex-wrap:wrap; gap:10px; padding:12px 16px; background:#f8fafc; border-radius:10px; border:1px solid #e2e8f0;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <span style="font-size:12px; font-weight:700; color:#334155;">Arsip Foto:</span>
                    <span id="galleryPhotoCount" style="font-size:11px; font-weight:700; background:#dbeafe; color:#1d4ed8; padding:3px 10px; border-radius:9999px;">4 Foto</span>
                </div>
                <label style="margin:0; font-size:12px; font-weight:600; padding:8px 14px; cursor:pointer; background:#2563eb; color:#ffffff; border-radius:8px; display:inline-flex; align-items:center; gap:6px; box-shadow: 0 2px 8px rgba(37,99,235,0.25);">
                    <span>＋ Unggah Foto Dokumentasi Baru</span>
                    <input type="file" id="uploadGalleryPhotoInput" accept="image/*" multiple style="display:none;" onchange="handleUploadGalleryPhotos(event)">
                </label>
            </div>

            <!-- Grid Foto -->
            <div id="galleryPhotoGrid" style="flex:1; overflow-y:auto; display:grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap:16px; padding:6px; margin-bottom:14px; max-height:60vh; align-items:start; grid-auto-rows:max-content;">
                <!-- Populated dynamically -->
            </div>

            <div class="modal-actions" style="margin-top: 10px; border-top:1px solid #f1f5f9; padding-top:12px;">
                <button type="button" class="modal-cancel" onclick="closePhotoGalleryModal()" style="width:100%;">Tutup Galeri Foto</button>
            </div>
        </div>
    </div>

    <!-- MODAL LIGHTBOX PREVIEW FOTO BESAR -->
    <div class="meeting-modal" id="photoLightboxModal" style="z-index: 11000; background: rgba(15,23,42,0.9); backdrop-filter: blur(6px); display:none; align-items:center; justify-content:center;">
        <div style="position:relative; max-width:92vw; max-height:92vh; display:flex; flex-direction:column; align-items:center; justify-content:center; margin:auto;">
            <button type="button" onclick="closeLightboxModal()" style="position:absolute; top:-40px; right:0; background:rgba(255,255,255,0.2); border:none; color:#ffffff; font-size:24px; width:36px; height:36px; border-radius:50%; cursor:pointer; display:flex; align-items:center; justify-content:center; line-height:1;">×</button>
            <img id="lightboxImage" src="" alt="Pratinjau Foto" style="max-width:88vw; max-height:76vh; border-radius:10px; object-fit:contain; box-shadow:0 12px 40px rgba(0,0,0,0.6); background:#000;">
            <div style="margin-top:14px; display:flex; align-items:center; justify-content:space-between; width:100%; max-width:88vw; color:#ffffff; flex-wrap:wrap; gap:10px;">
                <div id="lightboxCaption" style="font-size:14px; font-weight:600; text-shadow: 0 1px 2px rgba(0,0,0,0.8);"></div>
                <a id="lightboxDownloadBtn" href="#" download="Dokumentasi_Rapat_BKN.jpg" style="padding:7px 16px; background:#2563eb; color:#fff; border-radius:8px; font-size:12px; font-weight:600; text-decoration:none; box-shadow: 0 2px 8px rgba(37,99,235,0.4);">⬇ Unduh Foto</a>
            </div>
        </div>
    </div>

    <!-- MODAL EDIT MEETING (DILEBARKAN KANAN-KIRI) -->
    <div class="meeting-modal" id="editMeetingModal">
        <div class="meeting-modal-content">
            <button type="button" class="modal-close" onclick="closeEditModal()">×</button>

            <div class="modal-title">
                <div class="modal-icon">✏️</div>
                <div>
                    <h2>Edit Meeting</h2>
                    <p>Perbarui informasi agenda rapat, hasil notulen PDF & video dokumentasi</p>
                </div>
            </div>

            <form id="editMeetingForm">
                <div class="modal-form-group">
                    <label for="editName">Nama Meeting</label>
                    <input type="text" id="editName" required>
                </div>

                <div class="modal-form-group">
                    <label for="editDescription">Deskripsi Meeting</label>
                    <textarea id="editDescription" rows="3"></textarea>
                </div>

                <div class="modal-form-row">
                    <div class="modal-form-group">
                        <label for="editDate">Tanggal Meeting</label>
                        <input type="text" id="editDate" required>
                    </div>

                    <div class="modal-form-group">
                        <label for="editType">Tipe Meeting</label>
                        <select id="editType" required>
                            <option value="Rapat Offline">Rapat Offline</option>
                            <option value="Zoom">Zoom</option>
                            <option value="Webinar">Webinar</option>
                        </select>
                    </div>
                </div>

                <div class="modal-form-row">
                    <div class="modal-form-group">
                        <label for="editThumbnail">Ganti Foto Thumbnail (Opsional)</label>
                        <input type="file" id="editThumbnail" accept="image/*">
                    </div>

                    <div class="modal-form-group">
                        <label for="editNotulenPdf">Upload Hasil Notulen Rapat (PDF)</label>
                        <input type="file" id="editNotulenPdf" accept=".pdf">
                    </div>
                </div>

                <div class="modal-form-group">
                    <label for="editVideoFile">Upload Video Dokumentasi Rapat (MP4 / WebM)</label>
                    <input type="file" id="editVideoFile" accept="video/*">
                </div>

                <div class="modal-actions">
                    <button type="button" class="modal-cancel" onclick="closeEditModal()">Batal</button>
                    <button type="submit" class="modal-save">✓ Update Meeting</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL LIHAT SERTIFIKAT MEETING -->
    <div class="meeting-modal" id="sertifikatModal">
        <div class="meeting-modal-content" style="max-width: 620px;">
            <button type="button" class="modal-close" onclick="closeSertifikatModal()">×</button>

            <div class="modal-title">
