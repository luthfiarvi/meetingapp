        // Auto-update zoom pill statuses dynamically based on client device time
        function updateCardZoomPills() {
            const cards = document.querySelectorAll('.meeting-card');
            const now = new Date();
            const y = now.getFullYear();
            const mo = String(now.getMonth() + 1).padStart(2, '0');
            const dt = String(now.getDate()).padStart(2, '0');
            const todayStr = `${y}-${mo}-${dt}`;
            const curHM = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

            cards.forEach(card => {
                const pillLink = card.querySelector('.card-zoom-pill-link');
                if (!pillLink) return;

                const rawIsoDate = (card.dataset.date || '').trim();
                let wMulai = (card.dataset.waktuMulai || '').trim();
                let wSelesai = (card.dataset.waktuSelesai || '').trim();

                if (!wMulai && card.dataset.desc) {
                    const mMulai = card.dataset.desc.match(/Waktu:\s*(\d{1,2}[:.]\d{2})/i);
                    if (mMulai) wMulai = mMulai[1];
                }
                if (!wSelesai && card.dataset.desc) {
                    const mSelesai = card.dataset.desc.match(/-\s*(\d{1,2}[:.]\d{2})/i);
                    if (mSelesai) wSelesai = mSelesai[1];
                }
                if (wMulai) wMulai = wMulai.replace(':', '.');
                if (wSelesai) wSelesai = wSelesai.replace(':', '.');

                const startHM = wMulai ? wMulai.replace('.', ':') : '';
                const endHM = wSelesai ? wSelesai.replace('.', ':') : '23:59';

                let isZoomActive = true;
                let pillLabel = 'Zoom Aktif';
                let pillClass = 'zoom-status-active';

                if (rawIsoDate) {
                    if (todayStr < rawIsoDate) {
                        isZoomActive = false;
                        pillLabel = 'Belum Aktif';
                        pillClass = 'zoom-status-upcoming';
                    } else if (todayStr === rawIsoDate) {
                        if (startHM && curHM < startHM) {
                            isZoomActive = false;
                            pillLabel = 'Belum Aktif';
                            pillClass = 'zoom-status-upcoming';
                        } else if (endHM && curHM > endHM) {
                            isZoomActive = false;
                            pillLabel = 'Zoom Selesai';
                            pillClass = 'zoom-status-finished';
                        } else {
                            isZoomActive = true;
                            pillLabel = 'Zoom Aktif';
                            pillClass = 'zoom-status-active';
                        }
                    } else {
                        isZoomActive = false;
                        pillLabel = 'Zoom Selesai';
                        pillClass = 'zoom-status-finished';
                    }
                } else {
                    pillLabel = 'Belum Aktif';
                    pillClass = 'zoom-status-upcoming';
                }

                pillLink.classList.remove('zoom-status-active', 'zoom-status-upcoming', 'zoom-status-finished');
                pillLink.classList.add(pillClass);

                const pillLeft = pillLink.querySelector('.pill-left');
                if (pillLeft) {
                    if (isZoomActive) {
                        pillLeft.innerHTML = `<span class="pulsing-dot"></span> <span>📹</span> <span class="zoom-status-text">${pillLabel}</span>`;
                    } else if (pillClass === 'zoom-status-upcoming') {
                        pillLeft.innerHTML = `<span class="upcoming-clock">⏰</span> <span class="zoom-status-text">${pillLabel}</span>`;
                    } else {
                        pillLeft.innerHTML = `<span class="finished-check">✓</span> <span class="zoom-status-text">${pillLabel}</span>`;
                    }
                }
            });
        }

        // Auto-focus & open modal for target meeting ID from URL parameter (e.g. ?meetingId=17)
        document.addEventListener("DOMContentLoaded", function () {
            try {
                updateCardZoomPills();
                setInterval(updateCardZoomPills, 30000);
            } catch (pillErr) {
                console.warn("Update zoom pill error:", pillErr);
            }

            try {
                const urlParams = new URLSearchParams(window.location.search);
                const successMsg = urlParams.get('msg');
                const errorMsg = urlParams.get('error');
                if (successMsg && typeof showToast === 'function') {
                    showToast(successMsg, 'success', 'Berhasil');
                    window.history.replaceState({}, document.title, window.location.pathname);
                } else if (errorMsg && typeof showToast === 'function') {
                    showToast(errorMsg, 'error', 'Perhatian');
                    window.history.replaceState({}, document.title, window.location.pathname);
                }

                const targetMeetingId = urlParams.get('meetingId');
                if (targetMeetingId) {
                    const card = document.querySelector(`.meeting-card[data-meeting-id="${targetMeetingId}"]`);
                    if (card) {
                        setTimeout(() => {
                            card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            card.style.outline = '3px solid #2563eb';
                            card.style.boxShadow = '0 0 24px rgba(37, 99, 235, 0.45)';
                            card.style.transition = 'all 0.5s ease';

                            const viewBtn = card.querySelector('.btn-card-action.view') || card.querySelector('button[onclick*="openViewModal"]');
                            if (viewBtn) {
                                openViewModal(viewBtn);
                            } else {
                                openViewModal(card);
                            }

                            setTimeout(() => {
                                card.style.outline = '';
                            }, 4500);
                        }, 350);
                    }
                }
            } catch (navErr) {
                console.warn("Auto-focus meeting error:", navErr);
            }
        });
    </script>
    <script src="/js/sidebar.js"></script>
</body>

</html>