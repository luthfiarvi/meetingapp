            if (groupAbsensi) {
                groupAbsensi.style.display = (this.value === 'Rapat Offline') ? 'block' : 'none';
            }
        });

        function closeEditModal() {
            document.getElementById('editMeetingModal').classList.remove('show');
            activeCardForEdit = null;
        }

        function readFileAsBase64(file) {
            return new Promise((resolve, reject) => {
                if (!file) return resolve(null);
                const reader = new FileReader();
                reader.onload = (e) => resolve(e.target.result);
                reader.onerror = (e) => reject(e);
                reader.readAsDataURL(file);
            });
        }

        document.getElementById('editMeetingForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            if (!activeCardForEdit) return;
            const targetCard = activeCardForEdit;
            const meetingId = targetCard.dataset.meetingId;

            const name = document.getElementById('editName').value.trim();
            const date = document.getElementById('editDate').value.trim();
            const type = document.getElementById('editType').value.trim();
            const desc = document.getElementById('editDescription').value.trim();
            const zoomLinkVal = document.getElementById('editZoomLink').value.trim();
            const zoomIdVal = document.getElementById('editZoomMeetingId').value.trim();
            const zoomPassVal = document.getElementById('editZoomPasscode').value.trim();
            const fileInput = document.getElementById('editThumbnail');
            const pdfInput = document.getElementById('editNotulenPdf');
            const videoInput = document.getElementById('editVideoFile');
            const bahanInput = document.getElementById('editBahanRapatFile');

            // Button loading state
            const saveBtn = this.querySelector('.modal-save');
            const originalText = saveBtn.textContent;
            saveBtn.disabled = true;
            saveBtn.textContent = '⏳ Menyimpan...';

            try {
                // Read files asynchronously
                let thumbnailBase64 = null;
                if (fileInput.files && fileInput.files[0]) {
                    thumbnailBase64 = await readFileAsBase64(fileInput.files[0]);
                    // Instant optimistic visual feedback on card
                    targetCard.querySelector('.meeting-card-banner img').src = thumbnailBase64;
                }

                let pdfBase64 = null;
                if (pdfInput.files && pdfInput.files[0]) {
                    pdfBase64 = await readFileAsBase64(pdfInput.files[0]);
                }

                let videoBase64 = null;
                if (videoInput && videoInput.files && videoInput.files[0]) {
                    videoBase64 = await readFileAsBase64(videoInput.files[0]);
                }

                let bahanBase64 = null;
                let bahanFileName = null;
                if (bahanInput && bahanInput.files && bahanInput.files[0]) {
                    bahanBase64 = await readFileAsBase64(bahanInput.files[0]);
                    bahanFileName = bahanInput.files[0].name;
                }

                const absensiInput = document.getElementById('editAbsensiFile');
                let absensiBase64 = null;
                if (absensiInput && absensiInput.files && absensiInput.files[0]) {
                    absensiBase64 = await readFileAsBase64(absensiInput.files[0]);
                }

                // Send update payload to server
                const payload = {
                    meeting_id: meetingId,
                    m_nama: name,
                    deskripsi: desc,
                    tanggal: date,
                    m_tipe: type,
                    zoom_link: zoomLinkVal,
                    zoom_meeting_id: zoomIdVal,
                    zoom_passcode: zoomPassVal
                };
                if (thumbnailBase64) payload.thumbnail = thumbnailBase64;
                if (pdfBase64) payload.notulen_pdf = pdfBase64;
                if (bahanBase64) {
                    payload.bahan_rapat = bahanBase64;
                    payload.bahan_rapat_name = bahanFileName;
                }
                if (videoBase64) payload.video_url = videoBase64;
                if (absensiBase64) payload.absensi = absensiBase64;

                const response = await fetch('/updatemeeting', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    targetCard.querySelector('.meeting-card-title').textContent = name;
                    targetCard.querySelector('.meeting-card-badge').textContent = type;
                    targetCard.querySelector('.meeting-card-meta').textContent = `📅 Tanggal: ${date}`;
                    if (targetCard.querySelector('.meeting-card-desc')) {
                        targetCard.querySelector('.meeting-card-desc').textContent = desc;
                    }

                    // Update dataset
                    targetCard.dataset.title = name;
                    targetCard.dataset.tipeMeeting = type;
                    targetCard.dataset.zoomLink = zoomLinkVal;
                    targetCard.dataset.zoomId = zoomIdVal;
                    targetCard.dataset.zoomPass = zoomPassVal;

                    // Update UI Zoom badges & pill
                    let bannerZoomBtn = targetCard.querySelector('.card-zoom-float-badge');
                    let pillZoomWrap = targetCard.querySelector('.card-zoom-pill-wrapper');
                    if (zoomLinkVal) {
                        if (!bannerZoomBtn) {
                            const banner = targetCard.querySelector('.meeting-card-banner');
                            if (banner) {
                                const newBadge = document.createElement('a');
                                newBadge.href = zoomLinkVal;
                                newBadge.target = '_blank';
                                newBadge.className = 'card-zoom-float-badge';
                                newBadge.title = 'Buka tautan Zoom Meeting resmi';
                                newBadge.innerHTML = '<span>📹</span> <span>Link Zoom ↗</span>';
                                newBadge.onclick = (e) => e.stopPropagation();
                                banner.appendChild(newBadge);
                            }
                        } else {
                            bannerZoomBtn.href = zoomLinkVal;
                            bannerZoomBtn.style.display = 'inline-flex';
                        }

                        if (!pillZoomWrap) {
                            const content = targetCard.querySelector('.meeting-card-content');
                            const actions = targetCard.querySelector('.meeting-card-actions');
                            if (content && actions) {
                                const newWrap = document.createElement('div');
                                newWrap.className = 'card-zoom-pill-wrapper';
                                newWrap.innerHTML = `
                                    <a href="${zoomLinkVal}" target="_blank" class="card-zoom-pill-link" title="Buka ruang rapat Zoom resmi BKN">
                                        <span class="pill-left">
                                            <span class="pulsing-dot"></span>
                                            <span>📹 Zoom Aktif</span>
                                        </span>
                                        <span class="pill-right">Buka Zoom ↗</span>
                                    </a>
                                `;
                                content.insertBefore(newWrap, actions);
                            }
                        } else {
                            const pillLink = pillZoomWrap.querySelector('.card-zoom-pill-link');
                            if (pillLink) pillLink.href = zoomLinkVal;
                            pillZoomWrap.style.display = 'block';
                        }
                    } else {
                        if (bannerZoomBtn) bannerZoomBtn.style.display = 'none';
                        if (pillZoomWrap) pillZoomWrap.style.display = 'none';
                    }

                    if (result.data?.thumbnail) {
                        targetCard.querySelector('.meeting-card-banner img').src = result.data.thumbnail;
                        targetCard.dataset.thumbnail = result.data.thumbnail;
                    }
                    const updatedPdf = result.data?.notulen_pdf || result.data?.notulen;
                    if (updatedPdf) {
                        targetCard.dataset.pdfUrl = updatedPdf;
                    }
                    if (result.data?.video_url) {
                        targetCard.dataset.videoUrl = result.data.video_url;
                    }
                    if (result.data?.absensi) {
                        targetCard.dataset.absensi = result.data.absensi;
                    }
                    if (result.data?.bahan_rapat) {
                        targetCard.dataset.bahanRapat = result.data.bahan_rapat;
                    }

                    // Sinkronisasi tombol Lihat Sertifikat (khusus Webinar)
                    const cardActions = targetCard.querySelector('.meeting-card-actions');
                    let sertifBtn = targetCard.querySelector('.btn-card-sertif');
                    const isNowWebinar = type && type.toLowerCase().includes('webinar');
                    if (isNowWebinar) {
                        if (!sertifBtn && cardActions) {
                            sertifBtn = document.createElement('button');
                            sertifBtn.type = 'button';
                            sertifBtn.className = 'btn-card-sertif';
                            sertifBtn.innerHTML = '📜 Lihat Sertifikat';
                            const mId = targetCard.dataset.meetingId;
                            const mTitle = targetCard.dataset.title;
                            sertifBtn.onclick = function () {
                                openSertifikatModal(mId, mTitle);
                            };
                            cardActions.appendChild(sertifBtn);
                        }
                    } else {
                        if (sertifBtn) {
                            sertifBtn.remove();
                        }
                    }

                    showToast('Data Meeting dan Tautan Zoom berhasil diperbarui!', 'success', 'Perubahan Disimpan');
                    closeEditModal();
                } else {
                    showToast(result.message || 'Gagal memperbarui meeting.', 'error', 'Gagal Simpan');
                }
            } catch (err) {
                console.error('Error updating meeting:', err);
                showToast('Terjadi kesalahan saat memperbarui meeting.', 'error', 'Koneksi Terganggu');
            } finally {
                saveBtn.disabled = false;
                saveBtn.textContent = originalText;
            }
        });

        function filterMeetings() {
            const searchInput = (document.getElementById('searchMeeting') ? document.getElementById('searchMeeting').value : '').toLowerCase().trim();
            const typeFilter = (document.getElementById('filterMeetingType') ? document.getElementById('filterMeetingType').value : 'all').toLowerCase();
            const startDate = document.getElementById('filterStartDate') ? document.getElementById('filterStartDate').value : '';
            const endDate = document.getElementById('filterEndDate') ? document.getElementById('filterEndDate').value : '';

            const cards = document.querySelectorAll('.meeting-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const title = (card.dataset.title || card.querySelector('.meeting-card-title')?.textContent || '').toLowerCase();
                const meta = (card.querySelector('.meeting-card-meta')?.textContent || '').toLowerCase();
                const desc = (card.dataset.desc || '').toLowerCase();
                const rawType = (card.dataset.tipeMeeting || card.querySelector('.meeting-card-badge')?.textContent || '').toLowerCase();
                const cardDate = card.dataset.date || '';

                // 1. Cek tipe meeting
                let matchesType = false;
                if (typeFilter === 'all') {
                    matchesType = true;
                } else if (typeFilter === 'offline') {
                    matchesType = rawType.includes('offline') || rawType.includes('tatap');
                } else if (typeFilter === 'zoom') {
                    matchesType = rawType.includes('zoom') && !rawType.includes('webinar');
                } else if (typeFilter === 'webinar') {
                    matchesType = rawType.includes('webinar');
                }

                // 2. Cek tanggal
                let matchesDate = true;
                if (startDate) {
                    if (!cardDate || cardDate < startDate) matchesDate = false;
                }
                if (endDate) {
                    if (!cardDate || cardDate > endDate) matchesDate = false;
                }

                // 3. Cek pencarian kata kunci
                let matchesSearch = true;
                if (searchInput) {
                    matchesSearch = title.includes(searchInput) ||
                        meta.includes(searchInput) ||
                        desc.includes(searchInput) ||
                        rawType.includes(searchInput);
                }

                if (matchesType && matchesDate && matchesSearch) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // Update badge hitungan jumlah
            const countEl = document.getElementById('filterMeetingCount');
            if (countEl) countEl.textContent = visibleCount;

            // Tampilkan empty state jika tidak ada yang cocok
            const emptyEl = document.getElementById('noMeetingMatch');
            if (emptyEl) {
                emptyEl.style.display = (visibleCount === 0 && cards.length > 0) ? 'block' : 'none';
            }
        }

        function resetMeetingFilters() {
            if (document.getElementById('searchMeeting')) document.getElementById('searchMeeting').value = '';
            if (document.getElementById('filterMeetingType')) document.getElementById('filterMeetingType').value = 'all';
            if (document.getElementById('filterStartDate')) document.getElementById('filterStartDate').value = '';
            if (document.getElementById('filterEndDate')) document.getElementById('filterEndDate').value = '';
            filterMeetings();
            if (typeof showToast === 'function') {
                showToast('Filter pencarian telah dikembalikan ke semula.', 'info', 'Filter Direset');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            filterMeetings();
        });

