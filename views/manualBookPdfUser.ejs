                        box-shadow: none !important;
                        background: #ffffff !important;
                    }
                    .kop-surat {
                        display: table !important;
                        width: 100% !important;
                        border-bottom: 2pt solid #0d2b5c !important;
                        padding-bottom: 8pt !important;
                        margin-bottom: 14pt !important;
                    }
                    .kop-logo {
                        display: table-cell !important;
                        width: 55pt !important;
                        vertical-align: middle !important;
                    }
                    .kop-logo img {
                        width: 55pt !important;
                        height: auto !important;
                    }
                    .kop-text {
                        display: table-cell !important;
                        vertical-align: middle !important;
                        text-align: center !important;
                        padding-left: 10pt !important;
                    }
                    .kop-text h2 {
                        font-size: 13pt !important;
                        font-weight: bold !important;
                        color: #0d2b5c !important;
                        margin: 0 0 2pt 0 !important;
                    }
                    .kop-text h3 {
                        font-size: 11pt !important;
                        font-weight: bold !important;
                        color: #1e40af !important;
                        margin: 0 0 2pt 0 !important;
                    }
                    .kop-text p {
                        font-size: 8.5pt !important;
                        color: #64748b !important;
                        margin: 0 !important;
                    }
                    .cover-page {
                        text-align: center !important;
                        border: 1.5pt solid #bfdbfe !important;
                        padding: 24pt 18pt !important;
                        background: #f8fafc !important;
                        margin-bottom: 15pt !important;
                    }
                    .cover-badge {
                        background: #dbeafe !important;
                        color: #1d4ed8 !important;
                        font-size: 9.5pt !important;
                        font-weight: bold !important;
                        padding: 4pt 12pt !important;
                        border: 1pt solid #bfdbfe !important;
                        display: inline-block !important;
                        margin-bottom: 12pt !important;
                    }
                    .cover-title {
                        font-size: 18pt !important;
                        font-weight: bold !important;
                        color: #0d2b5c !important;
                        line-height: 1.3 !important;
                        margin: 0 0 10pt 0 !important;
                    }
                    .cover-divider {
                        height: 2pt !important;
                        background: #2563eb !important;
