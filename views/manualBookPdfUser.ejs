                    }
                    .wf-arrow {
                        display: inline-block !important;
                        color: #94a3b8 !important;
                        font-size: 9pt !important;
                        margin: 0 3pt !important;
                    }
                    .step-list {
                        margin: 8pt 0 !important;
                    }
                    .step-item {
                        display: table !important;
                        width: 100% !important;
                        background: #f8fafc !important;
                        border: 1pt solid #e2e8f0 !important;
                        padding: 6pt 10pt !important;
                        margin-bottom: 6pt !important;
                    }
                    .callout-badge {
                        display: table-cell !important;
                        width: 20pt !important;
                        vertical-align: top !important;
                        font-size: 9pt !important;
                        font-weight: bold !important;
                        color: #2563eb !important;
                    }
                    .step-item-content {
                        display: table-cell !important;
                        vertical-align: top !important;
                        padding-left: 6pt !important;
                    }
                    .step-item-content strong {
                        font-size: 10pt !important;
                        color: #0f172a !important;
                        display: block !important;
                        margin-bottom: 2pt !important;
                    }
                    .step-item-content p {
                        font-size: 9pt !important;
                        color: #475569 !important;
                        margin: 0 !important;
                    }
                    .info-box {
                        background: #f0fdf4 !important;
                        border-left: 3.5pt solid #10b981 !important;
                        padding: 7pt 10pt !important;
                        font-size: 9pt !important;
                        color: #065f46 !important;
                        margin: 8pt 0 !important;
                    }
                    .ss-browser-frame {
                        border: 1pt solid #cbd5e1 !important;
                        margin: 10pt 0 !important;
                        background: #ffffff !important;
                    }
                    .ss-browser-bar {
                        background: #f1f5f9 !important;
                        padding: 4pt 8pt !important;
                        border-bottom: 1pt solid #cbd5e1 !important;
                        font-size: 8pt !important;
                        color: #475569 !important;
                    }
                    .ss-viewport {
                        padding: 10pt !important;
                        background: #ffffff !important;
                    }
                    .doc-footer {
                        display: table !important;
                        width: 100% !important;
                        margin-top: 15pt !important;
                        padding-top: 6pt !important;
                        border-top: 1pt solid #cbd5e1 !important;
                        font-size: 8pt !important;
                        color: #94a3b8 !important;
                        position: static !important;
                    }
                    .doc-footer span:first-child {
                        display: table-cell !important;
                        text-align: left !important;
                    }
                    .doc-footer span:last-child {
                        display: table-cell !important;
                        text-align: right !important;
                    }
                    table {
                        border-collapse: collapse !important;
                        width: 100% !important;
                        margin: 8pt 0 !important;
                    }
                    th, td {
                        border: 1pt solid #cbd5e1 !important;
                        padding: 5pt 7pt !important;
                        font-size: 9pt !important;
                    }
                    th {
                        background: #f1f5f9 !important;
                        font-weight: bold !important;
                    }
                `;

                const mhtml = [
                    'MIME-Version: 1.0',
                    'Content-Type: multipart/related; boundary="' + boundary + '"; type="text/html"',
                    '',
                    '--' + boundary,
                    'Content-Type: text/html; charset="utf-8"',
                    'Content-Transfer-Encoding: 8bit',
                    '',
                    '<!DOCTYPE html>',
                    '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">',
                    '<head>',
                    '<meta http-equiv="Content-Type" content="text/html; charset=utf-8">',
                    '<title>' + docTitle + '</title>',
                    '<!--[if gte mso 9]>',
                    '<xml>',
                    '  <w:WordDocument>',
                    '    <w:View>Print</w:View>',
                    '    <w:Zoom>100</w:Zoom>',
                    '    <w:DoNotOptimizeForBrowser/>',
                    '  </w:WordDocument>',
                    '</xml>',
                    '<![endif]-->',
                    '<style>' + wordStyles + '</style>',
                    '</head>',
                    '<body>',
                    '<div class="Section1">',
                    sheetsHtml,
                    '</div>',
                    '</body>',
                    '</html>',
                    ''
                ];

                if (logoBase64) {
                    mhtml.push('--' + boundary);
                    mhtml.push('Content-Location: logo-bkn-asli.png');
                    mhtml.push('Content-Transfer-Encoding: base64');
                    mhtml.push('Content-Type: image/png');
                    mhtml.push('');
                    mhtml.push(logoBase64);
                    mhtml.push('');
                }

                mhtml.push('--' + boundary + '--');

                const blob = new Blob([mhtml.join('\r\n')], { type: 'application/msword;charset=utf-8' });
                const downloadUrl = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = downloadUrl;
                a.download = filename || 'Panduan-Praktik-Pengguna-BKN.doc';
                document.body.appendChild(a);
                a.click();

                setTimeout(() => {
                    document.body.removeChild(a);
                    URL.revokeObjectURL(downloadUrl);
                }, 150);

                showToast('Dokumen Word (.doc) berhasil diunduh dan siap diedit/dicetak di Microsoft Word!');
            } catch (err) {
                console.error('Gagal mengekspor dokumen Word:', err);
                alert('Terjadi kendala saat mengekspor ke Word. Anda juga dapat menggunakan tombol Cetak PDF (A4).');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalContent;
                }
            }
        }
    </script>
</body>

