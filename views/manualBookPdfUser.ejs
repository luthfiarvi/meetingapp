                        mso-footer-margin: 35.4pt;
                        mso-paper-source: 0;
                    }
                    div.Section1 {
                        page: Section1;
                        font-family: 'Segoe UI', Calibri, -apple-system, BlinkMacSystemFont, Arial, sans-serif;
                        color: #1e293b;
                        font-size: 10pt;
                        line-height: 1.45;
                    }
                    .doc-sheet {
                        width: 100% !important;
                        min-height: auto !important;
                        padding: 0 !important;
